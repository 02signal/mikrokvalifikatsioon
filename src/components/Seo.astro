---
import Analytics from "./Analytics.astro";

// Üks koht kogu <head> SEO/GEO märgenditele, et lehed püsiks järjepidevad.
// Lõpetab <Analytics />-iga (nõusolek + jälgimine + küpsiseriba).
interface Props {
  title: string;
  description: string;
  /** Tee algus- ja lõpukaldkriipsuga, nt "/kataloog/" */
  canonicalPath: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: "website" | "article";
  ogImage?: string;
  /** nt "noindex,follow" utiliidilehtedele; vaikimisi indekseeritav */
  robots?: string;
  /** schema.org JSON-LD graaf (objekt või massiiv) */
  jsonLd?: unknown;
  /** og:locale, vaikimisi et_EE; ingliskeelsel lehel nt "en" */
  locale?: string;
  /** keelevariandid hreflang jaoks, nt [{lang:"et",path:"/"},{lang:"en",path:"/en/"}] */
  langAlternates?: { lang: string; path: string }[];
}

const SITE = "https://mikrokvalifikatsioon.ee";
const {
  title,
  description,
  canonicalPath,
  ogTitle,
  ogDescription,
  ogType = "website",
  ogImage,
  robots,
  jsonLd,
  locale = "et_EE",
  langAlternates
} = Astro.props;
const abs = (p: string) => new URL(p, SITE).href;
const xDefault = langAlternates?.find((a) => a.lang === "et")?.path ?? canonicalPath;

const canonical = new URL(canonicalPath, SITE).href;
// Per-lehe OG: tuletame võtme canonical-tee viimasest segmendist (sama loogika
// kui /og/[route].png.ts pages-võtmed). Leht võib ogImage'i ka käsitsi üle kirjutada.
const ogKey = canonicalPath.replace(/^\/+|\/+$/g, "").split("/").pop() || "home";
const resolvedOgImage = ogImage ?? `/og/${ogKey}.png`;
const image = new URL(resolvedOgImage, SITE).href;
const ogT = ogTitle ?? title;
const ogD = ogDescription ?? description;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
{robots ? <meta name="robots" content={robots} /> : null}
<link rel="canonical" href={canonical} />
{langAlternates ? (
  <>
    {langAlternates.map((a) => <link rel="alternate" hreflang={a.lang} href={abs(a.path)} />)}
    <link rel="alternate" hreflang="x-default" href={abs(xDefault)} />
  </>
) : (
  <>
    <link rel="alternate" hreflang="et" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
  </>
)}

<meta property="og:title" content={ogT} />
<meta property="og:description" content={ogD} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:site_name" content="Mikrokvalifikatsioon.ee" />
<meta property="og:locale" content={locale} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={ogT} />
<meta name="twitter:description" content={ogD} />
<meta name="twitter:image" content={image} />

<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" href="/icon.png" />
<link rel="apple-touch-icon" href="/icon.png" />
<meta name="theme-color" content="#212121" />

<!-- Sora (logoluku sõnamärk + v3 pealkirjad), brändijuhend docs/brand-manual.md -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&display=swap"
/>
<!-- Bing Webmaster Tools verification -->
<meta name="msvalidate.01" content="828D984943C9A54873625C8D93B27CD5" />

<!-- AI-loetavad allikad (GEO) -->
<link rel="alternate" type="text/plain" href="/llms.txt" title="Mikrokvalifikatsioon.ee LLM summary" />
<link rel="alternate" type="text/plain" href="/llms-full.txt" title="Mikrokvalifikatsioon.ee full register export" />
<link rel="alternate" type="application/json" href="/site-profile.json" title="Mikrokvalifikatsioon.ee machine-readable profile" />

{jsonLd ? (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
) : null}

<Analytics />
