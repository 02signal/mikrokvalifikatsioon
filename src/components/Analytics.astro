---
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? "";
// Cookieless self-hosted analytics (Umami CE, stats.amos.02signal.com).
// Runs ALONGSIDE GA4 on purpose: GA4 keeps the history and Google hides
// small numbers, Umami is exact and — being ONE instance for every brand —
// is the only place a cross-brand journey is a single row. Both are fed
// from the same track() call below, so the vocabulary can never drift.
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID ?? "";
const umamiHost = import.meta.env.PUBLIC_UMAMI_HOST ?? "https://stats.amos.02signal.com";
// Stamped onto EVERY event as `brand`. Analysing five sites in one Umami
// instance is only possible if every row says which brand it came from.
const brand = "mikrokvalifikatsioon";
// NB: <link rel="alternate"> GEO-vihjed (llms.txt, site-profile.json) elavad nüüd Seo.astro-s.
---

{gaMeasurementId ? (
  <script is:inline define:vars={{ gaMeasurementId }}>
    // Consent Mode v2, "basic": gtag.js laetakse ALLES pärast nõusolekut.
    // Ilma nõusolekuta ei seata ühtegi analüütikaküpsist ega saadeta pinge.
    (() => {
      const consentKey = "mkval:consent";
      window.dataLayer = window.dataLayer || [];
      function gtag(){window.dataLayer.push(arguments);}
      window.gtag = gtag;
      gtag("consent", "default", {
        analytics_storage: "denied",
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied"
      });

      let gaLoaded = false;
      const loadGa = () => {
        if (gaLoaded) return;
        gaLoaded = true;
        gtag("consent", "update", { analytics_storage: "granted" });
        gtag("js", new Date());
        gtag("config", gaMeasurementId);
        const script = document.createElement("script");
        script.async = true;
        script.src = `https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`;
        document.head.appendChild(script);
      };

      const readChoice = () => {
        try { return localStorage.getItem(consentKey); } catch { return null; }
      };
      const storeChoice = (value) => {
        try { localStorage.setItem(consentKey, value); } catch { /* private mode: banner naaseb järgmisel külastusel */ }
      };

      const banner = () => {
        const el = document.querySelector("[data-cookie-banner]");
        if (!(el instanceof HTMLElement)) return;
        const show = () => { el.hidden = false; };
        const hide = () => { el.hidden = true; };
        el.querySelector("[data-cookie-accept]")?.addEventListener("click", () => { storeChoice("granted"); loadGa(); hide(); });
        el.querySelector("[data-cookie-decline]")?.addEventListener("click", () => { storeChoice("denied"); hide(); });
        document.querySelectorAll("[data-cookie-settings]").forEach((link) => {
          link.addEventListener("click", (event) => { event.preventDefault(); show(); });
        });
        const choice = readChoice();
        if (choice === "granted") loadGa();
        else if (choice !== "denied") show();
      };

      if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", banner);
      else banner();
    })();
  </script>
) : null}

{umamiWebsiteId ? (
  <script
    is:inline
    defer
    src={`${umamiHost}/script.js`}
    data-website-id={umamiWebsiteId}
  ></script>
) : null}

<div class="cookie-banner" data-cookie-banner hidden>
  <div>
    <strong>Küpsised</strong>
    <p>
      Kasutame analüütikaküpsiseid (Google Analytics) ainult sinu nõusolekul, et aru saada,
      mis lehel aitab ja mis mitte. Vajalikud asjad töötavad ilma nõusolekuta.
      <a href="/privaatsus/">Loe lähemalt</a>
    </p>
  </div>
  <div class="cookie-banner-actions">
    <button type="button" class="btn btn-primary" data-cookie-accept>Nõustun analüütikaga</button>
    <button type="button" class="btn btn-secondary" data-cookie-decline>Ainult vajalikud</button>
  </div>
</div>

<style is:global>
  .cookie-banner {
    position: fixed;
    bottom: 16px;
    left: 16px;
    right: 16px;
    z-index: 60;
    max-width: 680px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 14px;
    align-items: center;
    padding: 16px 18px;
    border: 1px solid #d9e3ea;
    border-radius: 12px;
    background: #ffffff;
    box-shadow: 0 18px 46px rgba(33, 33, 33, 0.18);
  }
  .cookie-banner[hidden] { display: none; }
  .cookie-banner p { margin: 4px 0 0; font-size: 0.92rem; color: #44546a; }
  .cookie-banner-actions { display: grid; gap: 8px; }
  .cookie-banner .btn { width: auto; padding: 10px 16px; font-size: 0.92rem; }
  @media (max-width: 640px) {
    .cookie-banner { grid-template-columns: 1fr; }
    .cookie-banner-actions { grid-template-columns: 1fr 1fr; }
  }
</style>

<script is:inline define:vars={{ brand }}>
  (() => {
    const attributionKey = "digiteekaart:attribution";
    const lastCtaKey = "digiteekaart:last_cta";
    const campaignKeys = [
      "utm_source",
      "utm_medium",
      "utm_campaign",
      "utm_term",
      "utm_content",
      "gclid",
      "gbraid",
      "wbraid",
      "msclkid",
      "fbclid",
      "li_fat_id"
    ];

    const safeJsonRead = (key) => {
      try {
        return JSON.parse(sessionStorage.getItem(key) || "{}") || {};
      } catch {
        return {};
      }
    };

    const safeJsonWrite = (key, value) => {
      try {
        sessionStorage.setItem(key, JSON.stringify(value));
      } catch {
        // If storage is unavailable, events still work without attribution context.
      }
    };

    const referrerHost = (referrer) => {
      if (!referrer) return "";
      try {
        return new URL(referrer).hostname;
      } catch {
        return "";
      }
    };

    const captureAttribution = () => {
      const params = new URLSearchParams(window.location.search);
      const current = safeJsonRead(attributionKey);
      const now = new Date().toISOString();

      if (!current.landingPage) {
        current.landingPage = window.location.href;
        current.landingPath = `${window.location.pathname}${window.location.search}`;
        current.firstReferrer = document.referrer || "";
        current.referrerHost = referrerHost(document.referrer);
        current.firstSeenAt = now;
      }

      current.currentPage = window.location.href;
      current.currentPath = `${window.location.pathname}${window.location.search}`;
      current.lastSeenAt = now;

      let hasCampaignValue = false;
      campaignKeys.forEach((key) => {
        const value = params.get(key);
        if (!value) return;
        hasCampaignValue = true;
        current[key] = value;
      });

      if (hasCampaignValue) {
        current.campaignCapturedAt = now;
      }

      safeJsonWrite(attributionKey, current);
      return current;
    };

    const getAttribution = () => captureAttribution();
    const getLastCta = () => safeJsonRead(lastCtaKey);
    const compactAttribution = () => {
      const attribution = getAttribution();
      const lastCta = getLastCta();
      return {
        landing_path: attribution.landingPath || "",
        referrer_host: attribution.referrerHost || "",
        utm_source: attribution.utm_source || "",
        utm_medium: attribution.utm_medium || "",
        utm_campaign: attribution.utm_campaign || "",
        utm_content: attribution.utm_content || "",
        utm_term: attribution.utm_term || "",
        click_id_type: attribution.gclid ? "gclid" : attribution.msclkid ? "msclkid" : attribution.fbclid ? "fbclid" : attribution.li_fat_id ? "li_fat_id" : "",
        last_cta_label: lastCta.cta_label || "",
        last_cta_event: lastCta.event_name || ""
      };
    };

    captureAttribution();

    const track = (eventName, params = {}) => {
      const detail = {
        source_path: window.location.pathname,
        ...compactAttribution(),
        ...params,
        // Last on purpose: a caller must not be able to mislabel the brand.
        // Cross-brand handoffs use `target_brand` in params instead.
        brand
      };
      if (typeof window.gtag === "function") {
        window.gtag("event", eventName, detail);
      }
      // Same name, same properties, second sink. If Umami is not configured
      // for this site the call is simply absent - never a thrown error on a
      // visitor's page.
      if (window.umami && typeof window.umami.track === "function") {
        try {
          window.umami.track(eventName, detail);
        } catch (error) {
          /* analytics must never break the page */
        }
      }
      window.dispatchEvent(new CustomEvent("digiteekaart:event", {
        detail: { eventName, params: detail }
      }));
    };

    window.digiteekaartTrack = track;
    window.digiteekaartGetAttribution = getAttribution;
    window.digiteekaartGetLastCta = getLastCta;

    // Shared across all five 02Signal family sites - keep this map identical
    // in every Analytics.astro so a cross-brand handoff resolves to the same
    // brand name no matter which site logs it. Add a line here (in all five
    // files) when a new family domain ships.
    const BRAND_HOSTS = {
      "digiteekaart.ee": "digiteekaart",
      "automatiseerimine.ee": "automatiseerimine",
      "digitaliseerimine.ee": "digitaliseerimine",
      "teekaart.ee": "teekaart",
      "mikrokvalifikatsioon.ee": "mikrokvalifikatsioon"
    };

    // Derives target_brand from the clicked link's own href, so an author
    // adding a cross-brand link never has to remember to hand-annotate it.
    // `data-target-brand` is an escape hatch for the rare link whose href
    // doesn't tell the truth (e.g. a tracked redirect). A hostname outside
    // the family (including 02signal.ai) resolves to "external" rather than
    // an empty string, so outbound traffic is still visible. A same-brand
    // link (this site's own domain) is not a handoff and resolves to "" -
    // only stamp target_brand when it actually differs from `brand`.
    const resolveTargetBrand = (target) => {
      const explicit = target.getAttribute("data-target-brand");
      if (explicit) return explicit === brand ? "" : explicit;
      if (!(target instanceof HTMLAnchorElement) || !target.href) return "";
      let hostname = "";
      try {
        hostname = new URL(target.href, window.location.href).hostname.toLowerCase();
      } catch {
        return "";
      }
      if (!hostname) return "";
      const bareHost = hostname.replace(/^www\./, "");
      const matchedApex = Object.keys(BRAND_HOSTS).find(
        (apex) => bareHost === apex || bareHost.endsWith(`.${apex}`)
      );
      const resolvedBrand = matchedApex ? BRAND_HOSTS[matchedApex] : "external";
      return resolvedBrand === brand ? "" : resolvedBrand;
    };

    document.addEventListener("click", (event) => {
      const target = event.target instanceof Element
        ? event.target.closest("[data-track-event]")
        : null;
      if (!target) return;
      const eventName = target.getAttribute("data-track-event") || "cta_click";
      // Only a real cross-brand (or fully external) handoff gets stamped -
      // same-brand internal navigation should not claim to be one.
      const targetBrand = resolveTargetBrand(target);
      const cta = {
        event_name: eventName,
        cta_label: target.getAttribute("data-track-label") || target.textContent?.trim() || "",
        cta_href: target instanceof HTMLAnchorElement ? target.href : "",
        cta_path: target instanceof HTMLAnchorElement ? `${target.pathname}${target.search}${target.hash}` : "",
        clicked_at: new Date().toISOString()
      };
      safeJsonWrite(lastCtaKey, cta);
      track(eventName, {
        cta_label: cta.cta_label,
        cta_href: cta.cta_href,
        page_title: document.title,
        ...(targetBrand ? { target_brand: targetBrand } : {})
      });
    });

    const startedForms = new WeakSet();
    const startedTools = new WeakSet();
    document.addEventListener("focusin", (event) => {
      const target = event.target instanceof Element ? event.target : null;
      if (!target) return;

      const toolSection = target.closest("[data-tool-section]");
      if (toolSection && !startedTools.has(toolSection)) {
        startedTools.add(toolSection);
        track("tool_start", {
          tool_name: toolSection.getAttribute("data-tool-section") || "tool",
          source_site: "mikrokvalifikatsioon.ee"
        });
      }

      const form = target.closest("[data-site-lead-form]");
      if (!form || startedForms.has(form)) return;
      // Kui vormil on eraldi kontaktisektsioon, loeb leadi alguseks alles selle puudutamine,
      // mitte toetusfiltri kasutamine.
      const contactSection = form.querySelector("[data-lead-contact-section]");
      if (contactSection && !target.closest("[data-lead-contact-section]")) return;
      startedForms.add(form);
      track("lead_form_start", {
        form_name: "mikrokvalifikatsioon_vorm",
        source_site: form.getAttribute("data-source-site") || "mikrokvalifikatsioon.ee"
      });
    });
  })();
</script>
