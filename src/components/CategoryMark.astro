---
// Lehe päise aktsentmärk. Brändijuhend §2/§5: ÜKS visuaalne keel — valdkonnad ei
// saa eraldi värvi ega märki, sisu eristab. Seepärast renderdab see kõigil
// kategooriatel sama brändi v3 märgi (tõusvad ribad + täpp), oma loomulikus
// proportsioonis (ei venita). Puhtalt dekoratiivne: aria-hidden + tühi alt,
// ei lisa ekraanilugejale müra. `kind` prop on alles, et lehekülgede märgistus
// jääks puutumatuks (väärtus ei muuda enam ilmet).
type Kind =
  | "content"
  | "programme"
  | "topic"
  | "field"
  | "career"
  | "provider"
  | "comparison"
  | "question";

interface Props { kind: Kind }
const { kind } = Astro.props;
// kind säilitatud ühilduvuseks; üks bränd-märk kõigile (sisu eristab, mitte värv).
void kind;
---

<img class="category-mark" src="/logo/mark.svg" width="63" height="44" alt="" aria-hidden="true" loading="lazy" />

<style>
  /* Loomulik kuvasuhe (63×44) säilitatud — brändijuhend §5 "ära venita". */
  .category-mark { display: block; height: 40px; width: auto; margin: 0 0 10px; }
</style>
