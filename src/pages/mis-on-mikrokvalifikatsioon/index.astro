---
import Seo from "../../components/Seo.astro";
import { organization } from "../../data/organizationSchema";
import Footer from "../../components/Footer.astro";
import Figure from "../../components/Figure.astro";
import "../../styles/global.css";
import Nav from "../../components/Nav.astro";
import { catalog, providers } from "../../data/catalog";

const faqItems = [
  {
    question: "Mis on mikrokvalifikatsioon?",
    answer: "Täiskasvanute koolituse seaduse (TäKS) järgi on mikrokvalifikatsioon täienduskoolitusel omandatud teadmiste ja oskuste kogum, mis on tõendatud ja tunnustatud ning vastab tööturu või ühiskonna vajadusele. Mikrokvalifikatsiooniõppe maht on 5–30 ainepunkti (EAP), kus 1 ainepunkt vastab 26 tunnile õppija tööd. Lõpetaja saab tunnistuse, mis kantakse Eesti Hariduse Infosüsteemi (EHIS). Tüüpiline kestus on mõni kuu kuni kaks semestrit töö kõrvalt."
  },
  {
    question: "Mis vahe on mikrokvalifikatsioonil ja mikrokraadil?",
    answer: "Mikrokvalifikatsioon on katusmõiste. Kõrgkool võib oma mikrokvalifikatsiooni nimetada mikrokraadiks, kui vähemalt pool õppekava mahust moodustavad kõrgharidustaseme õppeained. Ka ülikoolidel on mikrokvalifikatsioone, mis pole mikrokraadid."
  },
  {
    question: "Kui palju mikrokraad maksab?",
    answer: "Meie kataloogi andmetel enamasti 700–1 800 € (12–24 EAP). Odavamad algavad umbes 650 eurost, kallimad ulatuvad 2 700 euroni. Osa programme on sihtrühmale rahastatud, näiteks töötavatele õpetajatele EL-i kaasrahastusel."
  },
  {
    question: "Kui kaua õpe kestab?",
    answer: "Tavaliselt üks kuni kaks semestrit töö kõrvalt. Lühemad programmid kestavad paar kuud, pikemad kuni aasta."
  },
  {
    question: "Kas mikrokvalifikatsiooni EAP-sid saab kraadiõppes arvestada?",
    answer: "Saab kasutada VÕTA (varasemate õpingute ja töökogemuse arvestamise) raames tasemeõppes, kuid lõpliku otsuse teeb õppeasutus kaalutlusõigusega. Arvestamist ei saa lubada ette; küsi seda oma õppeasutuselt enne registreerumist."
  },
  {
    question: "Kas mikrokvalifikatsiooni tunnustatakse ka välismaal?",
    answer: "Tunnistust saab kasutada CV-s ja Europassis kogu Euroopas. Ülikooli mikrokraadi EAP-d on ECTS-ainepunktid, mis on Euroopa kõrgkoolides üheselt mõistetavad."
  },
  {
    question: "Kas mikrokraadiks on vaja varasemat kõrgharidust?",
    answer: "Sõltub programmist. Paljud nõuavad kõrgharidust, aga mitte kõik – näiteks programmeerimise või ettevõtluse baasprogrammid on sageli avatud kõigile. Nõue on kirjas iga programmi lehel."
  },
  {
    question: "Kes maksab mikrokvalifikatsiooni eest?",
    answer: "Kolm rada: tööandja koolituseelarve (kui oskus aitab praegust tööd), õppekava enda sihtrühma rahastus (kui kvalifitseerud) või ise makstes. Vaata lehte /kes-maksab/."
  },
  {
    question: "Mis vahe on mikrokvalifikatsioonil ja kutsetunnistusel?",
    answer: "Kutsetunnistus kinnitab olemasolevat oskust eksamiga ega pruugi sisaldada õpet. Mikrokvalifikatsioon sisaldab alati õpet – õpid uue oskuse ja saad selle kohta tunnistuse."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    organization,
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Avaleht", item: "https://mikrokvalifikatsioon.ee/" },
        { "@type": "ListItem", position: 2, name: "Mis on mikrokvalifikatsioon?", item: "https://mikrokvalifikatsioon.ee/mis-on-mikrokvalifikatsioon/" }
      ]
    },
    {
      "@type": "Article",
      image: "https://mikrokvalifikatsioon.ee/diagrams/mikrokraad-vs-mikrokvalifikatsioon.png",
      headline: "Mis on mikrokvalifikatsioon? Lihtne selgitus",
      description: "Mikrokvalifikatsioon, mikrokraad, kutsetunnistus ja sertifikaat – mis vahe neil on ja millal millist valida.",
      inLanguage: "et",
      datePublished: "2026-06-12",
      dateModified: "2026-10-16",
      author: { "@id": "https://mikrokvalifikatsioon.ee/#organization" },
      publisher: { "@id": "https://mikrokvalifikatsioon.ee/#organization" },
      mainEntityOfPage: "https://mikrokvalifikatsioon.ee/mis-on-mikrokvalifikatsioon/"
    },
    {
      "@type": "FAQPage",
      mainEntity: faqItems.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer }
      }))
    }
  ]
};
---

<!doctype html>
<html lang="et">
  <head>
    <Seo
      title="Mis on mikrokvalifikatsioon? Lihtne selgitus ja võrdlus mikrokraadiga"
      description="Mikrokvalifikatsioon on lühike tunnustatud õpe ühe oskuse kohta. Mis vahe on mikrokraadil, kutsetunnistusel ja sertifikaadil – ja millal millist valida."
      canonicalPath="/mis-on-mikrokvalifikatsioon/"
      ogType="article"
      ogTitle="Mis on mikrokvalifikatsioon? Lihtne selgitus"
      ogDescription="Mikrokvalifikatsioon vs mikrokraad vs kutsetunnistus – lihtne võrdlus ja vastused korduvatele küsimustele."
      ogImage="/diagrams/mikrokraad-vs-mikrokvalifikatsioon.og.png"
      jsonLd={schema}
    />
  </head>
  <body>
    <Nav />

    <main class="report-page simple-report">
      <section class="report-hero simple-report-hero">
        <div class="section-inner">
          <span class="eyebrow">Lihtne selgitus</span>
          <h1>Mikrokvalifikatsioon on kitsas, tunnustatud oskus – ilma aastatepikkuse kraadiõppeta.</h1>
          <p>
            Sa ei õpi "kõike natuke", vaid ühte asja korralikult: andmeanalüüsi, personali
            värbamist, hoonete energiatõhusust või muud, mida töö nõuab. Lõpus saad ametliku
            tunnistuse, mida saab näidata tööandjale Eestis ja Euroopas.
          </p>
          <div class="actions">
            <a class="btn btn-primary" href="/#suunatest" data-track-event="cta_click" data-track-label="mison_hero_suunatest">Leia endale sobiv</a>
            <a class="btn btn-secondary" href="/kataloog/" data-track-event="cta_click" data-track-label="mison_hero_kataloog">Vaata kõiki ({catalog.length})</a>
          </div>
        </div>
      </section>

      <section class="white">
        <div class="section-inner">
          <div class="section-head compact-head">
            <span class="kicker">Neli mõistet, üks loogika</span>
            <h2>Mikrokvalifikatsioon, mikrokraad, kutsetunnistus, sertifikaat – mis vahe on?</h2>
          </div>
          <Figure id="mikrokraad-vs-mikrokvalifikatsioon" />
          <div class="measure-list">
            <article class="measure-card">
              <div>
                <span class="status-tag status-green">Katusmõiste</span>
                <h3>Mikrokvalifikatsioon</h3>
                <p>Lühike tunnustatud õpe ühe konkreetse oskuse kohta. Pakkuja võib olla ülikool, rakenduskõrgkool, kutseõppeasutus või täienduskoolitusasutus. Sisaldab alati õpet ja lõpeb tunnistusega.</p>
              </div>
            </article>
            <article class="measure-card">
              <div>
                <span class="status-tag status-blue">Ülikooli versioon</span>
                <h3>Mikrokraad</h3>
                <p>Kõrgkooli mikrokvalifikatsioon, mille õppekavast vähemalt pool moodustavad kõrgharidustaseme õppeained. EAP-sid (ainepunkte) võib kraadiõppes arvestada VÕTA kaudu – otsustab õppeasutus. Eestis on neid juba sadu – vaata <a href="/mikrokraadid/">mikrokraadide ülevaadet</a>.</p>
              </div>
            </article>
            <article class="measure-card">
              <div>
                <span class="status-tag status-amber">Eksam, mitte õpe</span>
                <h3>Kutsetunnistus</h3>
                <p>Kinnitab olemasolevat oskust eksamiga – õpet ei pruugi sisaldada. Sobib siis, kui oskus on juba käes ja vaja on ametlikku kinnitust.</p>
              </div>
            </article>
            <article class="measure-card">
              <div>
                <span class="status-tag status-amber">Kõige kergem kaal</span>
                <h3>Kursuse sertifikaat</h3>
                <p>Lühikursuse või veebikursuse läbimise tõend. Kasulik, aga ilma ühtse kvaliteedikontrollita – tööandja jaoks nõrgem signaal kui mikrokvalifikatsioon.</p>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section class="ice" id="seaduses">
        <div class="section-inner narrow">
          <div class="section-head compact-head">
            <span class="kicker">Seaduses</span>
            <h2>Mida täiskasvanute koolituse seadus ütleb.</h2>
          </div>
          <ul class="law-list">
            <li><strong>Mõiste.</strong> Mikrokvalifikatsioon on täienduskoolitusel omandatud teadmiste ja oskuste kogum, mis on tõendatud ja tunnustatud ning vastab tööturu või ühiskonna vajadusele.</li>
            <li><strong>Maht.</strong> 5–30 ainepunkti (EAP, kutseõppes EKAP); 1 ainepunkt vastab 26 tunnile õppija tööd. Me ei teisenda mahtu akadeemilisteks tundideks ega arvuta seda tundidest ümber: kui kool pole EAP-mahtu avaldanud, jääb see kinnitamata.</li>
            <li><strong>Tunnistus.</strong> Lõpetaja saab mikrokvalifikatsioonitunnistuse, mis kantakse Eesti Hariduse Infosüsteemi (EHIS).</li>
            <li><strong>Pakkujad.</strong> Mikrokvalifikatsiooniõpet võivad pakkuda nii ülikoolid ja kutseõppeasutused (oma õppekavagrupis õppeõiguse alusel) kui täienduskoolitusasutused (tegevusloa ja kvaliteedihindamise alusel). Õpe toimub EHIS-i kantud õppekava alusel.</li>
            <li><strong>Mikrokraad.</strong> Kõrgkool võib oma mikrokvalifikatsiooni nimetada mikrokraadiks, kui vähemalt pool õppekava mahust moodustavad kõrgharidustaseme õppeained.</li>
            <li><strong>VÕTA.</strong> Mikrokvalifikatsiooni ainepunkte saab kasutada VÕTA raames tasemeõppes; lõpliku arvestuse otsustab õppeasutus.</li>
            <li><strong>Jõustumine.</strong> Sätted jõustusid 1. aprillil 2025; kõik pakkujad pidid nõuetele vastama 1. septembriks 2025.</li>
          </ul>
          <p class="law-source">Allikad: <a href="https://www.riigiteataja.ee/akt/130012025002" rel="noopener" target="_blank">Täiskasvanute koolituse seadus (Riigi Teataja)</a> ja <a href="https://hm.ee/mikrokvalifikatsioonid" rel="noopener" target="_blank">Haridus- ja Teadusministeeriumi ülevaade</a>. Õiguslikult siduv on Riigi Teataja tekst.</p>
        </div>
      </section>

      <section class="white">
        <div class="section-inner">
          <div class="section-head compact-head">
            <span class="kicker">Numbrites</span>
            <h2>Mida Eesti turg praegu pakub.</h2>
          </div>
          <div class="grid-3">
            <article class="card">
              <span class="stat">{catalog.length}</span>
              <h3>programmi</h3>
              <p>meie kataloogis {providers.length} koolist – IT-st ja juhtimisest ehituse ja terviseni.</p>
            </article>
            <article class="card">
              <span class="stat">700–1 800 €</span>
              <h3>tüüpiline hind</h3>
              <p>12–24 EAP mahus programm. Osa on sihtrühmale rahastatud. Sageli maksab tööandja.</p>
            </article>
            <article class="card">
              <span class="stat">1–2 semestrit</span>
              <h3>tüüpiline kestus</h3>
              <p>töö kõrvalt, sageli veebis või hübriidõppes. Kuud, mitte aastad.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="white">
        <div class="section-inner narrow">
          <div class="section-head compact-head">
            <span class="kicker">Korduvad küsimused</span>
            <h2>Lühikesed vastused.</h2>
          </div>
          {faqItems.map((item, index) => (
            <details class="faq-item" open={index < 3}>
              <summary><strong>{item.question}</strong></summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="navy">
        <div class="section-inner contact">
          <div>
            <span class="kicker">Järgmine samm</span>
            <h2>Kahe minutiga selgeks, milline programm sinu olukorraga sobib.</h2>
            <div class="inline-actions">
              <a class="btn btn-primary" href="/#suunatest" data-track-event="cta_click" data-track-label="mison_bottom_suunatest">Tee suunatest</a>
              <a class="btn btn-secondary" href="/kes-maksab/" data-track-event="cta_click" data-track-label="mison_bottom_kesmaksab">Kes maksab?</a>
            </div>
          </div>
          <aside class="contact-card">
            <h3>Kontakt</h3>
            <p>Ettevõtluskeskus OÜ</p>
            <p><a href="mailto:info@mikrokvalifikatsioon.ee" data-track-event="email_click" data-track-label="mison_email">info@mikrokvalifikatsioon.ee</a></p>
            <p><a href="tel:+37258180435" data-track-event="phone_click" data-track-label="mison_phone">+372 5818 0435</a></p>
          </aside>
        </div>
      </section>
    </main>

    <Footer label="Mis on mikrokvalifikatsioon?" />

    <style>
      .faq-item {
        border: 1px solid #dbe4ee;
        border-radius: 12px;
        padding: 14px 18px;
        margin-bottom: 10px;
        background: #fff;
      }
      .faq-item summary {
        cursor: pointer;
        font-size: 1.02rem;
      }
      .faq-item p {
        margin: 10px 0 4px;
        color: #44546a;
      }
      .law-list { display: grid; gap: 10px; padding-left: 18px; }
  .law-source { margin-top: 14px; color: var(--muted); font-size: 0.9rem; }
  .law-source a { color: var(--teal); }
</style>
  </body>
</html>
