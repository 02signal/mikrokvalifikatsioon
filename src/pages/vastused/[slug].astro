---
import Seo from "../../components/Seo.astro";
import CategoryMark from "../../components/CategoryMark.astro";
import Footer from "../../components/Footer.astro";
import Figure from "../../components/Figure.astro";
import "../../styles/global.css";
import Nav from "../../components/Nav.astro";
import { questions, questionBySlug } from "../../data/questions";
import { catalogUpdatedAt } from "../../data/catalog";
import {
  eapRows,
  eapProgrammeGroups,
  eapDistributionNow,
  eapDataDateText,
  HOURS_PER_EAP,
  WEEKS_PER_SEMESTER
} from "../../data/eapTable";

const SITE = "https://mikrokvalifikatsioon.ee";

export function getStaticPaths() {
  return questions.map((q) => ({ params: { slug: q.slug } }));
}

const { slug } = Astro.params;
const q = questionBySlug.get(slug as string);
if (!q) {
  return Astro.redirect("/vastused/", 404);
}

const path = `/vastused/${q.slug}/`;
const updatedAtText = catalogUpdatedAt.split("-").reverse().join(".");
// Joonise id failinimest tuletatud (q.figure.src = "/diagrams/<id>.svg") — nii
// saab <Figure id={...}> otsida sama kirje registrist (alt/caption).
const figureId = q.figure?.src.replace(/^\/diagrams\//, "").replace(/\.svg$/, "");

// Lühivastus on 1–3 lauset; lõpeta kindlalt punktiga JSON-LD jaoks.
const acceptedAnswerText = q.shortAnswer;

// JSON-LD: FAQPage (TOIMETUSE küsimus+vastus — sait ise annab autoriteetse vastuse;
// QAPage on Google'i KOGUKONNA-tüüp, kus kasutajad ise vastused esitavad, ja selle
// rakendamine toimetuse sisule annab Search Console'i "Q&A invalid acceptedAnswer"
// hoiatuse. FAQPage on õige tüüp ja ühtib saidi teiste KKK-lehtedega.) + WebPage + BreadcrumbList.
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${SITE}/#organization`,
      name: "Mikrokvalifikatsioon.ee",
      legalName: "Ettevõtluskeskus OÜ",
      url: `${SITE}/`
    },
    {
      "@type": "WebPage",
      "@id": `${SITE}${path}#webpage`,
      url: `${SITE}${path}`,
      name: q.question,
      description: acceptedAnswerText,
      inLanguage: "et",
      isPartOf: { "@id": `${SITE}/#organization` },
      dateModified: catalogUpdatedAt,
      mainEntityOfPage: `${SITE}${path}`,
      ...(q.figure ? { primaryImageOfPage: { "@id": `${SITE}${path}#figure` } } : {})
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Avaleht", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Vastused", item: `${SITE}/vastused/` },
        { "@type": "ListItem", position: 3, name: q.question, item: `${SITE}${path}` }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": `${SITE}${path}#faq`,
      inLanguage: "et",
      isPartOf: { "@id": `${SITE}/#organization` },
      mainEntity: [
        {
          "@type": "Question",
          name: q.question,
          acceptedAnswer: {
            "@type": "Answer",
            text: acceptedAnswerText
          }
        }
      ]
    },
    // Selgitav joonis ImageObject-ina — annab Google Images / GEO jaoks masinloetava
    // pildikonteksti (pealkiri, kirjeldus, litsents, seos lehega).
    ...(q.figure ? [{
      "@type": "ImageObject",
      "@id": `${SITE}${path}#figure`,
      // Raster (PNG) on kanooniline indekseeritav pilt Google Images'i jaoks.
      url: `${SITE}${q.figure.src.replace(/\.svg$/, ".png")}`,
      contentUrl: `${SITE}${q.figure.src.replace(/\.svg$/, ".png")}`,
      caption: q.figure.caption,
      description: q.figure.alt,
      width: q.figure.width * 2,
      height: q.figure.height * 2,
      encodingFormat: "image/png",
      inLanguage: "et",
      isPartOf: { "@id": `${SITE}${path}#webpage` },
      creator: { "@id": `${SITE}/#organization` },
      creditText: "Mikrokvalifikatsioon.ee",
      copyrightNotice: "© Ettevõtluskeskus OÜ",
      acquireLicensePage: `${SITE}/andmed/`,
      license: "https://creativecommons.org/licenses/by/4.0/"
    }] : [])
  ]
};

// Lehekülgede vaheline navigatsioon (eelmine/järgmine küsimus).
const idx = questions.findIndex((x) => x.slug === q.slug);
const prev = idx > 0 ? questions[idx - 1] : null;
const next = idx < questions.length - 1 ? questions[idx + 1] : null;

// SEO meta: pealkiri = küsimus + bränd; kirjeldus = lühivastus (lõika ~155 märgini).
const metaDescription =
  q.metaDescription ??
  (acceptedAnswerText.length > 155 ? `${acceptedAnswerText.slice(0, 152).trimEnd()}…` : acceptedAnswerText);
const fmtHours = (n: number) => String(n).replace(".", ",");
const showEapTable = q.slug === "mis-on-eap";
const showEapDistribution = q.slug === "mitu-eap-d-on-mikrokraadil";
---

<!doctype html>
<html lang="et">
  <head>
    <Seo
      title={q.seoTitle ?? `${q.question} | Mikrokvalifikatsioon.ee`}
      description={metaDescription}
      canonicalPath={path}
      ogType="article"
      ogTitle={q.question}
      ogDescription={metaDescription}
      ogImage={q.figure ? q.figure.src.replace(/\.svg$/, ".og.png") : undefined}
      jsonLd={schema}
    />
  </head>
  <body>
    <Nav />

    <main class="report-page simple-report">
      <section class="report-hero simple-report-hero">
        <div class="section-inner narrow">
          <p class="vastused-crumb">
            <a href="/vastused/">Vastused</a> ›
          </p>
          <CategoryMark kind="question" />
          <h1>{q.question}</h1>
          <!-- Väljavõetav lühivastus ENNE muud teksti — AI-mootorid ja Google AI Overviews saavad seda tsiteerida -->
          <p class="vastused-short"><strong>{q.shortAnswer}</strong></p>
        </div>
      </section>

      <section class="white">
        <div class="section-inner narrow">
          {q.figure && figureId && <Figure id={figureId} alt={q.figure.alt} caption={q.figure.caption} />}
          {q.body.map((para) => (
            <p class="vastused-body">{para}</p>
          ))}
          {showEapTable && (
            <>
              <h2 class="eap-h2">EAP tundides: kogu töömaht keskmiselt</h2>
              <div class="eap-table-wrap">
                <table class="eap-table">
                  <caption>
                    Arvutus: 1 EAP = {HOURS_PER_EAP} tundi õppija tööd. Nädalakoormus on keskmine ja põhineb
                    eeldusel, et üks semester on umbes {WEEKS_PER_SEMESTER} õppenädalat; tegelik koormus
                    sõltub programmist ja sinu tempost.
                  </caption>
                  <thead>
                    <tr>
                      <th scope="col">Maht</th>
                      <th scope="col">Kogu töömaht</th>
                      <th scope="col">Eeldatav kestus</th>
                      <th scope="col">Keskmiselt nädalas</th>
                    </tr>
                  </thead>
                  <tbody>
                    {eapRows.map((r) => (
                      <tr>
                        <th scope="row">{r.eap} EAP</th>
                        <td>{r.hours} tundi</td>
                        <td>{r.semesters === 1 ? "1 semester" : `${r.semesters} semestrit`} (~{r.weeks} nädalat)</td>
                        <td>umbes {fmtHours(r.hoursPerWeek)} tundi</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              {eapProgrammeGroups.length > 0 && (
                <>
                  <h3 class="eap-h3">Näited kataloogist mahu järgi</h3>
                  <ul class="eap-programmes">
                    {eapProgrammeGroups.map((g) => (
                      <li>
                        <strong>Umbes {g.eap} EAP ({g.lo}–{g.hi} EAP):</strong>
                        <ul>
                          {g.programmes.map((p) => (
                            <li>
                              <a
                                href={`/kataloog/${p.slug}/`}
                                data-track-event="cta_click"
                                data-track-label={`eap_table_${p.slug}`}
                              >{p.name}</a>
                              — {p.provider}, {p.ects} EAP
                            </li>
                          ))}
                        </ul>
                      </li>
                    ))}
                  </ul>
                  <p class="vastused-body">
                    Näited on võetud praegusest kataloogist ({eapDataDateText}), mitte valitud kvaliteedi järgi.
                    Kõik programmid: <a href="/kataloog/" data-track-event="cta_click" data-track-label="eap_table_kataloog">kataloog</a>.
                  </p>
                </>
              )}
            </>
          )}
          {showEapDistribution && (
            <>
              <h2 class="eap-h2">Mitu programmi on igas mahuvahemikus</h2>
              <div class="eap-table-wrap">
                <table class="eap-table">
                  <caption>
                    Kataloogi {eapDistributionNow.total} programmi, mille EAP-maht on teada; andmed seisuga {eapDataDateText}.
                    1 EAP = {HOURS_PER_EAP} tundi õppija tööd.
                  </caption>
                  <thead>
                    <tr>
                      <th scope="col">Maht</th>
                      <th scope="col">Programme</th>
                    </tr>
                  </thead>
                  <tbody>
                    {eapDistributionNow.buckets.map((b) => (
                      <tr>
                        <th scope="row">{b.label}</th>
                        <td>{b.count}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <p class="vastused-body">
                Vaata programme mahu järgi: <a href="/mikrokraadid/" data-track-event="cta_click" data-track-label="eap_distribution_mikrokraadid">kõik mikrokraadid</a>
                või <a href="/kataloog/" data-track-event="cta_click" data-track-label="eap_distribution_kataloog">filtreeritav kataloog</a>.
              </p>
            </>
          )}
          <p class="report-date">
            Andmed pärinevad koolide avalikelt lehtedelt ja Eesti Hariduse Infosüsteemist (EHIS);
            arvud on arvutatud registri andmetest, uuendatud {updatedAtText}. Lõplik ja siduv info on
            alati kooli enda lehel. Metoodika: <a href="/andmed/">Andmed</a>.
          </p>
        </div>
      </section>

      <section class="ice">
        <div class="section-inner narrow">
          <div class="section-head compact-head">
            <span class="kicker">Seotud</span>
            <h2>Vaata edasi.</h2>
          </div>
          <ul class="check">
            {q.relatedLinks.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
          {(prev || next) && (
            <p class="vastused-nav">
              {prev && <a href={`/vastused/${prev.slug}/`}>‹ {prev.question}</a>}
              {prev && next && <span class="vastused-nav-sep"> · </span>}
              {next && <a href={`/vastused/${next.slug}/`}>{next.question} ›</a>}
            </p>
          )}
        </div>
      </section>

      <section class="navy">
        <div class="section-inner contact">
          <div>
            <span class="kicker">Järgmine samm</span>
            <h2>Leia endale sobiv programm või vaata kõiki vastuseid.</h2>
            <div class="inline-actions">
              <a class="btn btn-primary" href="/kataloog/" data-track-event="cta_click" data-track-label="vastused_slug_kataloog">Ava kataloog</a>
              <a class="btn btn-secondary" href="/vastused/" data-track-event="cta_click" data-track-label="vastused_slug_hub">Kõik vastused</a>
            </div>
          </div>
          <aside class="contact-card">
            <h3>Kontakt</h3>
            <p>Ettevõtluskeskus OÜ</p>
            <p><a href="mailto:info@mikrokvalifikatsioon.ee" data-track-event="email_click" data-track-label="vastused_slug_email">info@mikrokvalifikatsioon.ee</a></p>
            <p><a href="tel:+37258180435" data-track-event="phone_click" data-track-label="vastused_slug_phone">+372 5818 0435</a></p>
          </aside>
        </div>
      </section>
    </main>

    <Footer label={q.question} />

    <style>
      .vastused-crumb {
        margin: 0 0 8px;
        font-size: 0.9rem;
        /* Tumeda kangelastausta peal — hele eraldaja (›); link jääb teal-iks. */
        color: rgba(255, 255, 255, 0.7);
      }
      .vastused-crumb a { color: var(--teal); font-weight: 700; }
      .vastused-short {
        font-size: 1.18rem;
        line-height: 1.55;
        /* Lühivastus istub TUMEDA kangelastausta (.report-hero) peal — hele tekst loetavuse jaoks. */
        color: var(--white);
        margin-top: 14px;
      }
      .vastused-body {
        color: var(--muted);
        line-height: 1.65;
        margin-bottom: 14px;
      }
      .eap-h2 { margin: 28px 0 12px; }
      .eap-h3 { margin: 22px 0 8px; }
      .eap-table-wrap { overflow-x: auto; }
      .eap-table {
        width: 100%;
        border-collapse: collapse;
        background: #fff;
        border: 1px solid var(--line);
      }
      .eap-table th, .eap-table td {
        border: 1px solid var(--line);
        padding: 10px 12px;
        text-align: left;
        font-size: 0.95rem;
      }
      .eap-table thead th { background: var(--navy); color: #fff; }
      .eap-table tbody th { background: var(--ice); color: var(--ink); font-weight: 800; }
      .eap-table caption {
        caption-side: bottom;
        text-align: left;
        color: var(--muted);
        font-size: 0.85rem;
        padding-top: 10px;
      }
      .eap-programmes { padding-left: 18px; color: var(--muted); line-height: 1.6; }
      .eap-programmes ul { margin: 4px 0 10px; padding-left: 18px; }
      .eap-programmes a { color: var(--teal); font-weight: 700; }
      .vastused-nav {
        margin-top: 18px;
        font-size: 0.95rem;
      }
      .vastused-nav a { color: var(--teal); font-weight: 700; }
      .vastused-nav-sep { color: var(--muted); }
    </style>
  </body>
</html>
