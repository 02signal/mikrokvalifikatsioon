---
import Seo from "../../components/Seo.astro";
import { organization } from "../../data/organizationSchema";
import Footer from "../../components/Footer.astro";
import Figure from "../../components/Figure.astro";
import "../../styles/global.css";
import Nav from "../../components/Nav.astro";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    organization,
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Avaleht", item: "https://mikrokvalifikatsioon.ee/" },
        { "@type": "ListItem", position: 2, name: "Kes maksab?", item: "https://mikrokvalifikatsioon.ee/kes-maksab/" }
      ]
    },
    {
      "@type": "Article",
      image: "https://mikrokvalifikatsioon.ee/og/kes-maksab.png",
      headline: "Kes maksab mikrokvalifikatsiooni eest? Tööandja, õppekava rahastus või ise",
      description: "Kolm rada mikrokvalifikatsiooni või mikrokraadi õppetasuks: tööandja koolituseelarve, õppekava enda sihtrühma rahastus ja ise makstes. Kuidas igaüht küsida.",
      inLanguage: "et",
      datePublished: "2026-06-12",
      dateModified: "2026-08-04",
      author: { "@id": "https://mikrokvalifikatsioon.ee/#organization" },
      publisher: { "@id": "https://mikrokvalifikatsioon.ee/#organization" },
      mainEntityOfPage: "https://mikrokvalifikatsioon.ee/kes-maksab/"
    }
  ]
};
---

<!doctype html>
<html lang="et">
  <head>
    <Seo
      title="Kes maksab mikrokvalifikatsiooni eest? | Tööandja, õppekava rahastus või ise"
      description="Sageli ei pea sa kogu õpet ise kinni maksma. Kolm rada: tööandja koolituseelarve, õppekava enda sihtrühma rahastus, ise makstes — ja kuidas igaüht praktiliselt küsida."
      canonicalPath="/kes-maksab/"
      ogType="article"
      ogTitle="Kes maksab mikrokvalifikatsiooni eest?"
      ogDescription="Tööandja, õppekava enda rahastus või sina ise — kolm rada õppetasule ja kuidas igaüht küsida."
      jsonLd={schema}
    />
  </head>
  <body>
    <Nav />

    <main class="report-page simple-report">
      <section class="report-hero simple-report-hero">
        <div class="section-inner">
          <span class="eyebrow">Raha küsimus</span>
          <h1>Kes maksab mikrokvalifikatsiooni eest?</h1>
          <p>
            Tüüpiline mikrokraad maksab 700–1 800 €. See on vähem kui üks kuupalk
            — aga sageli ei pea sa sedagi täies mahus ise maksma. Kolm rada, kõige
            kiiremast alustades.
          </p>
          <div class="actions">
            <a class="btn btn-primary" href="/#suunatest" data-track-event="cta_click" data-track-label="kesmaksab_hero_suunatest">Leia oma programm ja rahastus</a>
          </div>
        </div>
      </section>

      <section class="white">
        <div class="section-inner narrow">
          <Figure id="rahastus-kolm-rada" priority />
        </div>
        <div class="section-inner">
          <div class="measure-list">
            <article class="measure-card">
              <div>
                <span class="status-tag status-green">Rada 1 — kõige kiirem</span>
                <h3>Tööandja koolituseelarve</h3>
                <p>
                  Kui uus oskus aitab praegust tööd paremini teha, on tööandjal otsene huvi
                  see kinni maksta. Enamikus ettevõtetes on koolitusraha olemas — seda lihtsalt
                  ei küsita.
                </p>
                <p>
                  <strong>Kuidas küsida:</strong> näita tasuvust, mitte soovi. "See programm
                  maksab 1 200 € ja kestab ühe semestri töö kõrvalt. Pärast seda saan X töö
                  ise ära teha, mille eest praegu maksame teenusepakkujale." Konkreetne programm
                  kataloogist + hind + mida ettevõte võidab = jah-sõna tõenäosus kasvab kordades.
                </p>
              </div>
            </article>
            <article class="measure-card">
              <div>
                <span class="status-tag status-blue">Rada 2 — kontrolli enne maksmist</span>
                <h3>Õppekava enda rahastus või soodustus</h3>
                <p>
                  Osa õppekavadest on mõnele sihtrühmale juba osaliselt või täielikult kaetud —
                  näiteks Euroopa Liidu kaasrahastusega või kooli enda programmiga. Kes sihtrühma
                  kuulub ja kui suure osa see katab, on igal õppekaval erinev ja muutub aastati.
                  Kataloogis on teadaolev rahastusinfo iga programmi juures kirjas.
                </p>
                <p>
                  <strong>Kuidas küsida:</strong> võta kataloogist konkreetse programmi nimi ja
                  kirjuta koolile: "Kas sellel õppekaval on sihtrühmale suunatud rahastust,
                  soodustust või osadena maksmise võimalust ja kas mina kvalifitseerun?" Kool
                  teab oma õppekava rahastust kõige täpsemini.
                </p>
              </div>
            </article>
            <article class="measure-card">
              <div>
                <span class="status-tag status-amber">Rada 3 — ise makstes</span>
                <h3>Oma raha — koos tasuvusarvutusega</h3>
                <p>
                  Kui maksad ise, tee enne lihtne arvutus: programmi hind ÷ oodatav palgakasv
                  kuus = tasuvusaeg kuudes. Näide: 1 200 € programm, mis aitab liikuda rolli,
                  kus palk on 200 € kuus kõrgem, teenib end tagasi poole aastaga. Kui tasuvusaega
                  ei oska hinnata, on see märk, et programm vajab veel kaalumist.
                </p>
                <p>
                  <strong>Hea teada:</strong> enne kui maksad, käi läbi rada 1 ja rada 2 — sageli
                  kaetakse osa summast mujalt ja ise jääb maksta väiksem osa.
                </p>
              </div>
            </article>
          </div>

          <div class="measure-list">
            <article class="measure-card">
              <div>
                <span class="status-tag status-blue">Kui oled praegu tööta või töökoht on ohus</span>
                <h3>Uuri, mida sinu olukorras üldse toetatakse</h3>
                <p>
                  Eestis on täiskasvanuõppe ja tööturu tugimeetmeid. Iga meetme tingimused,
                  sihtrühm ja see, milliseid õppevorme need üldse katavad, on erinevad ja
                  muutuvad. <strong>Meie ei vahenda ühtegi toetust, ei esinda ühtegi rahastajat
                  ega väida, et mõni avalik meede katab selles kataloogis olevaid programme.</strong>
                  Selle saab teada ainult meetme enda korraldajalt.
                </p>
                <p>
                  <strong>Praktiline soovitus:</strong> võta kataloogist konkreetse programmi nimi,
                  maht ja hind ning küsi nende andmetega. Konkreetse plaaniga inimene saab alati
                  kiirema ja täpsema vastuse kui üldise küsimusega. Küsi paralleelselt ka koolilt
                  (rada 2) — kool teab oma õppekava kohta rohkem kui keegi teine.
                </p>
              </div>
            </article>
          </div>

          <p class="notice">
            Me ei luba ühtegi toetust ette. Rahastuse tingimused muutuvad ja lõpliku otsuse teeb
            alati tööandja, kool või konkreetse meetme korraldaja. See leht aitab sul õigesti küsida.
          </p>
        </div>
      </section>

      <section class="navy">
        <div class="section-inner contact">
          <div>
            <span class="kicker">Järgmine samm</span>
            <h2>Tee 2 minuti suunatest — saad kohe sobivad programmid ja rahastuse vihje.</h2>
            <div class="inline-actions">
              <a class="btn btn-primary" href="/#suunatest" data-track-event="cta_click" data-track-label="kesmaksab_bottom_suunatest">Tee suunatest</a>
              <a class="btn btn-secondary" href="/kataloog/" data-track-event="cta_click" data-track-label="kesmaksab_bottom_kataloog">Ava kataloog</a>
            </div>
          </div>
          <aside class="contact-card">
            <h3>Kontakt</h3>
            <p>Ettevõtluskeskus OÜ</p>
            <p><a href="mailto:info@mikrokvalifikatsioon.ee" data-track-event="email_click" data-track-label="kesmaksab_email">info@mikrokvalifikatsioon.ee</a></p>
            <p><a href="tel:+37258180435" data-track-event="phone_click" data-track-label="kesmaksab_phone">+372 5818 0435</a></p>
          </aside>
        </div>
      </section>
    </main>

    <Footer label="Rahastuse teejuht" />
  </body>
</html>
