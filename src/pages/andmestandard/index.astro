---
import Seo from "../../components/Seo.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/global.css";
import Nav from "../../components/Nav.astro";
import { credentialCommonsRelease } from "../../data/credentialCommons";

const SITE = "https://mikrokvalifikatsioon.ee";
const path = "/andmestandard/";
const ccCount = credentialCommonsRelease.nodesById.size;

const faqItems = [
  {
    question: "Mis vahe on Credential Commonsil ja EHIS-el?",
    answer: "EHIS on Eesti riiklik register, kus konkreetne õppekava ja tunnistus ametlikult registreeritakse — see on siduv, ametlik allikas. Credential Commons on avatud, masinloetav andmestandard (Linked Data formaat), mis kirjeldab sama õppekava infot nii, et teised süsteemid, koolid ja AI-tööriistad saavad seda otse ja koostöövõimeliselt lugeda. Standard ei asenda EHIS-t ega HAKA hindamist — see on lisakiht, mis teeb sama sisu masinloetavaks."
  },
  {
    question: "Kuidas viia oma õppekava andmed sellesse standardisse?",
    answer: "Pane kirja põhi (nimi, õpiväljundid, maht, tase, hindamiskriteeriumid), seejärel vii see cc:MicroCredential profiili vormi — kas lase AI-abilisel see oma Wordi- või Exceli-failist kokku panna, valideeri avatud tööriistaga (vt allpool) või küsi meilt abi."
  },
  {
    question: "Kas kataloog on avaandmetena kasutatav?",
    answer: "Jah. Vastavuskontrolli läbinud kirjed on avaldatud CC BY 4.0 litsentsiga JSON-LD failina (/catalog.cc.jsonld) ja iga programmi kohta eraldi (/kataloog/<slug>/credential.jsonld). Andmeid tohib vabalt kasutada, taaskasutada ja edasi arendada litsentsi tingimustel."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Avaleht", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Andmestandard", item: `${SITE}${path}` }
      ]
    },
    {
      "@type": "Dataset",
      name: "Mikrokvalifikatsioon.ee — Credential Commons avaandmed",
      description: "Eesti mikrokvalifikatsioonide kataloog masinloetava Linked Data'na, Credential Commons cc:MicroCredential profiili järgi.",
      url: `${SITE}${path}`,
      inLanguage: "et",
      license: "https://creativecommons.org/licenses/by/4.0/",
      isAccessibleForFree: true,
      distribution: [
        { "@type": "DataDownload", name: "Kogu kataloog (JSON-LD)", encodingFormat: "application/ld+json", contentUrl: `${SITE}/catalog.cc.jsonld` }
      ]
    },
    {
      "@type": "FAQPage",
      mainEntity: faqItems.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer }
      }))
    }
  ]
};
---

<!doctype html>
<html lang="et">
  <head>
    <Seo
      title="Avatud andmestandard — Credential Commons | Mikrokvalifikatsioon.ee"
      description="Vastavuskontrolli läbinud kataloogikirjed on avaldatud avatud, masinloetava standardi järgi (Credential Commons)."
      canonicalPath={path}
      ogType="website"
      ogTitle="Avatud andmestandard — Credential Commons"
      ogDescription="Vastavuskontrolli läbinud kataloogikirjed masinloetava Linked Data'na, avatud standardi järgi."
      jsonLd={schema}
    />
  </head>
  <body>
    <Nav />

    <main class="report-page simple-report">
      <section class="report-hero simple-report-hero">
        <div class="section-inner narrow">
          <span class="eyebrow">Koolitajale, õppijale, arendajale ja AI-le</span>
          <h1>Meie andmed on avatud standardi järgi.</h1>
          <p>
            Kogu kataloog on avaldatud <strong>masinloetava Linked Data'na</strong> avatud
            standardi <a href="https://credentialcommons.org" rel="noopener">Credential&nbsp;Commons</a>
            järgi. Vastavuskontrolli läbinud kirjed on <code>cc:MicroCredential</code> — nii saavad teised
            asutused, AI-teenused ja andmetööriistad andmed <strong>otse ja koostöövõimeliselt</strong>
            kasutada, ilma iga saiti eraldi kraapimata.
          </p>
        </div>
      </section>

      <section class="white">
        <div class="section-inner narrow">
          <div class="section-head compact-head">
            <span class="kicker">Kellele ja miks</span>
            <h2>Miks avatud standard sulle kasu toob.</h2>
          </div>
          <p>
            Sina kirjeldad õppekava <em>korra</em> — edasi loeb sama kirjet
            <strong>järgmine kool ja tööandja</strong> (võivad seda tunnistada),
            <strong>õppija</strong> (võtab tunnistuse kaasa) ja <strong>AI-abilised</strong>,
            kes koolitusi otsivad ja soovitavad. Üks kord korralikult kirja pandud — kõik loevad,
            ilma iga saiti eraldi läbi käimata.
          </p>
          <div class="grid-3">
            <article class="card">
              <h3>Koolitajale / asutusele</h3>
              <p>Sama info, mida HAKA jaoks (valdkonnad 6.2 ja 6.5) niikuinii vajad, saab kujule,
                mis klapib õppekavas, veebis ja eneseanalüüsis. <strong>NB:</strong> HAKA hindab su
                <strong>asutuse võimekust</strong>, mitte üht õppekava.
                <a href="/koolitajale/kuidas-ehitada/">Kuidas ehitada →</a></p>
            </article>
            <article class="card">
              <h3>Õppijale</h3>
              <p>Sa ei pea midagi seadistama — kui su kool avaldab tunnistuse selles standardis, on
                see <strong>ülekantav ja arusaadav</strong>: järgmine kool või tööandja saab seda
                lugeda ja mõista.</p>
            </article>
            <article class="card">
              <h3>Arendajale / AI-le</h3>
              <p>Väike, masinloetav standard: loe kontekst + AGENTS.md, kaardista, valideeri, avalda.
                AI-agent teeb selle su Wordi- või Exceli-failist minutitega.</p>
            </article>
          </div>
          <div class="callout">
            <strong>Kolm sammu liitumiseks:</strong>
            <ol class="steps-list">
              <li><strong>Pane kirja põhi</strong> — nimi, õpiväljundid, maht, tase ja iga õpiväljundi hindamiskriteerium.</li>
              <li><strong>Vii standardvormi</strong> — lase AI-abilisel see failist kokku panna või küsi meilt; tulemust saab <strong>tasuta</strong> üle kontrollida (tööriist allpool).</li>
              <li><strong>Avalda ühes kohas</strong> — teised koolid, tööandjad ja otsingud loevad seda automaatselt.</li>
            </ol>
          </div>
        </div>
      </section>

      <section class="ice">
        <div class="section-inner narrow">
          <div class="section-head compact-head">
            <span class="kicker">Otspunktid</span>
            <h2>Kust andmed kätte saab.</h2>
          </div>
          <ul class="check">
            <li><strong>Vastavuskontrolli läbinud kirjed</strong> ({ccCount} programmi): <a href="/catalog.cc.jsonld"><code>/catalog.cc.jsonld</code></a></li>
            <li><strong>Üks programm</strong>: <code>/kataloog/&lt;slug&gt;/credential.jsonld</code> — ainult CC-profiili läbinud programmi leht viitab oma krediidile <code>rel="alternate"</code>-ga</li>
            <li><strong>JSON-LD kontekst</strong>: <a href="https://credentialcommons.org/profiles/context/haridus.jsonld"><code>credentialcommons.org/…/haridus.jsonld</code></a></li>
          </ul>
          <p class="report-date">
            Litsents: <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.
            Struktureeritud faktid; nimi ja lõplik info on alati kooli enda lehel.
          </p>
        </div>
      </section>

      <section class="white">
        <div class="section-inner narrow">
          <div class="section-head compact-head">
            <span class="kicker">Kontrolli vastavust</span>
            <h2>Valideeri avatud tööriistaga.</h2>
          </div>
          <pre class="codeblock">npx credential-commons validate fail.jsonld --profile micro-credential</pre>
          <p>
            Sama tööriistaga saad valideerida ka <strong>oma</strong> tunnistuse- või õppekava-andmed.
            Credential Commons on avatud (Apache-2.0 kood, CC-BY profiilid) — kasuta, forki, arenda edasi:
            <a href="https://github.com/credential-commons/credential-commons" rel="noopener">GitHub</a>.
          </p>
        </div>
      </section>

      <section class="ice">
        <div class="section-inner narrow">
          <div class="section-head compact-head">
            <span class="kicker">Küsimused arendajale</span>
            <h2>Levinud küsimused andmestandardi kohta.</h2>
          </div>
          <div class="measure-list">
            {faqItems.map((item) => (
              <article class="measure-card">
                <div>
                  <h3>{item.question}</h3>
                  <p>{item.answer}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="navy">
        <div class="section-inner contact">
          <div>
            <span class="kicker">Avatud standard</span>
            <h2>Ehitatud avatud standardile, mida me kasutame ja toetame.</h2>
            <div class="inline-actions">
              <a class="btn btn-primary" href="https://credentialcommons.org" rel="noopener" data-track-event="partner_site_click" data-track-label="andmestandard_cc">Credential Commons</a>
              <a class="btn btn-secondary" href="/andmed/" data-track-event="cta_click" data-track-label="andmestandard_andmed">Avaandmed ja turukaart</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <Footer label="Avatud andmestandard" />

    <style>
      .codeblock { background: #0f1b24; color: #e6edf3; padding: 14px 16px; border-radius: 10px; overflow-x: auto; font-size: 0.9rem; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; margin: 0 0 14px; }
      .steps-list { margin: 8px 0 2px; padding-left: 22px; }
      .steps-list li { margin: 8px 0; }
    </style>
  </body>
</html>
