---
import Seo from "../../components/Seo.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/global.css";
import { catalog, fields, catalogCheckedAt, catalogUpdatedAt } from "../../data/catalog";
import { entryOutcomeObjects, languageLabel, languageSort } from "../../data/outcomes";

const checkedAtText = catalogCheckedAt.split("-").reverse().join(".");
const updatedAtText = catalogUpdatedAt.split("-").reverse().join(".");

// Õpiväljund eraldi objektina: dedup teksti järgi, iga väljundi all programmid, mis seda õpetavad.
type OutcomeProg = { slug: string; name: string; provider: string; field: string; teachingLanguage: string | null; textLanguage: string };
type OutcomeGroup = { text: string; programmes: OutcomeProg[]; textLanguages: string[]; teachingLanguages: string[] };
const map = new Map<string, { text: string; programmes: OutcomeProg[]; textLanguages: Set<string>; teachingLanguages: Set<string> }>();
for (const e of catalog) {
  for (const outcome of entryOutcomeObjects(e)) {
    const text = outcome.text.trim();
    if (!text) continue;
    const key = text.toLowerCase();
    let g = map.get(key);
    if (!g) { g = { text, programmes: [], textLanguages: new Set(), teachingLanguages: new Set() }; map.set(key, g); }
    const textLanguage = outcome.textLanguage ?? outcome.language ?? "et";
    const teachingLanguage = outcome.teachingLanguage ?? e.language ?? null;
    g.textLanguages.add(textLanguage ?? "unknown");
    g.teachingLanguages.add(teachingLanguage ?? "unknown");
    g.programmes.push({ slug: e.slug, name: e.name, provider: e.provider, field: e.field, teachingLanguage, textLanguage });
  }
}
const outcomes: OutcomeGroup[] = [...map.values()]
  .map((group) => ({
    text: group.text,
    programmes: group.programmes,
    textLanguages: [...group.textLanguages].sort(languageSort),
    teachingLanguages: [...group.teachingLanguages].sort(languageSort)
  }))
  .sort((a, b) => a.text.localeCompare(b.text, "et"));
const programmesWithOutcomes = catalog.filter((e) => entryOutcomeObjects(e).length).length;
const fieldsWithOutcomes = fields.filter((f) => catalog.some((e) => e.field === f && entryOutcomeObjects(e).length));
const textLanguagesWithOutcomes = [...new Set(outcomes.flatMap((outcome) => outcome.textLanguages))]
  .sort(languageSort)
  .map((language) => ({
    language,
    label: languageLabel(language === "unknown" ? null : language),
    count: outcomes.filter((outcome) => outcome.textLanguages.includes(language)).length
  }));
const teachingLanguagesWithOutcomes = [...new Set(outcomes.flatMap((outcome) => outcome.teachingLanguages))]
  .sort(languageSort)
  .map((language) => ({
    language,
    label: languageLabel(language === "unknown" ? null : language),
    count: outcomes.filter((outcome) => outcome.teachingLanguages.includes(language)).length
  }));

// Match jaoks: programmi slug → metaandmed. Paketi-kirjed kannavad oma programmi-slugid
// (loetud DOM-ist lisamise hetkel), nii et katvuse arvutus käib kliendipoolel sellest kaardist.
const progIndex: Record<string, { name: string; provider: string; ects: number | null; price: string | null }> = {};
for (const e of catalog) {
  progIndex[e.slug] = { name: e.name, provider: e.provider, ects: e.ects ?? null, price: e.priceText ?? null };
}
const matchJson = JSON.stringify(progIndex).replace(/</g, "\\u003c");

const SITE = "https://mikrokvalifikatsioon.ee";
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Organization", "@id": `${SITE}/#organization`, name: "Mikrokvalifikatsioon.ee", legalName: "Ettevõtluskeskus OÜ", url: `${SITE}/` },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Avaleht", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Kataloog", item: `${SITE}/kataloog/` },
        { "@type": "ListItem", position: 3, name: "Oskused ja õpiväljundid", item: `${SITE}/oskused/` }
      ]
    },
    {
      "@type": "CollectionPage",
      name: "Mikrokvalifikatsioonide õpiväljundid",
      description: "Otsitav register mikrokvalifikatsioonide ja mikrokraadide õpiväljunditest — leia programm selle järgi, mida pärast oskad.",
      inLanguage: "et",
      url: `${SITE}/oskused/`,
      isPartOf: { "@id": `${SITE}/#organization` }
    }
  ]
};
---

<!doctype html>
<html lang="et">
  <head>
    <Seo
      title="Otsi mikrokraadi oskuse (õpiväljundi) järgi"
      description={`Mida sa pärast oskad? Otsi ${outcomes.length} õpiväljundi (õpitulemuse) seast märksõna järgi ja leia kohe, milline mikrokvalifikatsioon või mikrokraad selle oskuse annab. Pane kokku oma oskuste pakett.`}
      canonicalPath="/oskused/"
      ogTitle="Otsi mikrokraadi oskuse järgi — mida sa pärast oskad"
      ogDescription="Sisesta oskus ja näe, millised programmid selle annavad. Korja sobivad õpiväljundid oma paketti."
      jsonLd={schema}
    />
  </head>
  <body>
    <Nav />

    <main class="report-page simple-report">
      <section class="report-hero simple-report-hero">
        <div class="section-inner">
          <nav class="crumbs" aria-label="Asukoht">
            <a href="/">Avaleht</a> › <a href="/kataloog/">Kataloog</a> › <span>Oskused</span>
          </nav>
          <span class="eyebrow">Otsi oskuse järgi</span>
          <h1>Mida sa pärast oskad? Otsi õpiväljundi järgi.</h1>
          <p>
            Tavaliselt otsitakse programmi nime või valdkonna järgi. Siin otsid <strong>oskuse järgi</strong>:
            sisesta märksõna (nt „andmeanalüüs", „auditi", „juhtimine") ja näe kohe, millised
            mikrokvalifikatsioonid ja mikrokraadid just selle oskuse annavad. {outcomes.length} õpiväljundit
            {programmesWithOutcomes} programmist. Või <a href="/teema/" data-track-event="cta_click" data-track-label="oskused_to_teema">sirvi teemade kaupa</a>.
          </p>
          <p class="syn">
            „Õpiväljund" on lihtsalt see, <strong>mida sa pärast oskad</strong> — ehk mida õpetatakse,
            mis oskuse saad, õpitulemused, kursuse sisu. Korja sobivad õpiväljundid <strong>oma paketti</strong>
            ja jäta e-mail — siis teavitame, kui sellele lähedane programm või kombinatsioon lisandub.
          </p>
          <p class="report-date">Andmestik uuendatud: {updatedAtText}. Avalikud allikafaktid kontrollitud: {checkedAtText}</p>
        </div>
      </section>

      <section class="white" data-tool-section="oskuste-otsing">
        <div class="section-inner">
          <div class="form-grid catalog-filters">
            <div class="field">
              <label for="outcomeSearch">Otsi oskust / õpiväljundit</label>
              <input id="outcomeSearch" data-outcome-search placeholder="Näiteks: andmeanalüüs, auditi, projektijuhtimine" autocomplete="off" />
            </div>
            <div class="field">
              <label for="outcomeField">Valdkond</label>
              <select id="outcomeField" data-outcome-field>
                <option value="">Kõik valdkonnad</option>
                {fieldsWithOutcomes.map((f) => <option value={f}>{f}</option>)}
              </select>
            </div>
            <div class="field">
              <label for="outcomeTextLanguage">Õpiväljundi teksti keel</label>
              <select id="outcomeTextLanguage" data-outcome-text-language>
                <option value="">Kõik keeled</option>
                {textLanguagesWithOutcomes.map((item) => <option value={item.language}>{item.label} ({item.count})</option>)}
              </select>
            </div>
            <div class="field">
              <label for="outcomeTeachingLanguage">Programmi õppekeel</label>
              <select id="outcomeTeachingLanguage" data-outcome-teaching-language>
                <option value="">Kõik õppekeeled</option>
                {teachingLanguagesWithOutcomes.map((item) => <option value={item.language}>{item.label} ({item.count})</option>)}
              </select>
            </div>
          </div>
          <p class="field-help" data-outcome-count>{outcomes.length} õpiväljundit</p>
          <p class="field-help">Õpiväljundi teksti keel on kooli avaldatud lause keel. Programmi õppekeel võib sellest erineda.</p>
          <p class="field-help syn-hint" data-outcome-synonyms hidden></p>

          <ul class="outcome-list" data-outcome-list>
            {outcomes.map((o) => {
              const ofields = [...new Set(o.programmes.map((p) => p.field))];
              return (
                <li
                  class="outcome-item"
                  data-outcome
                  data-text={o.text.toLowerCase()}
                  data-fields={ofields.join("|")}
                  data-text-languages={o.textLanguages.join("|")}
                  data-teaching-languages={o.teachingLanguages.join("|")}
                >
                  <p class="outcome-text">{o.text}</p>
                  <p class="outcome-progs">
                    {o.programmes.map((p, i) => (
                      <>{i > 0 && ", "}<a href={`/kataloog/${p.slug}/`} data-track-event="cta_click" data-track-label="outcome_to_detail">{p.name}</a> <span class="outcome-prov">({p.provider} · õpe: {languageLabel(p.teachingLanguage)}{p.textLanguage !== (p.teachingLanguage ?? "unknown") ? ` · tekst: ${languageLabel(p.textLanguage)}` : ""})</span></>
                    ))}
                  </p>
                  <button type="button" class="pkg-add" data-pkg-add data-key={o.text.toLowerCase()} data-text={o.text}>+ Lisa paketti</button>
                </li>
              );
            })}
          </ul>
          <p class="field-help" data-outcome-empty hidden>Selle märksõnaga õpiväljundit ei leitud. Proovi laiemat sõna või <a href="/kataloog/">sirvi kataloogi</a>, või <a href="/kataloog/#kusi-oskust">küsi uut oskust</a>.</p>
        </div>
      </section>

      <section class="ice" id="minu-pakett" data-pkg-section hidden>
        <div class="section-inner narrow">
          <div class="section-head compact-head">
            <span class="kicker">Minu pakett</span>
            <h2>Sinu õpiväljundite pakett (<span data-pkg-count>0</span>)</h2>
            <div class="pkg-switch" data-pkg-switch-row hidden>
              <label class="pkg-switch-label" for="pkgSwitch">Pakett:</label>
              <select id="pkgSwitch" class="pkg-switch-sel" data-pkg-switch aria-label="Vali pakett"></select>
              <button type="button" class="pkg-switch-btn" data-pkg-new title="Loo uus pakett">➕ Uus pakett</button>
              <button type="button" class="pkg-switch-btn" data-pkg-rename title="Muuda paketi nime">Nimeta ümber</button>
              <button type="button" class="pkg-switch-btn pkg-switch-del" data-pkg-delete title="Kustuta see pakett">Kustuta pakett</button>
            </div>
            <p class="pkg-switch-help" data-pkg-switch-help hidden>Saad hoida mitut erinevat paketti — nt eri töökohtade või inimeste jaoks. Vali ülalt, millist praegu täidad.</p>
            <p>
              Korjasid kokku oskused, mida tahad õppida. Hoiame paketid sinu brauseris ja näitame
              allpool, milline <strong>programm või kombinatsioon</strong> su valitud oskustele kõige
              lähemal on. Jäta e-mail, siis teavitame, kui veelgi sobivam lahendus lisandub.
            </p>
            <p class="pkg-hint" data-pkg-hint hidden></p>
          </div>
          <ul class="pkg-list" data-pkg-list></ul>
          <div class="pkg-match" data-pkg-match hidden></div>
          <form class="lead-form" data-pkg-form data-site-lead-form>
            <div class="form-grid">
              <div class="field">
                <label for="pkgEmail">E-mail *</label>
                <input id="pkgEmail" name="email" type="email" required autocomplete="email" placeholder="sinu@email.ee" />
              </div>
            </div>
            <div class="inline-actions">
              <a class="btn btn-primary" href="/konto/" data-pkg-account data-track-event="cta_click" data-track-label="pkg_to_account">Salvesta see pakett ja loo konto</a>
              <button class="btn btn-secondary" type="submit">Teavita mind sobivast</button>
              <button type="button" class="btn btn-secondary" data-pkg-clear>Tühjenda see pakett</button>
            </div>
            <p class="form-note" data-pkg-account-help>
              Loo konto, siis hoiame su valitud paketi alles ja anname märku, kui sobiv programm,
              kombinatsioon või tähtaeg lisandub. Mitme paketi sünkroonimine kontole on tulekul.
              Saad konto igal ajal kustutada.
            </p>
            <p class="form-note" data-pkg-note>
              Kogume ainult sinu valitud õpiväljundid ja e-maili, et saata teade sobivast programmist või kombinatsioonist.
              Pakett püsib su brauseris. Vaata <a href="/privaatsus/">privaatsust</a>.
            </p>
          </form>
        </div>
      </section>

      <section class="navy">
        <div class="section-inner contact">
          <div>
            <span class="kicker">Ei leidnud?</span>
            <h2>Küsi oskust, mida veel ei õpetata.</h2>
            <p>Kui sulle vajalikku oskust kataloogis pole, anna teada — kogume nõudlust ja teavitame, kui selline programm lisandub.</p>
            <div class="inline-actions">
              <a class="btn btn-primary" href="/kataloog/#kusi-oskust" data-track-event="cta_click" data-track-label="oskused_demand">Küsi uut oskust</a>
              <a class="btn btn-secondary" href="/#suunatest" data-track-event="cta_click" data-track-label="oskused_suunatest">Tee suunatest</a>
            </div>
          </div>
          <aside class="contact-card">
            <h3>Kontakt</h3>
            <p>Ettevõtluskeskus OÜ</p>
            <p><a href="mailto:info@mikrokvalifikatsioon.ee" data-track-event="email_click" data-track-label="oskused_email">info@mikrokvalifikatsioon.ee</a></p>
            <p><a href="tel:+37258180435" data-track-event="phone_click" data-track-label="oskused_phone">+372 5818 0435</a></p>
          </aside>
        </div>
      </section>
    </main>

    <Footer label="Oskused ja õpiväljundid" />

    <div class="pkg-bar" data-pkg-bar hidden>
      <span data-pkg-bar-count>0 / ≈5 õpiväljundit</span>
      <a class="btn btn-primary" href="#minu-pakett" data-pkg-open data-track-event="cta_click" data-track-label="pkg_open">Vaata paketti</a>
      <button type="button" class="btn btn-secondary" data-pkg-clear>Tühjenda see pakett</button>
    </div>

    <script type="application/json" id="pkg-data" is:inline set:html={matchJson} />

    <style>
      .crumbs { font-size: 0.85rem; color: #5a6b80; margin-bottom: 12px; }
      .crumbs a { color: #5a6b80; }
      .crumbs span { color: #212121; }
      .outcome-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
      .outcome-item { background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 14px 16px; }
      .outcome-item[hidden] { display: none; }
      .outcome-text { margin: 0; font-weight: 700; color: #212121; }
      .outcome-progs { margin: 6px 0 0; font-size: 0.92rem; color: var(--muted); }
      .outcome-progs a { color: var(--teal); font-weight: 700; }
      .outcome-prov { color: var(--muted); font-weight: 400; }
      .syn { color: var(--muted); font-size: 0.95rem; margin-top: 4px; }
      .syn-hint { margin-top: 2px; font-style: italic; }
      .syn-hint[hidden] { display: none; }
      .pkg-add { margin-top: 10px; background: #fff; border: 1px solid var(--teal); color: var(--teal); border-radius: 999px; padding: 5px 12px; font-size: 0.82rem; font-weight: 700; cursor: pointer; }
      .pkg-add.is-added { background: var(--teal); color: #fff; }
      .pkg-list { list-style: none; padding: 0; margin: 0 0 16px; display: grid; gap: 8px; }
      .pkg-item { display: flex; justify-content: space-between; align-items: center; gap: 10px; background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 10px 14px; }
      .pkg-item span { font-weight: 600; color: #212121; }
      .pkg-remove { background: none; border: 0; color: #c9ccd2; font-size: 1.3rem; line-height: 1; cursor: pointer; padding: 0 4px; }
      .pkg-remove:hover { color: #e2574c; }
      .pkg-bar { position: fixed; bottom: 16px; left: 50%; transform: translateX(-50%); z-index: 50; display: flex; gap: 12px; align-items: center; padding: 10px 16px; background: #212121; color: #fff; border-radius: 12px; box-shadow: 0 18px 46px rgba(33, 33, 33, 0.3); }
      .pkg-bar[hidden] { display: none; }
      .pkg-bar .btn { width: auto; padding: 9px 14px; font-size: 0.9rem; }
      .pkg-match { background: #f3f6f3; border: 1px solid var(--line); border-radius: 12px; padding: 16px 18px; margin: 0 0 16px; }
      .pkg-match[hidden] { display: none; }
      .pm-h { margin: 0 0 8px; font-size: 1.05rem; }
      .pm-h2 { margin: 14px 0 6px; font-weight: 700; color: #212121; }
      .pm-best { margin: 0; }
      .pm-best a, .pm-combo a { color: var(--teal); font-weight: 700; }
      .pm-prov { color: var(--muted); font-weight: 400; font-size: 0.9rem; }
      .cov { display: inline-block; background: #eef4ee; color: #2f6b2c; border-radius: 999px; padding: 1px 9px; font-size: 0.8rem; font-weight: 700; }
      .pm-combo { margin: 0; padding-left: 20px; display: grid; gap: 4px; }
      .pm-note { margin: 12px 0 0; font-size: 0.9rem; color: var(--muted); }
      .pm-good { color: #2f6b2c; font-weight: 700; }
      .pkg-hint { margin: 8px 0 0; font-size: 0.9rem; font-weight: 600; }
      .pkg-hint[hidden] { display: none; }
      .pkg-hint--low { color: var(--muted); }
      .pkg-hint--good { color: #2f6b2c; }
      .pkg-hint--large { color: #8a5a2b; }
      .pkg-switch { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 4px 0 6px; }
      .pkg-switch[hidden] { display: none; }
      .pkg-switch-label { font-size: 0.9rem; font-weight: 700; color: #212121; }
      .pkg-switch-sel { font-size: 0.92rem; font-weight: 600; color: #212121; background: #fff; border: 1px solid var(--line); border-radius: 8px; padding: 6px 10px; max-width: 16rem; }
      .pkg-switch-btn { background: #fff; border: 1px solid var(--line); color: #212121; border-radius: 8px; padding: 6px 12px; font-size: 0.85rem; font-weight: 600; cursor: pointer; }
      .pkg-switch-btn:hover { border-color: var(--teal); color: var(--teal); }
      .pkg-switch-del:hover { border-color: #e2574c; color: #e2574c; }
      .pkg-switch-btn:disabled { opacity: 0.45; cursor: not-allowed; }
      .pkg-switch-btn:disabled:hover { border-color: var(--line); color: #212121; }
      .pkg-switch-help { margin: 0 0 8px; font-size: 0.88rem; color: var(--muted); }
      .pkg-switch-help[hidden] { display: none; }
    </style>

    <script>
      import { computeFit, type CoverageRow } from "../../lib/outcome-fit";
      import { expandQuery } from "../../lib/skill-match";
      import { skillSynonyms } from "../../data/skillSynonyms";
      import {
        emptyState, migrateLegacy, activePackage, ensureActive,
        createPackage, renamePackage, deletePackage, setActive,
        addItem, removeItem, type PkgItem, type PackagesState,
      } from "../../lib/packages";
      // KONTO-API on TARBI-AINULT: loeme ainult seisundit (sees/väljas), et
      // konto-CTA ei ütleks "loo konto", kui kasutaja on juba sees. Ei muuda midagi.
      import { kontoEnabled, getSession } from "../../lib/konto-api";
      const search = document.querySelector("[data-outcome-search]") as HTMLInputElement | null;
      const fieldSel = document.querySelector("[data-outcome-field]") as HTMLSelectElement | null;
      const textLanguageSel = document.querySelector("[data-outcome-text-language]") as HTMLSelectElement | null;
      const teachingLanguageSel = document.querySelector("[data-outcome-teaching-language]") as HTMLSelectElement | null;
      const count = document.querySelector("[data-outcome-count]");
      const synHint = document.querySelector("[data-outcome-synonyms]") as HTMLElement | null;
      const empty = document.querySelector("[data-outcome-empty]") as HTMLElement | null;
      const escHint = (s: string) => s.replace(/[&<>"]/g, (c) => (({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }) as Record<string, string>)[c] || c);
      const items = [...document.querySelectorAll<HTMLElement>("[data-outcome]")];
      const track = (n: string, p: Record<string, unknown>) => (window as any).digiteekaartTrack?.(n, p);
      let lastTracked = "";
      let visibleNow = items.length;
      let lastExpanded = false;
      let searchTimer: ReturnType<typeof setTimeout> | undefined;

      // Salvesta alles kirjutamise vaibumisel: oma `outcome_search` (tulemustega, sh 0 = auk)
      // + GA4-natiivne `view_search_results`/`search_term` (näha GA4 "Otsingusõnad" aruandes).
      const trackSearch = (): void => {
        const term = (search?.value || "").trim().toLowerCase();
        if (!term || term.length < 3 || term === lastTracked) return;
        lastTracked = term;
        track("outcome_search", { term: term.slice(0, 60), results: visibleNow, expanded: lastExpanded });
        track("view_search_results", { search_term: term.slice(0, 80), results: visibleNow, source: "oskused" });
      };

      const apply = (): void => {
        const term = (search?.value || "").trim().toLowerCase();
        const f = fieldSel?.value || "";
        const textLanguage = textLanguageSel?.value || "";
        const teachingLanguage = teachingLanguageSel?.value || "";
        // Laienda otsingusõna lähedasteks mõisteteks (sünonüümid/käänded). Tühi sõna
        // näitab kõike; vaste = data-text sisaldab MÕNDA laiendatud terminit (alamsõne).
        const { terms, clusters } = term ? expandQuery(term, skillSynonyms) : { terms: [] as string[], clusters: [] as string[] };
        lastExpanded = clusters.length > 0;
        let visible = 0;
        for (const it of items) {
          const text = it.dataset.text || "";
          const matchesTerm = !term || terms.some((t) => text.includes(t));
          const show = matchesTerm &&
            (!f || (it.dataset.fields || "").split("|").includes(f)) &&
            (!textLanguage || (it.dataset.textLanguages || "").split("|").includes(textLanguage)) &&
            (!teachingLanguage || (it.dataset.teachingLanguages || "").split("|").includes(teachingLanguage));
          it.hidden = !show;
          if (show) visible += 1;
        }
        visibleNow = visible;
        if (count) count.textContent = `${visible} õpiväljundit`;
        if (synHint) {
          // Ainult siis, kui lähedasi mõisteid leiti JA midagi on näha — muidu
          // satuks vihje vastuollu "ei leitud" tühisõnumiga.
          if (term && clusters.length && visible > 0) {
            synHint.innerHTML = `Näitan ka lähedasi: ${clusters.map(escHint).join(", ")}`;
            synHint.hidden = false;
          } else {
            synHint.textContent = "";
            synHint.hidden = true;
          }
        }
        if (empty) empty.hidden = visible !== 0;
        clearTimeout(searchTimer);
        searchTimer = setTimeout(trackSearch, 600);
      };

      search?.addEventListener("input", apply);
      fieldSel?.addEventListener("change", apply);
      textLanguageSel?.addEventListener("change", apply);
      teachingLanguageSel?.addEventListener("change", apply);

      // Sügavlink /oskused/?q=oskus eeltäidab otsingu.
      const q = new URLSearchParams(window.location.search).get("q");
      if (q && search) { search.value = q; apply(); }

      // ---- Õpiväljundite pakett (kogu oskused → jäta e-mail; match tuleb järgmisena) ----
      const PKG_KEY = "mkval:pakett";          // legacy: AKTIIVSE paketi kirjed (taasloetavus)
      const PKGS_KEY = "mkval:paketid";        // tõeallikas: kogu PackagesState
      const pkgBar = document.querySelector("[data-pkg-bar]") as HTMLElement | null;
      const pkgBarCount = document.querySelector("[data-pkg-bar-count]");
      const pkgSection = document.querySelector("[data-pkg-section]") as HTMLElement | null;
      const pkgCount = document.querySelector("[data-pkg-count]");
      const pkgHint = document.querySelector("[data-pkg-hint]") as HTMLElement | null;
      const pkgList = document.querySelector("[data-pkg-list]") as HTMLElement | null;
      const pkgForm = document.querySelector("[data-pkg-form]") as HTMLFormElement | null;
      const pkgNote = document.querySelector("[data-pkg-note]");
      const addBtns = [...document.querySelectorAll<HTMLButtonElement>("[data-pkg-add]")];
      const matchBox = document.querySelector("[data-pkg-match]") as HTMLElement | null;
      // Mitme-paketi vahetaja (paneeli päises)
      const pkgSwitchRow = document.querySelector("[data-pkg-switch-row]") as HTMLElement | null;
      const pkgSwitchHelp = document.querySelector("[data-pkg-switch-help]") as HTMLElement | null;
      const pkgSwitch = document.querySelector("[data-pkg-switch]") as HTMLSelectElement | null;
      const pkgNewBtn = document.querySelector("[data-pkg-new]") as HTMLButtonElement | null;
      const pkgRenameBtn = document.querySelector("[data-pkg-rename]") as HTMLButtonElement | null;
      const pkgDeleteBtn = document.querySelector("[data-pkg-delete]") as HTMLButtonElement | null;
      const pkgDataEl = document.getElementById("pkg-data");
      let PROG: Record<string, { name: string; provider: string; ects: number | null; price: string | null }> = {};
      try { if (pkgDataEl) PROG = JSON.parse(pkgDataEl.textContent || "{}"); } catch { PROG = {}; }
      const escHtml = (s: string) => s.replace(/[&<>"]/g, (c) => (({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }) as Record<string, string>)[c] || c);
      // Hinna esimene arvugrupp ("2 530 €" → 2530); tundmatu → null (ei mõtle juurde).
      const parsePriceEur = (priceText: string | null): number | null => {
        if (typeof priceText !== "string") return null;
        const m = priceText.replace(/ /g, " ").match(/\d[\d\s]*/);
        if (!m) return null;
        const n = Number(m[0].replace(/\s/g, ""));
        return Number.isFinite(n) && n > 0 ? n : null;
      };
      let lastMatchSig = "";

      // Brauseripoolne id + ajatempel; seeme mooduli puhastele fn-idele (nimi kaasas).
      const newId = (): string => {
        try { return crypto.randomUUID(); } catch { return "p_" + Date.now().toString(36) + Math.random().toString(36).slice(2, 8); }
      };
      const seed = (name: string) => ({ id: newId(), name, createdAt: Date.now() });
      // Järgmine vaikenimi: suurim olemasolev "Minu pakett N" + 1 (väldib korduvaid
      // nimesid pärast kustutamist). Varuvariant: pakettide arv + 1.
      const nextName = (): string => {
        let n = 0;
        for (const p of state.packages) { const m = /(\d+)\s*$/.exec(p.name); if (m) n = Math.max(n, Number(m[1])); }
        return `Minu pakett ${Math.max(n, state.packages.length) + 1}`;
      };

      // Laadi tõeallikas; kui puudub, migreeri legacy üksik-pakett (mkval:pakett).
      // - olemasolev MITTETÜHI olek võidab (ka v>2 — ei klobberda uuemat formaati);
      // - tühi olek + legacy kirjed → migreeri legacy (existing=null, et päriselt migreeriks);
      // - muidu tühi olek.
      const loadState = (): PackagesState => {
        let stored: PackagesState | null = null;
        try {
          const raw = localStorage.getItem(PKGS_KEY);
          if (raw) {
            const s = JSON.parse(raw);
            if (s && typeof s.v === "number" && s.v >= 2 && Array.isArray(s.packages)) stored = s as PackagesState;
          }
        } catch { stored = null; }
        let legacy: PkgItem[] = [];
        try { legacy = JSON.parse(localStorage.getItem(PKG_KEY) || "[]"); } catch { legacy = []; }
        if (stored && stored.packages.length) return stored;
        if (Array.isArray(legacy) && legacy.length) return migrateLegacy(legacy, null, seed("Minu pakett"));
        return stored ?? emptyState();
      };

      let state: PackagesState = loadState();

      // Kirjuta tõeallikas + peegelda AKTIIVSE paketi kirjed legacy võtmesse,
      // et olemasolevad lugejad (sh /konto/) töötaksid edasi.
      const persist = (): void => {
        try { localStorage.setItem(PKGS_KEY, JSON.stringify(state)); } catch { /* paketid elavad lehe piires */ }
        try { localStorage.setItem(PKG_KEY, JSON.stringify(activePackage(state)?.items ?? [])); } catch { /* sama */ }
      };

      // Aktiivse paketi kirjed (asendab vana readPkg()).
      const items_ = (): PkgItem[] => activePackage(state)?.items ?? [];

      // Hea pakett on umbes 5 õpiväljundit (mikrokvalifikatsiooni hea toon). Puhas
      // abifunktsioon: ainult soovituslik juhis, ei piira ega blokeeri lisamist.
      const PKG_TARGET = 5;
      const packageSizeHint = (n: number): { label: string; tone: "low" | "good" | "large" } | null => {
        if (n <= 0) return null;
        if (n <= 4) return { label: "Lisa veel — hea pakett on umbes 5 õpiväljundit.", tone: "low" };
        if (n <= 6) return { label: "✓ Hea suurus — umbes 5 õpiväljundit on mikrokvalifikatsioonis hea toon.", tone: "good" };
        return { label: "Päris suur pakett. Kõige selgemad paketid on umbes 5 oskust — võid soovi korral teha ka mitu väiksemat.", tone: "large" };
      };

      // Parim üksik programm + parim kombinatsioon (greedy set-cover) valitud õpiväljunditele.
      const renderMatch = (arr: PkgItem[]): void => {
        if (!matchBox) return;
        const matchable = arr.filter((i) => i.progs && i.progs.length);
        if (matchable.length < 1) { matchBox.hidden = true; matchBox.innerHTML = ""; return; }
        const total = matchable.length;
        // Ehita AMOS-i katvuse-projektsioon paketist (slug → kaetud õpiväljundid + faktid)
        // ja lase see läbi kanoonilise fit-mootori (amos.outcome.fit/v1, vendored).
        const cover = new Map<string, Set<string>>(); // programmi slug → kaetud õpiväljundid
        for (const it of matchable) {
          for (const slug of it.progs as string[]) {
            if (!cover.has(slug)) cover.set(slug, new Set());
            (cover.get(slug) as Set<string>).add(it.key);
          }
        }
        const projection: CoverageRow[] = [...cover.entries()].map(([slug, set]) => {
          const p = PROG[slug];
          return {
            variant_ref: slug,
            outcome_refs: [...set],
            eap: p && p.ects != null ? p.ects : null,
            price_eur: parsePriceEur(p ? p.price : null),
            title: p ? p.name : slug,
            school: p ? p.provider : null,
          };
        });
        const fit = computeFit(matchable.map((i) => i.key), projection);
        const best = fit.best_single;
        const combo = fit.combination;
        const meta = (slug: string) => PROG[slug] || { name: slug, provider: "", ects: null, price: null };
        const line = (slug: string, n?: number): string => {
          const p = meta(slug);
          const facts = [p.provider, p.ects != null ? `${p.ects} EAP` : "", p.price || ""].filter(Boolean).join(" · ");
          const cov = n != null ? ` <span class="cov">katab ${n}/${total}</span>` : "";
          return `<a href="/kataloog/${slug}/" data-track-event="cta_click" data-track-label="pkg_match_detail">${escHtml(p.name)}</a> <span class="pm-prov">${escHtml(facts)}</span>${cov}`;
        };
        const allInOne = !!best && best.fully_covers;
        let html = `<h3 class="pm-h">Sobivaim sinu paketile (${total} oskust)</h3>`;
        if (best) {
          html += `<p class="pm-best">${line(best.variant_ref, best.covered_count)}</p>`;
          if (allInOne) {
            html += `<p class="pm-note pm-good">✓ See üksik programm katab kogu su paketi.</p>`;
          } else {
            html += `<p class="pm-h2">Täielikuks katteks (${combo.covered_refs.length}/${total}) sobib kombinatsioon:</p>`;
            html += `<ol class="pm-combo">${combo.variants.map((v) => `<li>${line(v.variant_ref)}</li>`).join("")}</ol>`;
            const tail = combo.fully_covered
              ? "Ükski üksik programm ei kata kogu su paketti — sa soovid oskuste kombinatsiooni, mida praegu pakub vaid mitu eri programmi. Jäta e-mail, siis teavitame, kui sellele lähedasem terviklik lahendus lisandub."
              : `Praegused programmid katavad sinu paketist ${combo.covered_refs.length}/${total} oskust — kõigile su valitud oskustele veel ühtegi katet pole. Jäta e-mail, siis teavitame, kui lisandub programm, mis su paketti paremini katab.`;
            html += `<p class="pm-note">${tail}</p>`;
          }
        }
        matchBox.innerHTML = html;
        matchBox.hidden = false;
        const sig = matchable.map((i) => i.key).sort().join("|");
        if (sig !== lastMatchSig) {
          lastMatchSig = sig;
          track("package_match", { count: total, best_coverage: best ? best.covered_count : 0, combo_size: combo.program_count, all_in_one: allInOne ? "jah" : "ei" });
        }
      };

      // Seisundi-teadlik konto-CTA: kui kasutaja on JUBA sees, ei tohi nupp öelda
      // "loo konto". Loeme seisundi sama mehhanismiga, mida konto kasutab:
      //  - REAL-tee (kontoEnabled): kehtiv seanss (getSession)
      //  - DEMO-tee (lipp maas): mkval:account sild selles brauseris
      // konto-api on TARBI-AINULT — me ei muuda selle loogikat. Pakett liigub
      // kontole järgmise /konto/ külastuse (REAL: sünk; DEMO: union-merge) kaudu.
      const accountBtn = document.querySelector("[data-pkg-account]") as HTMLAnchorElement | null;
      const hasAccountSession = (): boolean => {
        try {
          if (kontoEnabled()) return !!getSession();
          return !!localStorage.getItem("mkval:account");
        } catch { return false; }
      };
      if (accountBtn && hasAccountSession()) {
        // Sees → ei "loo konto", vaid salvesta oma kontole + paku konto avamist.
        accountBtn.textContent = "Salvesta oma kontole";
        const accountHelp = document.querySelector("[data-pkg-account-help]");
        if (accountHelp) {
          accountHelp.textContent =
            'Sa oled juba sees. Salvestame su valitud paketi sinu kontole - ava „Minu konto", et seda hallata, seada tähtsust ja näha sobivaid programme.';
        }
        // Lisa kerge teisene tegevus: ava Minu konto (kui seda veel pole).
        const actions = accountBtn.parentElement;
        if (actions && !actions.querySelector("[data-pkg-account-open]")) {
          const open = document.createElement("a");
          open.className = "btn btn-secondary";
          open.href = "/konto/";
          open.textContent = "Ava Minu konto";
          open.setAttribute("data-pkg-account-open", "");
          open.setAttribute("data-track-event", "cta_click");
          open.setAttribute("data-track-label", "pkg_open_account");
          accountBtn.insertAdjacentElement("afterend", open);
        }
      }

      // Vahetaja: täida <select> pakettide nimedega, aktiivne valitud. Nimed jäävad
      // AINULT siia/localStorage'i — neid ei saadeta kunagi GA4-le ega /api/subscribe'ile.
      const renderSwitch = (): void => {
        if (pkgSwitchRow) pkgSwitchRow.hidden = state.packages.length === 0;
        if (pkgSwitchHelp) pkgSwitchHelp.hidden = state.packages.length < 2;
        if (pkgDeleteBtn) pkgDeleteBtn.disabled = state.packages.length <= 1;
        if (!pkgSwitch) return;
        pkgSwitch.innerHTML = "";
        for (const p of state.packages) {
          const opt = document.createElement("option");
          opt.value = p.id;
          opt.textContent = `${p.name} (${p.items.length})`;
          if (p.id === state.activeId) opt.selected = true;
          pkgSwitch.appendChild(opt);
        }
      };

      let pkgViewed = false;
      const renderPkg = (): void => {
        renderSwitch();
        const arr = items_();
        const keys = new Set(arr.map((i) => i.key));
        addBtns.forEach((b) => {
          const inPkg = keys.has(b.dataset.key || "");
          b.classList.toggle("is-added", inPkg);
          b.textContent = inPkg ? "✓ Paketis" : "+ Lisa paketti";
        });
        if (pkgBar) pkgBar.hidden = arr.length === 0;
        if (pkgBarCount) pkgBarCount.textContent = `${arr.length} / ≈${PKG_TARGET} õpiväljundit`;
        if (pkgSection) pkgSection.hidden = arr.length === 0;
        if (pkgCount) pkgCount.textContent = String(arr.length);
        if (pkgHint) {
          const hint = packageSizeHint(arr.length);
          pkgHint.hidden = !hint;
          pkgHint.textContent = hint ? hint.label : "";
          pkgHint.className = "pkg-hint" + (hint ? ` pkg-hint--${hint.tone}` : "");
        }
        if (pkgList) {
          pkgList.innerHTML = "";
          for (const it of arr) {
            const li = document.createElement("li");
            li.className = "pkg-item";
            const span = document.createElement("span");
            span.textContent = it.text;
            const rm = document.createElement("button");
            rm.type = "button";
            rm.className = "pkg-remove";
            rm.setAttribute("data-pkg-remove", it.key);
            rm.setAttribute("aria-label", "Eemalda paketist");
            rm.textContent = "×";
            li.append(span, rm);
            pkgList.appendChild(li);
          }
        }
        renderMatch(arr);
        if (arr.length && !pkgViewed) { pkgViewed = true; track("package_view", { count: arr.length, package_count: state.packages.length }); }
      };

      addBtns.forEach((b) => b.addEventListener("click", () => {
        const key = b.dataset.key || "";
        const text = b.dataset.text || "";
        if (!key) return;
        // Värske külastaja: esimene "Lisa paketti" loob vaikepaketi ("Minu pakett 1").
        // ensureActive on idempotentne — olemasoleva aktiivse korral ei muuda midagi.
        state = ensureActive(state, seed(nextName()));
        const cur = items_();
        if (cur.some((i) => i.key === key)) {
          state = removeItem(state, key);
        } else {
          const li = b.closest("[data-outcome]");
          const progs = li
            ? [...li.querySelectorAll('a[href^="/kataloog/"]')]
                .map((a) => (a.getAttribute("href") || "").split("/").filter(Boolean).pop() || "")
                .filter(Boolean)
            : [];
          state = addItem(state, { key, text: text.slice(0, 200), progs });
          track("outcome_add", { outcome: text.slice(0, 80), package_size: items_().length, package_count: state.packages.length });
        }
        persist();
        renderPkg();
      }));

      pkgList?.addEventListener("click", (e) => {
        const t = e.target as HTMLElement;
        const k = t.getAttribute?.("data-pkg-remove");
        if (!k) return;
        state = removeItem(state, k);
        persist();
        renderPkg();
      });

      // "Tühjenda see pakett" — tühjendab AINULT aktiivse paketi kirjed, mitte teisi pakette.
      [...document.querySelectorAll("[data-pkg-clear]")].forEach((b) =>
        b.addEventListener("click", () => {
          for (const it of [...items_()]) state = removeItem(state, it.key);
          persist();
          renderPkg();
        })
      );

      // ---- Mitme paketi haldus: vali / loo / nimeta / kustuta ----
      pkgSwitch?.addEventListener("change", () => {
        state = setActive(state, pkgSwitch.value);
        persist();
        renderPkg();
        track("package_switch", { package_count: state.packages.length });
      });

      pkgNewBtn?.addEventListener("click", () => {
        state = createPackage(state, seed(nextName()));
        persist();
        renderPkg();
        track("package_create", { package_count: state.packages.length });
      });

      pkgRenameBtn?.addEventListener("click", () => {
        const active = activePackage(state);
        if (!active) return;
        const name = window.prompt("Anna sellele paketile nimi (nt „Müügiinimese pakett“):", active.name);
        if (name == null) return;            // tühistati
        const trimmed = name.trim().slice(0, 60);
        if (!trimmed) return;                // tühi nimi → jäta vanaks
        state = renamePackage(state, active.id, trimmed);
        persist();
        renderPkg();
        // NB: nime EI saadeta kunagi analüütikasse — jääb ainult localStorage'i.
      });

      pkgDeleteBtn?.addEventListener("click", () => {
        if (state.packages.length <= 1) return; // viimast paketti ei kustuta (nupp ka disabled)
        const active = activePackage(state);
        if (!active) return;
        if (!window.confirm(`Kustutan paketi „${active.name}“? Selle valitud oskused kaovad.`)) return;
        state = deletePackage(state, active.id);
        persist();
        renderPkg();
        track("package_delete", { package_count: state.packages.length });
      });

      pkgForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!pkgForm.reportValidity()) return;
        const arr = items_();
        if (!arr.length) { if (pkgNote) pkgNote.textContent = "Lisa esmalt mõni õpiväljund paketti."; return; }
        const email = String(new FormData(pkgForm).get("email") || "");
        track("lead_form_submit_attempt", { form_name: "outcome_package", count: arr.length, package_count: state.packages.length });
        // Suuname AMOS-i sissevoolu (api/subscribe → double-opt-in). Kuni backend pole
        // main'is / env seadmata, vastab see 404/503 → mailto varuvariant (leadi ei kaota).
        let sent = false;
        let rateLimited = false;
        try {
          const r = await fetch("/api/subscribe", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ kind: "outcome_package", email, source_site: "mikrokvalifikatsioon_ee", outcomes: arr.map((i) => i.text) })
          });
          sent = r.ok;
          rateLimited = r.status === 429;
        } catch { sent = false; }
        // A 429 is the rate limiter working as designed, not a failure - do
        // not fall through to the mailto fallback for it.
        if (!sent && !rateLimited) {
          const body = encodeURIComponent("Soovitud õpiväljundid:\n- " + arr.map((i) => i.text).join("\n- ") + "\n\nE-mail: " + email);
          window.location.href = `mailto:info@mikrokvalifikatsioon.ee?subject=${encodeURIComponent("Õpiväljundite pakett")}&body=${body}`;
        }
        // Only a confirmed webhook success counts as a submit - mailto is a
        // fallback for a failed request, not a conversion.
        if (sent) {
          track("lead_form_submit", { form_name: "outcome_package", count: arr.length, delivery: "webhook", package_count: state.packages.length });
        }
        if (pkgNote) pkgNote.textContent = sent
          ? "Aitäh! Teavitame sind, kui sobiv programm või kombinatsioon lisandub."
          : rateLimited
            ? "Korraga tuli liiga palju päringuid. Palun proovi mõne minuti pärast uuesti."
            : "Avasime e-kirja varuvariandi — vajuta saatmiseks Saada.";
      });

      renderPkg();
    </script>
  </body>
</html>
