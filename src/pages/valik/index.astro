---
import Seo from "../../components/Seo.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/global.css";
import { catalog } from "../../data/catalog";
import { matchProgrammes } from "../../lib/suunatest-match";
import { VALIK_FIELDS } from "../../lib/valik-fields";

const counts = VALIK_FIELDS.map((f) => ({ ...f, n: matchProgrammes(catalog as any, { field: f.field, format: "", budget: "" }, catalog.length).matches.length }));
const title = "Vali valdkond: sobivad mikrokvalifikatsioonid";
const description = "Vali huvipakkuv valdkond ja näe programme, mille ametlik EHIS-i õppekavarühm tõesti sinna kuulub. Ilma ebaseotud tulemusteta.";
---
<!doctype html>
<html lang="et">
  <head>
    <Seo title={title} description={description} canonicalPath="/valik/" />
  </head>
  <body>
    <Nav />
    <main class="report-page simple-report">
      <section class="report-hero simple-report-hero">
        <div class="section-inner">
          <h1>{title}</h1>
          <p>{description} Soovid täpsemat valikut vormi ja eelarve järgi? Tee <a href="/#suunatest">suunatest</a>.</p>
        </div>
      </section>
      <section class="white">
        <div class="section-inner">
          <ul class="chips">
            {counts.filter((f) => f.n > 0).map((f) => (
              <li><a class="chip chip-alt" href={`/valik/${f.slug}/`} data-track-event="cta_click" data-track-label="valik_valdkond">{f.field} <b>{f.n}</b></a></li>
            ))}
          </ul>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
