---
import Seo from "../../components/Seo.astro";
import CategoryMark from "../../components/CategoryMark.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/global.css";
import { topics, topicOutcomes, type Topic } from "../../data/topics";
import { fieldsWithSlug, catalogCheckedAt, catalogUpdatedAt } from "../../data/catalog";
import { parsePriceEur, toCourse } from "../../data/courseSchema";

export function getStaticPaths() {
  return topics.map((t) => ({ params: { slug: t.slug }, props: { topic: t } }));
}

const { topic } = Astro.props as { topic: Topic };
const entries = topic.entries;
const checkedAtText = catalogCheckedAt.split("-").reverse().join(".");
const updatedAtText = catalogUpdatedAt.split("-").reverse().join(".");
const labelLower = topic.label.replace(/\s*\(.*?\)\s*/g, "").toLowerCase();

const providersInTopic = [...new Set(entries.map((e) => e.provider))];
const prices = entries.map((e) => parsePriceEur(e.priceText)).filter((p): p is number => p != null && p > 0);
const minPrice = prices.length ? Math.min(...prices) : null;
const maxPrice = prices.length ? Math.max(...prices) : null;
const freeCount = entries.filter((e) => parsePriceEur(e.priceText) === 0).length;
const ectsVals = entries.map((e) => e.ects).filter((n): n is number => n != null);
const minEcts = ectsVals.length ? Math.min(...ectsVals) : null;
const maxEcts = ectsVals.length ? Math.max(...ectsVals) : null;
const ectsRangeText =
  minEcts != null && maxEcts != null ? (minEcts === maxEcts ? `${minEcts} EAP` : `${minEcts}–${maxEcts} EAP`) : null;
const priceRangeText =
  minPrice != null && maxPrice != null ? (minPrice === maxPrice ? `${minPrice} €` : `${minPrice}–${maxPrice} €`) : null;

// Tasemejaotus selle oskuse/teema all: ülikooli mikrokraad vs koolitusettevõtte
// mikrokvalifikatsioon — päris andmetest, sama mõistepiir kui valdkonnalehel.
const degreeCount = entries.filter((e) => e.providerType === "ülikool").length;
const qualCount = entries.length - degreeCount;

// Valdkonnad, mida see teema katab → lingid valdkonnalehtedele.
const topicFields = fieldsWithSlug.filter((f) => entries.some((e) => e.field === f.field));

// Seotud teemad: jagavad programme selle teemaga.
const mySlugs = new Set(entries.map((e) => e.slug));
const related = topics
  .filter((t) => t.slug !== topic.slug)
  .map((t) => ({ t, overlap: t.entries.filter((e) => mySlugs.has(e.slug)).length }))
  .filter((r) => r.overlap > 0)
  .sort((a, b) => b.overlap - a.overlap)
  .slice(0, 6)
  .map((r) => r.t);

const outcomes = topicOutcomes(topic).slice(0, 14);

const SITE = "https://mikrokvalifikatsioon.ee";
const canonicalPath = `/teema/${topic.slug}/`;

const fullTitle = `${topic.label} mikrokraad ja mikrokvalifikatsioon`;
const title = fullTitle.length <= 66 ? fullTitle : `${topic.label} – mikrokraadid`;
const description = `${entries.length} ${labelLower} mikrokraadi ja mikrokvalifikatsiooni ${providersInTopic.length} koolist${ectsRangeText ? `, maht ${ectsRangeText}` : ""}${priceRangeText ? `, hind ${priceRangeText}` : ""} — võrdle õpiväljundeid, mahtu ja hinda. Seotud: ${topic.synonyms.join(", ")}.`;

// Extractable intent intro (1–2 lauset) — kuvatud lehel JA WebPage.description'is,
// nii et AI-assistendid saavad oskuse/teema kokkuvõtte kohe kätte.
const introText =
  `${topic.label} (${labelLower}) õppeks on registris ${entries.length} mikrokraadi ja mikrokvalifikatsiooni ${providersInTopic.length} koolist` +
  `${degreeCount > 0 && qualCount > 0 ? ` — ${degreeCount} ülikooli mikrokraadi ja ${qualCount} koolitusettevõtte mikrokvalifikatsiooni` : ""}` +
  `${ectsRangeText ? `. Maht ${ectsRangeText}` : ""}${priceRangeText ? `, hind ${priceRangeText}` : ""}.`;

const faq = [
  { q: `Kust leiab ${labelLower} mikrokraadi?`,
    a: `${labelLower} mikrokraadi ja mikrokvalifikatsiooni pakub ${providersInTopic.length} kooli: ${providersInTopic.join(", ")}. Kõik ${entries.length} programmi on allpool koos õpiväljundite, mahu ja hinnaga.` },
  { q: `Kui palju maksab ${labelLower} mikrokraad?`,
    a: priceRangeText
      ? `Selle teema programmid maksavad umbes ${priceRangeText}${freeCount ? `, ${freeCount} on mõnele sihtrühmale rahastatud` : ""}. Täpne hind on iga programmi juures.`
      : `Hind on iga programmi juures ja kooli lehel.` },
  ...(degreeCount > 0 && qualCount > 0
    ? [{ q: `${topic.label}: mikrokraad või mikrokvalifikatsioon?`,
        a: `Sellel teemal on ${degreeCount} ülikooli mikrokraadi (annavad EAP-sid, sageli tasemeõppes arvestatavad) ja ${qualCount} koolitusettevõtte või rakenduskõrgkooli mikrokvalifikatsiooni (kiirem praktiline oskus). Vali eesmärgi järgi.` }]
    : []),
  { q: `Kes maksab ${labelLower} õppe eest?`,
    a: `Sageli ei maksa õppija kõike ise: Töötukassa, tööandja koolituseelarve või õppija ise. Vaata lähemalt lehelt „Kes maksab?".` }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Organization", "@id": `${SITE}/#organization`, name: "Mikrokvalifikatsioon.ee", legalName: "Ettevõtluskeskus OÜ", url: `${SITE}/` },
    {
      "@type": "WebPage",
      "@id": `${SITE}${canonicalPath}#webpage`,
      url: `${SITE}${canonicalPath}`,
      name: title,
      description: introText,
      inLanguage: "et",
      isPartOf: { "@id": `${SITE}/#organization` },
      about: { "@type": "DefinedTerm", name: topic.label, alternateName: topic.synonyms }
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Avaleht", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Teemad", item: `${SITE}/teema/` },
        { "@type": "ListItem", position: 3, name: topic.label, item: `${SITE}${canonicalPath}` }
      ]
    },
    {
      "@type": "ItemList",
      name: `${topic.label} — mikrokvalifikatsioonid ja mikrokraadid`,
      numberOfItems: entries.length,
      itemListElement: entries.map((entry, index) => ({
        "@type": "ListItem", position: index + 1, item: toCourse(entry)
      }))
    },
    {
      "@type": "FAQPage",
      mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } }))
    }
  ]
};
---

<!doctype html>
<html lang="et">
  <head>
    <Seo
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      ogTitle={`${topic.label} — mikrokraadid Eestis`}
      ogDescription={`${entries.length} programmi ${providersInTopic.length} koolist: õpiväljundid, maht ja hind ühes kohas.`}
      jsonLd={schema}
    />
  </head>
  <body>
    <Nav />

    <main class="report-page simple-report">
      <section class="report-hero simple-report-hero">
        <div class="section-inner">
          <nav class="crumbs" aria-label="Asukoht">
            <a href="/">Avaleht</a> › <a href="/teema/">Teemad</a> › <span>{topic.label}</span>
          </nav>
          <CategoryMark kind="topic" />
          <span class="eyebrow">Oskus / teema</span>
          <h1>{topic.label}: mikrokraad ja mikrokvalifikatsioon</h1>
          <p>
            {introText}
            {" "}Võrdle õpiväljundeid, mahtu ja hinda — või <a href={`/oskused/?q=${encodeURIComponent(labelLower)}`} data-track-event="cta_click" data-track-label="topic_to_oskused">otsi õpiväljundi järgi</a>.
          </p>
          {topic.synonyms.length > 0 && (
            <p class="syn">Seotud otsingud: {topic.synonyms.join(" · ")}</p>
          )}
          <p class="report-date">Andmestik uuendatud: {updatedAtText}. Avalikud allikafaktid kontrollitud: {checkedAtText}</p>
        </div>
      </section>

      {degreeCount > 0 && qualCount > 0 && (
        <section class="ice">
          <div class="section-inner narrow">
            <div class="section-head compact-head">
              <span class="kicker">Tasemejaotus</span>
              <h2>{degreeCount} mikrokraadi ja {qualCount} mikrokvalifikatsiooni</h2>
              <p>
                „Mikrokraad" on ülikooli lühiõpe, mis annab EAP-sid (sageli tasemeõppes arvestatavad);
                „mikrokvalifikatsioon" on koolitusettevõtte või rakenduskõrgkooli lühiõpe kiireks praktiliseks oskuseks.
                Teemal „{labelLower}" jagunevad programmid nii:
              </p>
            </div>
            <div class="level-grid">
              <div class="level-card">
                <p class="level-num">{degreeCount}</p>
                <p class="level-lbl">ülikooli mikrokraadi</p>
                <p class="level-links">
                  <a href="/mikrokraadi-valimine/" data-track-event="cta_click" data-track-label="topic_to_degree_valimine">Kuidas mikrokraadi valida →</a>
                  <a href="/mikrokraadide-vordlus/" data-track-event="cta_click" data-track-label="topic_to_degree_vordlus">Mikrokraadide võrdlus →</a>
                </p>
              </div>
              <div class="level-card">
                <p class="level-num">{qualCount}</p>
                <p class="level-lbl">mikrokvalifikatsiooni</p>
                <p class="level-links">
                  <a href="/mikrokvalifikatsiooni-valimine/" data-track-event="cta_click" data-track-label="topic_to_qual_valimine">Kuidas mikrokvalifikatsiooni valida →</a>
                  <a href="/mikrokvalifikatsioonide-vordlus/" data-track-event="cta_click" data-track-label="topic_to_qual_vordlus">Mikrokvalifikatsioonide võrdlus →</a>
                </p>
              </div>
            </div>
          </div>
        </section>
      )}

      <section class="white">
        <div class="section-inner">
          <h2 class="block-title">{entries.length} programmi</h2>
          <ul class="prog-grid">
            {entries.map((entry) => (
              <li class="prog-card">
                <a class="prog-name" href={`/kataloog/${entry.slug}/`} data-track-event="cta_click" data-track-label="topic_to_detail">{entry.name}</a>
                <p class="prog-prov">{entry.provider}</p>
                <p class="prog-facts">
                  {entry.field && <span class="tag">{entry.field}</span>}
                  {entry.ects != null && <span>{entry.ects} EAP</span>}
                  {entry.priceText && <span>{entry.priceText}</span>}
                  {entry.format && <span>{entry.format}</span>}
                </p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      {outcomes.length > 0 && (
        <section class="ice">
          <div class="section-inner">
            <div class="section-head compact-head">
              <span class="kicker">Õpiväljundid</span>
              <h2>Mida sa „{labelLower}" õppes selgeks saad</h2>
              <p>Konkreetsed õpiväljundid selle teema programmidest. Otsi rohkem <a href={`/oskused/?q=${encodeURIComponent(labelLower)}`}>õpiväljundite seast</a>.</p>
            </div>
            <ul class="outcome-list">
              {outcomes.map((o) => (
                <li class="outcome-item">
                  <p class="outcome-text">{o.text}</p>
                  <p class="outcome-progs"><a href={`/kataloog/${o.slug}/`}>{o.name}</a></p>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )}

      <section class="white">
        <div class="section-inner narrow">
          <div class="section-head compact-head">
            <span class="kicker">KKK</span>
            <h2>{topic.label} — korduvad küsimused</h2>
          </div>
          <div class="faq">
            {faq.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      {(related.length > 0 || topicFields.length > 0) && (
        <section class="ice">
          <div class="section-inner narrow">
            {related.length > 0 && (
              <>
                <div class="section-head compact-head"><span class="kicker">Seotud teemad</span><h2>Vaata ka</h2></div>
                <p class="chips">{related.map((r) => <a class="chip" href={`/teema/${r.slug}/`}>{r.label} <b>{r.entries.length}</b></a>)}</p>
              </>
            )}
            {topicFields.length > 0 && (
              <p class="chips">{topicFields.map((f) => <a class="chip chip-alt" href={`/valdkond/${f.slug}/`}>{f.field}</a>)}</p>
            )}
          </div>
        </section>
      )}

      <section class="ice" id="telli-teavitus">
        <div class="section-inner narrow">
          <div class="section-head compact-head">
            <span class="kicker">Püsi kursis</span>
            <h2>Anna teada, kui Eestis lisandub uusi mikrokvalifikatsioone</h2>
            <p>Jäta oma e-post — saadame kirja, kui registrisse lisandub uus mikrokvalifikatsioon või mikrokraadi õppekava. Ei rämpsposti, saad iga hetk loobuda.</p>
          </div>
          <form id="subscribe-form" class="subscribe-form" novalidate>
            <input type="hidden" name="topic" value="mikrokvalifikatsioon" />
            <input type="hidden" name="field" value={topic.slug} />
            <label class="sr-only" for="subscribe-email">E-post</label>
            <input id="subscribe-email" name="email" type="email" required autocomplete="email"
              placeholder="sinu@epost.ee" data-track-event="lead_form_start" data-track-label="topic_subscribe" />
            <button type="submit" class="btn btn-primary" data-track-event="lead_form_submit_attempt" data-track-label="topic_subscribe">Telli teavitus</button>
          </form>
          <p id="subscribe-msg" class="subscribe-msg" role="status" aria-live="polite"></p>
          <p class="subscribe-fine">Vastutav töötleja: Ettevõtluskeskus OÜ. Loe <a href="/privaatsus/">privaatsusteatist</a>.</p>
        </div>
      </section>

      <section class="navy">
        <div class="section-inner contact">
          <div>
            <span class="kicker">Järgmine samm</span>
            <h2>Kahtled, kas „{labelLower}" sobib sulle?</h2>
            <p>Tee 2 minuti suunatest või otsi õpiväljundi järgi — leia just sulle sobiv oskus ja kes selle kinni maksab.</p>
            <div class="inline-actions">
              <a class="btn btn-primary" href="/#suunatest" data-track-event="cta_click" data-track-label="topic_suunatest">Tee suunatest</a>
              <a class="btn btn-secondary" href={`/oskused/?q=${encodeURIComponent(labelLower)}`} data-track-event="cta_click" data-track-label="topic_oskused_bottom">Otsi õpiväljundi järgi</a>
            </div>
          </div>
          <aside class="contact-card">
            <h3>Kontakt</h3>
            <p>Ettevõtluskeskus OÜ</p>
            <p><a href="mailto:info@mikrokvalifikatsioon.ee" data-track-event="email_click" data-track-label="topic_email">info@mikrokvalifikatsioon.ee</a></p>
            <p><a href="tel:+37258180435" data-track-event="phone_click" data-track-label="topic_phone">+372 5818 0435</a></p>
          </aside>
        </div>
      </section>
    </main>

    <Footer label={`${topic.label} mikrokraadid`} />

    <style>
      .crumbs { font-size: 0.85rem; color: #5a6b80; margin-bottom: 12px; }
      .crumbs a { color: #5a6b80; }
      .crumbs span { color: #212121; }
      .syn { color: var(--muted); font-size: 0.92rem; margin-top: 4px; }
      .level-grid { display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
      .level-card { background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 18px 20px; }
      .level-num { margin: 0; font-size: 2rem; font-weight: 800; color: var(--teal); line-height: 1; }
      .level-lbl { margin: 4px 0 10px; font-weight: 700; color: #212121; }
      .level-links { margin: 0; display: grid; gap: 4px; font-size: 0.92rem; }
      .level-links a { color: var(--teal); font-weight: 700; }
      .faq { display: grid; gap: 8px; }
      .faq details { background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 4px 16px; }
      .faq summary { cursor: pointer; font-weight: 700; color: #212121; padding: 12px 0; list-style: none; }
      .faq summary::-webkit-details-marker { display: none; }
      .faq summary::before { content: "+ "; color: var(--teal); font-weight: 800; }
      .faq details[open] summary::before { content: "– "; }
      .faq details p { margin: 0 0 14px; color: #5f6569; }
      .block-title { margin: 0 0 16px; }
      .prog-grid { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
      .prog-card { background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 14px 16px; }
      .prog-name { color: var(--teal); font-weight: 700; }
      .prog-prov { margin: 4px 0 8px; color: var(--muted); font-size: 0.9rem; }
      .prog-facts { margin: 0; display: flex; flex-wrap: wrap; gap: 6px 10px; font-size: 0.85rem; color: #5f6569; }
      .prog-facts .tag { background: #eef4ee; color: #2f6b2c; border-radius: 999px; padding: 1px 9px; }
      .outcome-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
      .outcome-item { background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; }
      .outcome-text { margin: 0; font-weight: 600; color: #212121; }
      .outcome-progs { margin: 4px 0 0; font-size: 0.88rem; }
      .outcome-progs a { color: var(--teal); font-weight: 700; }
      .chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 8px 0 0; }
      .chip { background: #fff; border: 1px solid var(--line); border-radius: 999px; padding: 6px 13px; font-size: 0.9rem; color: #212121; }
      .chip b { color: var(--teal); }
      .chip-alt { background: #f3f6f3; }
      .subscribe-form { display: flex; flex-wrap: wrap; gap: 10px; margin: 4px 0 10px; }
      .subscribe-form input[type=email] { flex: 1 1 240px; min-width: 0; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; font-size: 1rem; }
      .subscribe-form button { flex: 0 0 auto; }
      .subscribe-msg { margin: 0; font-weight: 600; min-height: 1.2em; }
      .subscribe-msg.ok { color: #2f6b2c; }
      .subscribe-msg.err { color: #b3261e; }
      .subscribe-fine { margin: 8px 0 0; font-size: 0.82rem; color: var(--muted); }
      .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); border: 0; }
    </style>
    <script>
      const f = document.getElementById('subscribe-form') as HTMLFormElement | null;
      const msg = document.getElementById('subscribe-msg') as HTMLElement | null;
      if (f && msg) {
        f.addEventListener('submit', async (e) => {
          e.preventDefault();
          const data = new FormData(f);
          const email = String(data.get('email') || '').trim();
          const topic = String(data.get('topic') || '');
          const field = String(data.get('field') || '');
          if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { msg.className = 'subscribe-msg err'; msg.textContent = 'Palun sisesta korrektne e-post.'; return; }
          msg.className = 'subscribe-msg'; msg.textContent = 'Saadan…';
          let sent = false;
          try {
            const r = await fetch('/api/subscribe', {
              method: 'POST', headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ kind: 'topic_subscribe', email, topic, field, source_site: 'mikrokvalifikatsioon_ee' }),
            });
            if (r.ok) {
              sent = true;
            }
          } catch { sent = false; }

          if (!sent) {
            const body = encodeURIComponent("Teema: " + field + "\nE-mail: " + email);
            window.location.href = `mailto:info@mikrokvalifikatsioon.ee?subject=${encodeURIComponent("Teavitus mikrokvalifikatsioonidest: " + field)}&body=${body}`;
          }
          msg.className = sent ? 'subscribe-msg ok' : 'subscribe-msg';
          msg.textContent = sent
            ? 'Aitäh! Saatsime sulle kinnituskirja — palun kinnita tellimus.'
            : 'Avasime e-kirja varuvariandi — vajuta saatmiseks Saada.';
          f.reset();
          const dl = (window as unknown as { dataLayer?: unknown[] }).dataLayer;
          if (dl) dl.push({ event: 'lead_form_submit', form_name: 'topic_subscribe', field, delivery: sent ? 'webhook' : 'mailto' });
        });
      }
    </script>
  </body>
</html>
