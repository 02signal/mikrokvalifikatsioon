---
import Seo from "../../components/Seo.astro";
import CategoryMark from "../../components/CategoryMark.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/global.css";
import { catalog, fieldsWithSlug, catalogCheckedAt, catalogUpdatedAt } from "../../data/catalog";
import { parsePriceEur, toCourse } from "../../data/courseSchema";

export function getStaticPaths() {
  return fieldsWithSlug.map((f) => ({ params: { slug: f.slug }, props: { field: f.field } }));
}

const { field } = Astro.props as { field: string };
const entries = catalog.filter((e) => e.field === field);
const fieldCap = field.charAt(0).toUpperCase() + field.slice(1);
const checkedAtText = catalogCheckedAt.split("-").reverse().join(".");
const updatedAtText = catalogUpdatedAt.split("-").reverse().join(".");

const providersInField = [...new Set(entries.map((e) => e.provider))];
const prices = entries.map((e) => parsePriceEur(e.priceText)).filter((p): p is number => p != null && p > 0);
const minPrice = prices.length ? Math.min(...prices) : null;
const maxPrice = prices.length ? Math.max(...prices) : null;
const freeCount = entries.filter((e) => parsePriceEur(e.priceText) === 0).length;
const ectsVals = entries.map((e) => e.ects).filter((n): n is number => n != null);
const minEcts = ectsVals.length ? Math.min(...ectsVals) : null;
const maxEcts = ectsVals.length ? Math.max(...ectsVals) : null;

// Tasemejaotus: ülikooli mikrokraad (EAP, tasemeõppes arvestatav) vs
// koolitusettevõtte/rakenduskõrgkooli mikrokvalifikatsioon. Päris andmetest.
const degreeEntries = entries.filter((e) => e.providerType === "ülikool");
const qualEntries = entries.filter((e) => e.providerType !== "ülikool");
const degreeCount = degreeEntries.length;
const qualCount = qualEntries.length;
const ectsRangeText =
  minEcts != null && maxEcts != null
    ? minEcts === maxEcts
      ? `${minEcts} EAP`
      : `${minEcts}–${maxEcts} EAP`
    : null;
const priceRangeText =
  minPrice != null && maxPrice != null
    ? minPrice === maxPrice
      ? `${minPrice} €`
      : `${minPrice}–${maxPrice} €`
    : null;

const title = `${fieldCap} mikrokraadid ja mikrokvalifikatsioonid`;
const description = `${entries.length} ${field} mikrokraadi ja mikrokvalifikatsiooni ${providersInField.length} koolist${ectsRangeText ? `, maht ${ectsRangeText}` : ""}${priceRangeText ? `, hind ${priceRangeText}` : ""}. Võrdle mahtu (EAP), hinda ja õppevormi ühes tabelis ja leia parim valik.`;

const SITE = "https://mikrokvalifikatsioon.ee";
const fieldSlug = fieldsWithSlug.find((f) => f.field === field)?.slug ?? "";
const canonicalPath = `/valdkond/${fieldSlug}/`;
// Andmepõhine valdkonna profiil-joonis (üks SVG valdkonna kohta): SEO + GEO + OG.
const figBase = `/diagrams/valdkond/${fieldSlug}`;

// Extractable intent intro (1–2 lauset) — kuvatud lehel JA WebPage.description'is,
// et AI-assistendid ja otsing saaksid valdkonna kokkuvõtte kohe kätte.
const introText =
  `${fieldCap} valdkonnas on ${entries.length} mikrokraadi ja mikrokvalifikatsiooni ${providersInField.length} koolist` +
  `${degreeCount > 0 && qualCount > 0 ? ` — ${degreeCount} ülikooli mikrokraadi (EAP, tasemeõppes arvestatav) ja ${qualCount} koolitusettevõtte mikrokvalifikatsiooni` : ""}` +
  `${ectsRangeText ? `. Maht ${ectsRangeText}` : ""}${priceRangeText ? `, hind ${priceRangeText}` : ""}.`;

// KKK — ainult päris vastustega. Tühje/sisutühje küsimusi me ei emiteeri.
const faq: { q: string; a: string }[] = [
  {
    q: `Millised ${field} mikrokraadid ja mikrokvalifikatsioonid on?`,
    a: `Registris on ${entries.length} ${field} programmi ${providersInField.length} koolist: ${providersInField.slice(0, 6).join(", ")}${providersInField.length > 6 ? " jt" : ""}. Kõik on allpool tabelis koos mahu, hinna ja õppevormiga.`
  }
];
if (priceRangeText) {
  faq.push({
    q: `Kui palju ${field} mikrokraad maksab?`,
    a: `Selle valdkonna programmid maksavad ${priceRangeText}${freeCount > 0 ? `, neist ${freeCount} on mõnele sihtrühmale rahastatud` : ""}. Täpne hind on iga programmi juures ja kooli lehel. Kes kulu katab, vaata lehelt „Kes maksab?“.`
  });
}
if (degreeCount > 0 && qualCount > 0) {
  faq.push({
    q: `Mikrokraad või mikrokvalifikatsioon — mille ${field} valdkonnas valida?`,
    a: `Selles valdkonnas on ${degreeCount} ülikooli mikrokraadi (annavad EAP-sid, mida saab sageli hiljem tasemeõppes arvestada) ja ${qualCount} koolitusettevõtte või rakenduskõrgkooli mikrokvalifikatsiooni (kiirem praktiline oskus). Vali eesmärgi järgi: ainepunktid ja kõrgharidustase vs kohe rakendatav oskus.`
  });
}

const wantedSchema: Record<string, unknown>[] = [
  {
    "@type": "Organization",
    "@id": `${SITE}/#organization`,
    name: "Mikrokvalifikatsioon.ee",
    legalName: "Ettevõtluskeskus OÜ",
    url: `${SITE}/`
  },
  {
    "@type": "WebPage",
    "@id": `${SITE}${canonicalPath}#webpage`,
    url: `${SITE}${canonicalPath}`,
    name: title,
    description: introText,
    inLanguage: "et",
    isPartOf: { "@id": `${SITE}/#organization` },
    primaryImageOfPage: { "@id": `${SITE}${canonicalPath}#figure` }
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Avaleht", item: `${SITE}/` },
      { "@type": "ListItem", position: 2, name: "Kataloog", item: `${SITE}/kataloog/` },
      { "@type": "ListItem", position: 3, name: fieldCap, item: `${SITE}${canonicalPath}` }
    ]
  },
  {
    "@type": "ItemList",
    name: `${fieldCap} mikrokvalifikatsioonid ja mikrokraadid`,
    numberOfItems: entries.length,
    itemListElement: entries.map((entry, index) => ({
      "@type": "ListItem",
      position: index + 1,
      item: toCourse(entry)
    }))
  }
];
// FAQPage emiteeritakse ainult kui sisulisi vastuseid on (vähemalt 2) — väldib õhukest märgistust.
if (faq.length >= 2) {
  wantedSchema.push({
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } }))
  });
}

wantedSchema.push({
  "@type": "ImageObject",
  "@id": `${SITE}${canonicalPath}#figure`,
  url: `${SITE}${figBase}.png`,
  contentUrl: `${SITE}${figBase}.png`,
  caption: `${fieldCap}: ${entries.length} mikrokraadi ja mikrokvalifikatsiooni ${providersInField.length} koolist${ectsRangeText ? `, maht ${ectsRangeText}` : ""}${priceRangeText ? `, hind ${priceRangeText}` : ""}.`,
  description: `${fieldCap} valdkonna profiil: programmide arv, EAP-maht ja hinnavahemik registri andmetel.`,
  width: 1280,
  height: 720,
  encodingFormat: "image/png",
  inLanguage: "et",
  isPartOf: { "@id": `${SITE}${canonicalPath}#webpage` },
  creator: { "@id": `${SITE}/#organization` },
  creditText: "Mikrokvalifikatsioon.ee",
  copyrightNotice: "© Ettevõtluskeskus OÜ",
  acquireLicensePage: `${SITE}/andmed/`,
  license: "https://creativecommons.org/licenses/by/4.0/"
});
const schema = { "@context": "https://schema.org", "@graph": wantedSchema };
---

<!doctype html>
<html lang="et">
  <head>
    <Seo
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      ogTitle={`${fieldCap} mikrokraadid ja mikrokvalifikatsioonid`}
      ogDescription={`Võrdle ${entries.length} programmi ${providersInField.length} koolist: maht, hind ja õppevorm ühes kohas.`}
      ogImage={`${figBase}.og.png`}
      jsonLd={schema}
    />
  </head>
  <body>
    <Nav />

    <main class="report-page simple-report">
      <section class="report-hero simple-report-hero">
        <div class="section-inner">
          <nav class="crumbs" aria-label="Asukoht">
            <a href="/">Avaleht</a> › <a href="/kataloog/">Kataloog</a> › <span>{fieldCap}</span>
          </nav>
          <CategoryMark kind="field" />
          <span class="eyebrow">Valdkonna võrdlus</span>
          <h1>{fieldCap} mikrokraadid ja mikrokvalifikatsioonid</h1>
          <p>{introText} Võrdle kõiki allolevas tabelis.</p>
          <p class="report-date">Andmestik uuendatud: {updatedAtText}. Avalikud allikafaktid kontrollitud: {checkedAtText}</p>
        </div>
      </section>

      <section class="white">
        <div class="section-inner">
          <figure style="margin:0 auto 22px;max-width:520px;">
            <picture>
              <source srcset={`${figBase}.svg`} type="image/svg+xml" />
              <img src={`${figBase}.png`} alt={`Joonis: ${fieldCap} valdkonna profiil — ${entries.length} programmi ${providersInField.length} koolist${ectsRangeText ? `, maht ${ectsRangeText}` : ""}${priceRangeText ? `, hind ${priceRangeText}` : ""}.`} width="640" height="360" loading="lazy" decoding="async" style="display:block;width:100%;height:auto;border:1px solid var(--line);border-radius:12px;" />
            </picture>
          </figure>
          <div class="compare-wrap">
            <table class="field-table">
              <thead>
                <tr><th>Programm</th><th>Kool</th><th>Maht</th><th>Hind</th><th>Õppevorm</th><th>Vastuvõtt</th><th>Vali</th></tr>
              </thead>
              <tbody>
                {entries.map((entry) => (
                  <tr>
                    <td><a href={`/kataloog/${entry.slug}/`} data-track-event="cta_click" data-track-label="field_to_detail">{entry.name}</a></td>
                    <td>{entry.provider}</td>
                    <td>{entry.ects != null ? `${entry.ects} EAP` : "—"}</td>
                    <td>{entry.priceText || "kooli lehel"}</td>
                    <td>{entry.format || "—"}</td>
                    <td>{entry.intakeText || "—"}</td>
                    <td class="row-actions">
                      <button type="button" class="row-interest" data-interest-btn data-slug={entry.slug} data-field={entry.field} data-provider={entry.provider} title="Mind huvitab" aria-label={`Mind huvitab: ${entry.name}`}>♥</button>
                      <label class="compare-pick">
                        <input type="checkbox" data-compare-pick data-url={entry.url} />
                        <span>Võrdle</span>
                      </label>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="field-help">
            Iga programmi nimi viib selle lehele, kus on eesmärk, õpiväljundid, hindamine ja link kooli ametlikule lehele.
          </p>
        </div>
      </section>

      {(degreeCount > 0 || qualCount > 0) && (
        <section class="ice">
          <div class="section-inner narrow">
            <div class="section-head compact-head">
              <span class="kicker">Tasemejaotus</span>
              <h2>{degreeCount} mikrokraadi ja {qualCount} mikrokvalifikatsiooni</h2>
              <p>
                „Mikrokvalifikatsioon" on katusmõiste igale lühikesele tunnustatud õppele; „mikrokraad" on
                selle ülikooli versioon, mis annab EAP-sid, mida saab sageli hiljem tasemeõppes arvestada.
                Valdkonnas „{field}" jagunevad programmid nii:
              </p>
            </div>
            <div class="level-grid">
              {degreeCount > 0 && (
                <div class="level-card">
                  <p class="level-num">{degreeCount}</p>
                  <p class="level-lbl">ülikooli mikrokraadi</p>
                  <p class="level-desc">Annavad EAP-sid, sageli tasemeõppes arvestatavad. Kõrgharidustasemel õpe.</p>
                  <p class="level-links">
                    <a href="/mikrokraadi-valimine/" data-track-event="cta_click" data-track-label="field_to_degree_valimine">Kuidas mikrokraadi valida →</a>
                    <a href="/mikrokraadide-vordlus/" data-track-event="cta_click" data-track-label="field_to_degree_vordlus">Mikrokraadide võrdlus →</a>
                  </p>
                </div>
              )}
              {qualCount > 0 && (
                <div class="level-card">
                  <p class="level-num">{qualCount}</p>
                  <p class="level-lbl">mikrokvalifikatsiooni</p>
                  <p class="level-desc">Koolitusettevõtete ja rakenduskõrgkoolide lühiõpe — kiire praktiline oskus.</p>
                  <p class="level-links">
                    <a href="/mikrokvalifikatsiooni-valimine/" data-track-event="cta_click" data-track-label="field_to_qual_valimine">Kuidas mikrokvalifikatsiooni valida →</a>
                    <a href="/mikrokvalifikatsioonide-vordlus/" data-track-event="cta_click" data-track-label="field_to_qual_vordlus">Mikrokvalifikatsioonide võrdlus →</a>
                  </p>
                </div>
              )}
            </div>
          </div>
        </section>
      )}

      <section class="white">
        <div class="section-inner narrow">
          <div class="section-head compact-head">
            <span class="kicker">Kuidas valida</span>
            <h2>Mille järgi {field} programme võrrelda?</h2>
          </div>
          <ul class="check">
            <li><strong>Maht ja kestus</strong> — kui palju aega sul on (EAP ja semestrid).</li>
            <li><strong>Hind ja rahastus</strong> — vaata <a href="/kes-maksab/">kes maksab</a>: tööandja, Töötukassa või ise.</li>
            <li><strong>Õppevorm</strong> — kas saad õppida veebis töö kõrvalt või käia kohapeal.</li>
            <li><strong>Eeldused ja õpiväljundid</strong> — mida pead oskama enne ja mida oskad pärast (programmi lehel).</li>
          </ul>
          <div class="inline-actions">
            <a class="btn btn-primary" href="/#suunatest" data-track-event="cta_click" data-track-label="field_suunatest">Tee 2 minuti suunatest</a>
            <a class="btn btn-secondary" href="/kataloog/" data-track-event="cta_click" data-track-label="field_kataloog">Ava kogu kataloog</a>
          </div>
          <p class="field-help">
            Otsid kindlat oskust? <a href="/teema/" data-track-event="cta_click" data-track-label="field_to_teema">Sirvi teemade kaupa</a> või
            <a href="/oskused/" data-track-event="cta_click" data-track-label="field_to_oskused"> otsi õpiväljundi (mida pärast oskad) järgi</a>.
          </p>
        </div>
      </section>

      {faq.length >= 2 && (
        <section class="ice">
          <div class="section-inner narrow">
            <div class="section-head compact-head">
              <span class="kicker">KKK</span>
              <h2>{fieldCap} mikrokraadid — korduvad küsimused</h2>
            </div>
            <div class="faq">
              {faq.map((f) => (
                <details>
                  <summary>{f.q}</summary>
                  <p>{f.a}</p>
                </details>
              ))}
            </div>
          </div>
        </section>
      )}

      <section class="ice">
        <div class="section-inner narrow">
          <div class="section-head compact-head">
            <span class="kicker">Seotud vaated</span>
            <h2>Vaata {field} valdkonda ka teise nurga alt</h2>
          </div>
          <p class="related-views">
            <a href="/ametiruhm/" data-track-event="cta_click" data-track-label="field_to_ametiruhm">Ametirühmad ja tööturu nõudlus →</a>
            <a href="/maakond/" data-track-event="cta_click" data-track-label="field_to_maakond">Õpe maakonna järgi →</a>
            <a href="/kataloog/" data-track-event="cta_click" data-track-label="field_to_kataloog_related">Kogu kataloog →</a>
          </p>
        </div>
      </section>

      <section class="white">
        <div class="section-inner narrow">
          <div class="section-head compact-head">
            <span class="kicker">Püsi kursis</span>
            <h2>Anna teada, kui {field} lisandub uusi programme.</h2>
            <p>Valdkond areneb ja vastuvõtud muutuvad. Jäta e-mail, siis teavitame, kui siia lisandub uusi mikrokvalifikatsioone või avaneb uus vastuvõtt.</p>
          </div>
          <form class="lead-form" data-field-form data-field={field} data-webhook-url={import.meta.env.PUBLIC_SITE_LEAD_WEBHOOK_URL || ""}>
            <div class="form-grid">
              <div class="field">
                <label for="fieldEmail">E-mail *</label>
                <input id="fieldEmail" name="email" type="email" required autocomplete="email" placeholder="sinu@email.ee" />
              </div>
            </div>
            <button class="btn btn-primary" type="submit">Teavita {field} uudistest</button>
            <p class="form-note" data-field-note>Saadame ainult sisulisi teavitusi selle valdkonna kohta. Kui automaatne saatmine ei tööta, avaneb e-kirja varuvariant.</p>
          </form>
        </div>
      </section>

      <section class="navy">
        <div class="section-inner contact">
          <div>
            <span class="kicker">Järgmine samm</span>
            <h2>Kahtled valikus? Tee suunatest või küsi nõu.</h2>
            <div class="inline-actions">
              <a class="btn btn-primary" href="/#suunatest" data-track-event="cta_click" data-track-label="field_bottom_suunatest">Tee suunatest</a>
              <a class="btn btn-secondary" href="mailto:info@mikrokvalifikatsioon.ee" data-track-event="email_click" data-track-label="field_email">Küsi nõu</a>
            </div>
          </div>
          <aside class="contact-card">
            <h3>Kontakt</h3>
            <p>Ettevõtluskeskus OÜ</p>
            <p><a href="mailto:info@mikrokvalifikatsioon.ee" data-track-event="email_click" data-track-label="field_contact_email">info@mikrokvalifikatsioon.ee</a></p>
            <p><a href="tel:+37258180435" data-track-event="phone_click" data-track-label="field_phone">+372 5818 0435</a></p>
          </aside>
        </div>
      </section>
    </main>

    <Footer label={`${fieldCap} mikrokraadid`} />

    <div class="compare-bar" data-compare-bar hidden>
      <span data-compare-count>0 valitud</span>
      <a class="btn btn-primary" href="/vordlus/" data-compare-go data-track-event="cta_click" data-track-label="field_compare_go">Võrdle valituid</a>
      <button type="button" class="btn btn-secondary" data-compare-clear>Tühjenda</button>
    </div>

    <style>
      .crumbs { font-size: 0.85rem; color: #5a6b80; margin-bottom: 12px; }
      .crumbs a { color: #5a6b80; }
      .crumbs span { color: #212121; }
      .related-views { display: flex; flex-wrap: wrap; gap: 8px 18px; margin: 0; }
      .related-views a { color: var(--teal); font-weight: 700; }
      .level-grid { display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
      .level-card { background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 18px 20px; }
      .level-num { margin: 0; font-size: 2rem; font-weight: 800; color: var(--teal); line-height: 1; }
      .level-lbl { margin: 4px 0 8px; font-weight: 700; color: #212121; }
      .level-desc { margin: 0 0 12px; color: #5f6569; font-size: 0.92rem; }
      .level-links { margin: 0; display: grid; gap: 4px; font-size: 0.92rem; }
      .level-links a { color: var(--teal); font-weight: 700; }
      .faq { display: grid; gap: 8px; }
      .faq details { background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 4px 16px; }
      .faq summary { cursor: pointer; font-weight: 700; color: #212121; padding: 12px 0; list-style: none; }
      .faq summary::-webkit-details-marker { display: none; }
      .faq summary::before { content: "+ "; color: var(--teal); font-weight: 800; }
      .faq details[open] summary::before { content: "– "; }
      .faq details p { margin: 0 0 14px; color: #5f6569; }
      .compare-wrap { overflow-x: auto; }
      .field-table { width: 100%; border-collapse: collapse; background: #fff; border: 1px solid var(--line); border-radius: 10px; min-width: 720px; }
      .field-table th, .field-table td { border-bottom: 1px solid var(--line); padding: 12px 14px; text-align: left; vertical-align: top; font-size: 0.95rem; }
      .field-table thead th { background: #212121; color: #fff; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.02em; }
      .field-table tbody tr:last-child td { border-bottom: 0; }
      .field-table td a { color: var(--teal); font-weight: 700; }
      .row-actions { white-space: nowrap; }
      .row-interest { background: none; border: 0; color: #c9ccd2; font-size: 1.2rem; cursor: pointer; padding: 0 8px 0 0; line-height: 1; }
      .row-interest.is-marked { color: #54c247; }
      .compare-pick { display: inline-flex; gap: 5px; align-items: center; font-size: 0.85rem; color: #5f6569; cursor: pointer; }
      .compare-pick input { width: 16px; height: 16px; min-height: 0; accent-color: #54c247; }
      .compare-bar { position: fixed; bottom: 16px; left: 50%; transform: translateX(-50%); z-index: 50; display: flex; gap: 12px; align-items: center; padding: 10px 16px; background: #212121; color: #fff; border-radius: 12px; box-shadow: 0 18px 46px rgba(33, 33, 33, 0.3); }
      .compare-bar[hidden] { display: none; }
      .compare-bar .btn { width: auto; padding: 9px 14px; font-size: 0.9rem; }
    </style>

    <script>
      const form = document.querySelector("[data-field-form]") as HTMLFormElement | null;
      const note = document.querySelector("[data-field-note]");
      const track = (n: string, p: Record<string, unknown>) => (window as any).digiteekaartTrack?.(n, p);
      if (form) {
        const field = form.getAttribute("data-field") || "";
        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          if (!form.reportValidity()) return;
          const email = String(new FormData(form).get("email") || "");
          track("field_subscribe", { field });
          // AMOS ratifitseeritud sissevool (topic_subscribe); valdkond läheb `field`-i.
          let sent = false;
          try {
            const r = await fetch("/api/subscribe", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ kind: "topic_subscribe", topic: "mikrokvalifikatsioon", email, field, source_site: "mikrokvalifikatsioon_ee" }) });
            sent = r.ok;
          } catch { sent = false; }
          if (!sent) {
            const body = encodeURIComponent("Valdkond: " + field + "\nE-mail: " + email);
            window.location.href = `mailto:info@mikrokvalifikatsioon.ee?subject=${encodeURIComponent("Teavitus valdkonnast: " + field)}&body=${body}`;
          }
          track("lead_form_submit", { form_name: "field_subscribe", field, delivery: sent ? "amos" : "mailto" });
          if (note) note.textContent = sent ? "Aitäh! Teavitame sind selle valdkonna uudistest." : "Avasime e-kirja varuvariandi — vajuta saatmiseks Saada.";
          form.reset();
        });
      }

      // Võrdluse valik — sama sessionStorage kui kataloogis (valik püsib ka üle valdkondade).
      const compareKey = "mkval:compare";
      const compareBar = document.querySelector("[data-compare-bar]") as HTMLElement | null;
      const compareCount = document.querySelector("[data-compare-count]");
      const compareGo = document.querySelector("[data-compare-go]") as HTMLAnchorElement | null;
      const picks = [...document.querySelectorAll<HTMLInputElement>("[data-compare-pick]")];
      const readPicks = (): string[] => { try { return JSON.parse(sessionStorage.getItem(compareKey) || "[]"); } catch { return []; } };
      const writePicks = (urls: string[]): void => { try { sessionStorage.setItem(compareKey, JSON.stringify(urls)); } catch { /* valik elab lehe piires */ } };
      const syncCompareUi = (): void => {
        const urls = readPicks();
        picks.forEach((box) => { box.checked = urls.includes(box.dataset.url || ""); });
        if (compareBar) compareBar.hidden = urls.length < 2;
        if (compareCount) compareCount.textContent = `${urls.length} valitud`;
        if (compareGo) compareGo.href = `/vordlus/?p=${urls.map(encodeURIComponent).join("|")}`;
      };
      picks.forEach((box) => {
        box.addEventListener("change", () => {
          let urls = readPicks();
          const url = box.dataset.url || "";
          if (box.checked) { if (urls.length >= 3) { box.checked = false; return; } if (!urls.includes(url)) urls.push(url); }
          else { urls = urls.filter((u) => u !== url); }
          writePicks(urls); syncCompareUi();
        });
      });
      document.querySelector("[data-compare-clear]")?.addEventListener("click", () => { writePicks([]); syncCompareUi(); });
      syncCompareUi();

      // Huvi: per-rida "Mind huvitab" → interest_signal + localStorage (jagatud detaillehega).
      const interestKey = (slug: string) => "mkval:interest:" + slug;
      [...document.querySelectorAll<HTMLButtonElement>("[data-interest-btn]")].forEach((b) => {
        const slug = b.getAttribute("data-slug") || "";
        try { if (localStorage.getItem(interestKey(slug)) === "1") b.classList.add("is-marked"); } catch { /* ignore */ }
        b.addEventListener("click", () => {
          track("interest_signal", { programme_slug: slug, field: b.getAttribute("data-field") || "", provider: b.getAttribute("data-provider") || "" });
          try { localStorage.setItem(interestKey(slug), "1"); } catch { /* ignore */ }
          b.classList.add("is-marked");
        });
      });
    </script>
  </body>
</html>
