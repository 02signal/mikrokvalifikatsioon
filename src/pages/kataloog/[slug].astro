---
import Seo from "../../components/Seo.astro";
import CategoryMark from "../../components/CategoryMark.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/global.css";
import Nav from "../../components/Nav.astro";
import { catalog, providersWithSlug, type CatalogEntryWithSlug } from "../../data/catalog";
import { toCourse, outboundUrl } from "../../data/courseSchema";
import { plausiblePriceEur } from "../../data/priceGuard";
import { credentialCommonsNodeFor, CC_CONTEXT } from "../../data/credentialCommons";
import { comparisonsFor } from "../../data/comparisons";
import { ehisAttribution } from "../../data/ehisFacts";
import { intakeDatesFor, intakeDatesFetchedAt } from "../../data/intakeDates";
import { formatEt } from "../../data/dates";
import { fundingInfoFor, hasFundingInfo } from "../../data/funding";
import { entryOutcomeObjects, languageLabel } from "../../data/outcomes";

export function getStaticPaths() {
  return catalog.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CatalogEntryWithSlug };
const providerSlug = providersWithSlug.find((p) => p.provider === entry.provider)?.slug;
const relatedComparisons = comparisonsFor(entry.slug).slice(0, 4);

// Ametlik allikas: EHIS (avaandmed). Omaniku otsus 2026-06-24 (täpsustatud) —
// sobitatud kirjel on EHIS FAKTIDE autoriteetne allikas: name/EAP/keel on juba
// EHIS-ist üle kirjutatud kataloogi tasemel (vt src/data/catalog/index.ts).
// Kirjeldav kiht kuvatakse KAHEKORDSELT: EHIS ametlikud õpiväljundid JA kooli
// enda kirjeldus — kumbki ei kao. Kureeritud `field` jääb navigatsioonis
// kehtima; EHIS-i õppekavarühm kuvatakse ametliku lisaklassina.
const ehis = entry.ehis;
const isOfficial = ehis.authoritative;

const displayEcts = entry.ects ?? null;
const ehisNameEn = ehis.nameEn;
const ehisFieldName = ehis.fieldName;

// PDF-link ainult kehtiva http(s) URL-i korral (juba normaliseeritud allikas).
const ehisPdfUrl = ehis.officialPdfUrl;

// Kahekordne õpiväljundite/kirjelduse vaade:
//  - ehisOutcomes  = EHIS ametlikud õpiväljundid (avaandmed, viitega EHIS/HTM);
//  - schoolOutcomes = kooli ENDA õpiväljundid (originaal, säilitatud).
// Sobimata (none) kirjel ehisOutcomes puudub ja kuvame ainult kooli oma.
const ehisOutcomes = ehis.ehisOutcomes && ehis.ehisOutcomes.length > 0 ? ehis.ehisOutcomes : null;
const schoolOutcomeObjects = entryOutcomeObjects(entry);
const schoolOutcomes = schoolOutcomeObjects.length > 0 ? schoolOutcomeObjects : null;
// Kas kuvada eraldiseisev "Kooli enda kirjeldus" plokk: kui on kas kooli
// õpiväljundid VÕI eesmärk (summary on alati hero-osas eraldi).
const hasSchoolDescription = !!(schoolOutcomes || entry.goalText);

const canonicalPath = `/kataloog/${entry.slug}/`;
const checkedAtText = entry.sourceCheckedAt.split("-").reverse().join(".");
const providerLink = outboundUrl(entry, "programmileht");
const languageText = entry.language === "en" ? "inglise" : entry.language === "et" ? "eesti" : null;

// Robotitõkkega koolid: nende lehti me ToS-i tõttu automaatselt ei kogu, seega
// ajakohane hind/vastuvõtt/kirjeldus ei pruugi siin olla värske — saadame
// kasutaja selge märkega kooli enda lehele (uues aknas). EHIS ametlikud faktid
// (nimi/EAP/õppekavarühm/õpiväljundid) jäävad alles.
const robotsBlockedProviders = new Set(["Eesti Ettevõtluskõrgkool Mainor", "Tallinna Ülikool"]);
const isRobotsBlocked = robotsBlockedProviders.has(entry.provider);

// Värsked vastuvõtu/registreerimise kuupäevad — kogutud kooli ENDA programmilehelt
// (AMOS robots/ToS-järgiv allika-värskendus). Kuvame ainult AVALIKKE fakte: kuupäev +
// lühike silt. Robotitõkkega koolidel värsket kuupäeva pole → senine kataloog jääb.
const fresh = !isRobotsBlocked ? intakeDatesFor(entry.url) : null;
const freshDeadline = fresh?.registration_deadline ?? null;
const freshStart = fresh?.start_date ?? null;
const hasFreshDates = !!(freshDeadline || freshStart);
// "kontrollitud" = millal kuupäevad kooli lehelt korjati (ISO-instant → DD.MM.YYYY).
const freshCheckedAt = hasFreshDates ? formatEt(intakeDatesFetchedAt.slice(0, 10)) : null;
// Kui registreerimise tähtaeg on `fetched_at` suhtes juba möödas, kuvame neutraalselt
// ("Viimane teadaolev vastuvõtt …"), mitte avatuna.
const fetchedDay = intakeDatesFetchedAt.slice(0, 10);
const deadlinePast = !!(freshDeadline && freshDeadline < fetchedDay);

const facts = [
  displayEcts != null ? { label: "Maht", value: `${displayEcts} EAP` } : null,
  entry.priceText ? { label: "Hind", value: entry.priceText } : null,
  entry.durationText ? { label: "Kestus", value: entry.durationText } : null,
  entry.format ? { label: "Õppevorm", value: entry.format } : null,
  languageText ? { label: "Keel", value: languageText } : null,
  entry.intakeText ? { label: "Vastuvõtt", value: entry.intakeText } : null,
  ehisNameEn ? { label: "Nimi (EN)", value: ehisNameEn } : null,
  ehisFieldName ? { label: "Ametlik õppekavarühm (EHIS)", value: ehisFieldName } : null
].filter((fact): fact is { label: string; value: string } => fact !== null);

// Rahastus ja sihtrühm — KOOLI faktiline pakkumine, struktureeritud + atribueeritud.
// Omaniku otsus 2026-06-25: meie enda keeles ei kasuta "tasuta", AGA kooli enda
// "sihtrühmale tasuta" tüüpi pakkumine kuvatakse siin lubatud kontekstis — koos
// sihtrühma ja rahastuse selgitusega — sest kasutaja peab teadma, kas TEMA
// kvalifitseerub rahastusele. Rahastus/tingimused võivad muutuda → kinnita kooli lehel.
const funding = fundingInfoFor(entry);
const showFunding = hasFundingInfo(funding);

// <meta name="description"> is a CLAIM in Google's results (same class as the
// OG card / JSON-LD), so it uses the guarded price — unlike the <dl> below,
// which mirrors the register verbatim and keeps entry.priceText untouched.
const metaTailPriceIsPlausible = plausiblePriceEur(entry) != null;
const metaTail = [
  entry.ects != null ? `${entry.ects} EAP` : null,
  metaTailPriceIsPlausible ? entry.priceText : null,
  entry.format,
  entry.provider
].filter(Boolean).join(" · ");
// Alusta kirjeldust õppekava NIMEGA. `summary` on sama kogu programmirühma peale
// ("Õpetajate akadeemia … programmid") ja metaTail on õdedel-vendadel samuti sama,
// nii et ilma nimeta said kümme eri lehte identse kirjelduse. Nimi on ainus osa,
// mis neid eristab — ja kirjeldus peakski ütlema, MIS sellel lehel on.
const descLead = entry.summary.startsWith(entry.name) ? entry.summary : `${entry.name} — ${entry.summary}`;
const description = `${descLead} ${metaTail}.`.replace(/\s+/g, " ").trim().slice(0, 300);
// Hoia pealkiri alla 70 tähemärgi: nimi + pakkuja kui mahub, muidu ainult nimi;
// väga pikk nimi lõigatakse sõnapiiril + „…".
const fullTitle = `${entry.name} – ${entry.provider}`;
let title = fullTitle.length <= 68 ? fullTitle : entry.name;
if (title.length > 70) title = title.slice(0, 66).replace(/\s+\S*$/, "") + "…";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Avaleht", item: "https://mikrokvalifikatsioon.ee/" },
        { "@type": "ListItem", position: 2, name: "Kataloog", item: "https://mikrokvalifikatsioon.ee/kataloog/" },
        { "@type": "ListItem", position: 3, name: entry.name, item: `https://mikrokvalifikatsioon.ee${canonicalPath}` }
      ]
    },
    toCourse(entry)
  ]
};

// Credential Commons cc:MicroCredential — the STRUCTURE/interop layer for this
// programme (parallel to the schema.org Course above, which feeds Google). A
// separate block because it uses the Credential Commons @context.
const ccNode = credentialCommonsNodeFor(entry);
const ccCredential = ccNode ? { "@context": CC_CONTEXT, ...ccNode } : null;
---

<!doctype html>
<html lang="et">
  <head>
    <Seo
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      ogTitle={`${entry.name} — ${entry.provider}`}
      ogDescription={entry.summary}
      jsonLd={schema}
    />
    {ccCredential && <script type="application/ld+json" is:inline set:html={JSON.stringify(ccCredential)} />}
    {ccCredential && <link rel="alternate" type="application/ld+json" href={`${canonicalPath}credential.jsonld`} title="Credential Commons" />}
  </head>
  <body>
    <Nav />

    <main class="report-page simple-report">
      <section class="report-hero simple-report-hero">
        <div class="section-inner">
          <nav class="crumbs" aria-label="Asukoht">
            <a href="/">Avaleht</a> › <a href="/kataloog/">Kataloog</a> › <span>{entry.name}</span>
          </nav>
          <CategoryMark kind="programme" />
          <span class="eyebrow">{entry.field}</span>
          <h1>{entry.name}</h1>
          <p class="detail-provider">{entry.provider}</p>
          <p>{entry.summary}</p>
          <div class="actions">
            <a class="btn btn-primary" href={providerLink} target="_blank" rel="noreferrer" data-track-event="partner_site_click" data-track-label={`detail_${entry.provider}`}>Vaata ja registreeru kooli lehel</a>
            <a class="btn btn-secondary" href="/kataloog/" data-track-event="cta_click" data-track-label="detail_back_catalog">← Tagasi kataloogi</a>
          </div>

          <div class="interest" data-interest data-slug={entry.slug} data-field={entry.field} data-provider={entry.provider}>
            <button type="button" class="btn btn-interest" data-interest-btn>♥ Mind huvitab see programm</button>
            <form class="interest-form" data-interest-form data-webhook-url={import.meta.env.PUBLIC_SITE_LEAD_WEBHOOK_URL || ""} hidden>
              <p data-interest-msg><strong>Aitäh, huvi märgitud!</strong> Anna e-mail, siis teavitame, kui avaneb uus vastuvõtt või lisandub sarnane programm.</p>
              <div class="interest-row">
                <input type="email" name="email" placeholder="sinu@email.ee" autocomplete="email" aria-label="E-mail" required />
                <button type="submit" class="btn btn-primary">Teavita mind</button>
              </div>
            </form>
          </div>

          <p class="report-date">Andmed kontrollitud kooli lehelt: {checkedAtText}</p>
        </div>
      </section>

      <section class="white">
        <div class="section-inner narrow">
          {isRobotsBlocked && (
            <div class="notice notice-school-check">
              <p class="school-check-line">
                <a href={providerLink} target="_blank" rel="noreferrer" data-track-event="partner_site_click" data-track-label={`detail_school_check_${entry.provider}`}>Ajakohast hinda, vastuvõttu ja kirjeldust vaata kooli lehel ↗</a>
              </p>
              <p class="school-check-sub">Selle kooli ajakohast infot me automaatselt ei kogu — kindel info on kooli enda lehel. Allpool toodud ametlikud faktid (nimi, EAP, õppekavarühm, õpiväljundid) pärinevad EHIS-est.</p>
            </div>
          )}

          {facts.length > 0 && (
            <dl class="detail-facts">
              {facts.map((fact) => (
                <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>
              ))}
            </dl>
          )}

          {showFunding && (
            <div class="funding-box">
              <h2>Rahastus ja sihtrühm</h2>
              <dl class="funding-table">
                {funding.basePrice && (
                  <div><dt>Hind (üldine)</dt><dd>{funding.basePrice}</dd></div>
                )}
                <div>
                  <dt>Sihtrühmale rahastatud</dt>
                  <dd>
                    {funding.targetGroupFunded ? (
                      <>jah{funding.fundingSource && <> — {funding.fundingSource}</>}</>
                    ) : (
                      "ei"
                    )}
                  </dd>
                </div>
                {funding.eligibleGroup && (
                  <div><dt>Sihtrühm</dt><dd>{funding.eligibleGroup}</dd></div>
                )}
                {funding.schoolWording && (
                  <div class="funding-wording">
                    <dt>Kooli enda sõnastus</dt>
                    <dd>„{funding.schoolWording}"</dd>
                  </div>
                )}
              </dl>
              <p class="funding-note">
                Rahastus ja sihtrühm võivad muutuda — sõnastus on kooli enda info.
                <a href={providerLink} target="_blank" rel="noreferrer" data-track-event="partner_site_click" data-track-label={`detail_funding_check_${entry.provider}`}>kinnita kooli lehel ↗</a>
              </p>
            </div>
          )}

          {hasFreshDates && (
            <div class={`intake-fresh${deadlinePast ? " intake-fresh-past" : ""}`}>
              {deadlinePast ? (
                <p class="intake-fresh-line">
                  Viimane teadaolev vastuvõtt: <strong>{formatEt(freshDeadline as string)}</strong> —
                  <a href={providerLink} target="_blank" rel="noreferrer" data-track-event="partner_site_click" data-track-label={`detail_intake_school_${entry.provider}`}>vaata uut vastuvõttu kooli lehelt ↗</a>
                </p>
              ) : (
                <p class="intake-fresh-line">
                  {freshDeadline && <span class="intake-pill">Registreerimine kuni {formatEt(freshDeadline)}</span>}
                  {freshStart && <span class="intake-pill intake-pill-start">Algus: {formatEt(freshStart)}</span>}
                  <a class="intake-fresh-cta" href={providerLink} target="_blank" rel="noreferrer" data-track-event="partner_site_click" data-track-label={`detail_intake_school_${entry.provider}`}>Registreeru kooli lehel ↗</a>
                </p>
              )}
              <p class="intake-fresh-sub">Kuupäevad kontrollitud kooli enda lehelt {freshCheckedAt}.</p>
            </div>
          )}

          {isOfficial ? (
            <>
              {/* Ametlik EHIS õpiväljundite plokk (kuvatakse kõrvuti kooli omaga) */}
              {ehisOutcomes && ehisOutcomes.length > 0 && (
                <div class="detail-block detail-block-official">
                  <h2>Õpiväljundid (ametlik – EHIS)</h2>
                  <ul class="check">
                    {ehisOutcomes.map((outcome) => <li>{outcome}</li>)}
                  </ul>
                  <p class="src-credit">Ametlikud õpiväljundid pärinevad EHISe registreeritud õppekavast (avaandmed). {ehisAttribution}.</p>
                </div>
              )}

              {/* Kooli ENDA kirjeldus — säilitatud, ei kao ülekirjutuse tõttu */}
              {hasSchoolDescription && (
                <div class="detail-block detail-block-school">
                  <h2>Kooli enda kirjeldus</h2>
                  {entry.goalText && <p>{entry.goalText}</p>}
                  {schoolOutcomes && schoolOutcomes.length > 0 && (
                    <ul class="check">
                      {schoolOutcomes.map((outcome) => (
                        <li>
                          {outcome.text}
                          {outcome.textLanguage && outcome.textLanguage !== entry.language && (
                            <span class="outcome-lang"> tekst: {languageLabel(outcome.textLanguage)}</span>
                          )}
                        </li>
                      ))}
                    </ul>
                  )}
                  <p class="src-credit">
                    Kooli lehelt (<a href={providerLink} target="_blank" rel="noreferrer" data-track-event="partner_site_click" data-track-label={`detail_school_desc_${entry.provider}`}>{entry.provider}</a>), kontrollitud {checkedAtText}.
                  </p>
                </div>
              )}
            </>
          ) : (
            <>
              {entry.goalText && (
                <div class="detail-block">
                  <h2>Mille jaoks see programm on?</h2>
                  <p>{entry.goalText}</p>
                </div>
              )}

              {schoolOutcomes && schoolOutcomes.length > 0 && (
                <div class="detail-block">
                  <h2>Mida sa pärast oskad?</h2>
                  <ul class="check">
                    {schoolOutcomes.map((outcome) => (
                      <li>
                        {outcome.text}
                        {outcome.textLanguage && outcome.textLanguage !== entry.language && (
                          <span class="outcome-lang"> tekst: {languageLabel(outcome.textLanguage)}</span>
                        )}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </>
          )}

          {entry.assessmentText && (
            <div class="detail-block">
              <h2>Kuidas hinnatakse?</h2>
              <p>{entry.assessmentText}</p>
            </div>
          )}

          {isOfficial ? (
            <>
              <p class="notice notice-official">
                <strong>Ametlik allikas (faktid): EHIS — Haridus- ja Teadusministeerium.</strong>
                Programmi nimi, maht (EAP) ja õppekeel pärinevad otse Eesti Hariduse
                Infosüsteemi (EHIS) ametlikust õppekavast
                {ehis.ehisKood && <> koodiga <strong>{ehis.ehisKood}</strong></>}
                {ehisFieldName && <> (õppekavarühm: <strong>{ehisFieldName}</strong>)</>}.
                Ülal on toodud nii EHISe ametlikud õpiväljundid kui ka kooli enda kirjeldus.
                {ehisPdfUrl && (
                  <> Vaata <a href={ehisPdfUrl} target="_blank" rel="noreferrer" data-track-event="partner_site_click" data-track-label={`detail_ehis_pdf_${entry.provider}`}>ametlik õppekava (PDF)</a>.</>
                )}
                {" "}{ehisAttribution}.
              </p>
              <p class="notice">
                <strong>Hind ja registreerumine:</strong> hind, vastuvõtt ja tingimused on
                <a href={providerLink} target="_blank" rel="noreferrer" data-track-event="partner_site_click" data-track-label={`detail_source_${entry.provider}`}>{entry.provider} lehel</a>
                (kontrollitud {checkedAtText}).
                Märkasid viga? Kirjuta <a href={`mailto:info@mikrokvalifikatsioon.ee?subject=${encodeURIComponent("Kataloogi parandus: " + entry.name)}`} data-track-event="email_click" data-track-label="detail_correction">info@mikrokvalifikatsioon.ee</a>.
              </p>
            </>
          ) : (
            <p class="notice">
              <strong>Allikas:</strong> selle programmi õppekava info — eesmärk ja õpiväljundid — pärineb
              <a href={providerLink} target="_blank" rel="noreferrer" data-track-event="partner_site_click" data-track-label={`detail_source_${entry.provider}`}>{entry.provider} koolituslehelt</a>
              (kontrollitud {checkedAtText}). Ametlik ja lõplik info — hind, vastuvõtt ja tingimused — on samuti seal.
              Märkasid viga? Kirjuta <a href={`mailto:info@mikrokvalifikatsioon.ee?subject=${encodeURIComponent("Kataloogi parandus: " + entry.name)}`} data-track-event="email_click" data-track-label="detail_correction">info@mikrokvalifikatsioon.ee</a>.
            </p>
          )}
        </div>
      </section>

      {(providerSlug || relatedComparisons.length > 0) && (
        <section class="ice">
          <div class="section-inner narrow">
            <div class="section-head compact-head">
              <span class="kicker">Seotud</span>
              <h2>Võrdle ja vaata edasi</h2>
            </div>
            <p class="rel-chips">
              {providerSlug && <a class="chip" href={`/koolitaja/${providerSlug}/`} data-track-event="cta_click" data-track-label="detail_to_provider">Kõik {entry.provider} programmid →</a>}
              {relatedComparisons.map((c) => {
                const other = c.a.slug === entry.slug ? c.b : c.a;
                return <a class="chip chip-alt" href={`/vordlus/${c.pair}/`} data-track-event="cta_click" data-track-label="detail_to_comparison">vs {other.name} →</a>;
              })}
            </p>
          </div>
        </section>
      )}

      <section class="navy">
        <div class="section-inner contact">
          <div>
            <span class="kicker">Raha küsimus</span>
            <h2>Kes võiks selle õppe kinni maksta?</h2>
            <p>Sageli ei pea sa ise kogu hinda maksma — tööandja koolituseelarve, Töötukassa või ise koos lihtsa tasuvusarvutusega.</p>
            <div class="inline-actions">
              <a class="btn btn-primary" href="/kes-maksab/" data-track-event="cta_click" data-track-label="detail_kesmaksab">Vaata, kes maksab</a>
              <a class="btn btn-secondary" href="/#suunatest" data-track-event="cta_click" data-track-label="detail_suunatest">Tee suunatest</a>
            </div>
          </div>
          <aside class="contact-card">
            <h3>Kontakt</h3>
            <p>Ettevõtluskeskus OÜ</p>
            <p><a href="mailto:info@mikrokvalifikatsioon.ee" data-track-event="email_click" data-track-label="detail_email">info@mikrokvalifikatsioon.ee</a></p>
            <p><a href="tel:+37258180435" data-track-event="phone_click" data-track-label="detail_phone">+372 5818 0435</a></p>
          </aside>
        </div>
      </section>
    </main>

    <Footer label={entry.field} />

    <style>
      .rel-chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; }
      .chip { background: #fff; border: 1px solid var(--line); border-radius: 999px; padding: 6px 13px; font-size: 0.9rem; color: var(--teal); font-weight: 700; }
      .chip-alt { color: #212121; background: #f3f6f3; font-weight: 400; }
      .crumbs { font-size: 0.85rem; color: #5a6b80; margin-bottom: 12px; }
      .crumbs a { color: #5a6b80; }
      .crumbs span { color: #212121; }
      .detail-provider { font-weight: 700; color: #212121; margin-top: -4px; }
      .detail-facts {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 16px;
        margin: 0 0 28px;
        padding: 18px 20px;
        background: #fff;
        border: 1px solid #d9e3ea;
        border-radius: 12px;
      }
      .detail-facts div { min-width: 0; }
      .detail-facts dt { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.03em; color: #5a6b80; }
      .detail-facts dd { margin: 3px 0 0; font-weight: 700; color: #212121; overflow-wrap: anywhere; }
      .funding-box {
        margin: 0 0 28px;
        padding: 18px 20px;
        background: #fbfbf9;
        border: 1px solid #d9e3ea;
        border-left: 4px solid var(--teal);
        border-radius: 12px;
      }
      .funding-box h2 { font-size: 1.1rem; margin: 0 0 12px; }
      .funding-table { display: grid; gap: 12px; margin: 0; }
      .funding-table div { display: grid; grid-template-columns: minmax(140px, 0.5fr) 1fr; gap: 10px; align-items: baseline; }
      .funding-table dt { font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.03em; color: #5a6b80; margin: 0; }
      .funding-table dd { margin: 0; font-weight: 700; color: #212121; overflow-wrap: anywhere; }
      .funding-table .funding-wording dd { font-weight: 400; color: #3a4a5a; font-style: italic; }
      .funding-note { margin: 14px 0 0; font-size: 0.85rem; color: #5a6b80; }
      .funding-note a { color: var(--teal); font-weight: 700; margin-left: 6px; }
      @media (max-width: 520px) {
        .funding-table div { grid-template-columns: 1fr; gap: 2px; }
      }
      .detail-block { margin-bottom: 24px; }
      .detail-block h2 { font-size: 1.15rem; margin-bottom: 8px; }
      .detail-block-official, .detail-block-school { padding: 16px 18px; border-radius: 12px; border: 1px solid #d9e3ea; }
      .detail-block-official { background: #eef5f4; border-left: 4px solid var(--teal); }
      .detail-block-school { background: #fbfbf9; border-left: 4px solid #c9d2c9; }
      .outcome-lang { display: inline-block; margin-left: 6px; color: #5a6b80; font-size: 0.86rem; font-weight: 600; }
      .src-credit { margin: 10px 0 0; font-size: 0.82rem; color: #5a6b80; }
      .notice-official { border-left-color: var(--teal); background: #eef5f4; margin-bottom: 16px; }
      .notice-school-check { border-left-color: var(--teal); background: #eef5f4; margin: 0 0 24px; }
      .intake-fresh { margin: 0 0 28px; padding: 16px 18px; background: #eef5f4; border: 1px solid #cfe1de; border-left: 4px solid var(--teal); border-radius: 12px; }
      .intake-fresh-past { background: #f6f7f6; border-left-color: #c9d2c9; }
      .intake-fresh-line { margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
      .intake-pill { display: inline-block; background: #fff; border: 1px solid #cfe1de; border-radius: 999px; padding: 5px 13px; font-weight: 700; color: var(--teal); font-size: 0.95rem; }
      .intake-pill-start { color: #212121; background: #fbfbf9; border-color: #d9e3ea; }
      .intake-fresh-cta { font-weight: 700; color: var(--teal); }
      .intake-fresh-sub { margin: 8px 0 0; font-size: 0.82rem; color: #5a6b80; }
      .school-check-line { margin: 0; }
      .school-check-line a { font-size: 1.08rem; font-weight: 700; color: var(--teal); }
      .school-check-sub { margin: 8px 0 0; font-size: 0.92rem; color: #5a6b80; }
      .interest { margin-top: 18px; }
      .btn-interest { background: rgba(255, 255, 255, 0.12); color: #fff; border: 1px solid rgba(255, 255, 255, 0.45); }
      .btn-interest:hover { background: rgba(255, 255, 255, 0.22); }
      .interest-form { margin-top: 14px; max-width: 480px; }
      .interest-form[hidden] { display: none; }
      .interest-form p { color: rgba(255, 255, 255, 0.88); margin: 0 0 10px; font-size: 0.95rem; }
      .interest-row { display: flex; gap: 10px; flex-wrap: wrap; }
      .interest-row input { flex: 1 1 200px; min-width: 0; padding: 12px 14px; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.35); background: rgba(255, 255, 255, 0.96); color: #212121; }
      .interest-row .btn { white-space: nowrap; }
    </style>

    <script>
      const box = document.querySelector("[data-interest]");
      if (box) {
        const slug = box.getAttribute("data-slug") || "";
        const field = box.getAttribute("data-field") || "";
        const provider = box.getAttribute("data-provider") || "";
        const btn = box.querySelector("[data-interest-btn]") as HTMLButtonElement | null;
        const form = box.querySelector("[data-interest-form]") as HTMLFormElement | null;
        const track = (n: string, p: Record<string, unknown>) => (window as any).digiteekaartTrack?.(n, p);
        const key = "mkval:interest:" + slug;
        const marked = () => { try { return localStorage.getItem(key) === "1"; } catch { return false; } };
        const showMarked = () => { if (btn) btn.textContent = "✓ Huvi märgitud"; if (form) form.hidden = false; };
        if (marked()) showMarked();
        btn?.addEventListener("click", () => {
          track("interest_signal", { programme_slug: slug, field, provider });
          try { localStorage.setItem(key, "1"); } catch { /* ignore */ }
          showMarked();
        });
        form?.addEventListener("submit", async (event) => {
          event.preventDefault();
          if (!form.reportValidity()) return;
          const email = String(new FormData(form).get("email") || "");
          track("lead_form_submit_attempt", { form_name: "interest_waitlist", programme_slug: slug });
          // AMOS ratifitseeritud sissevool (topic_subscribe); programmi valdkond läheb `field`-i.
          let sent = false;
          try {
            const r = await fetch("/api/subscribe", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ kind: "topic_subscribe", topic: "mikrokvalifikatsioon", email, field, source_site: "mikrokvalifikatsioon_ee" }) });
            sent = r.ok;
          } catch { sent = false; }
          if (!sent) {
            const body = encodeURIComponent("E-mail: " + email + "\nProgramm: " + slug + " (" + provider + ")");
            window.location.href = `mailto:info@mikrokvalifikatsioon.ee?subject=${encodeURIComponent("Huvi programmi vastu: " + slug)}&body=${body}`;
          }
          track("lead_form_submit", { form_name: "interest_waitlist", programme_slug: slug, delivery: sent ? "amos" : "mailto" });
          const msg = box.querySelector("[data-interest-msg]");
          if (msg) msg.innerHTML = sent ? "<strong>Aitäh!</strong> Teavitame sind, kui midagi muutub." : "Avasime e-kirja varuvariandi — vajuta saatmiseks Saada.";
        });
      }
    </script>
  </body>
</html>
