---
import Seo from "../../components/Seo.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/global.css";
import Nav from "../../components/Nav.astro";
import { catalog, providers, fields, fieldsWithSlug, providersWithSlug, catalogCheckedAt, catalogUpdatedAt } from "../../data/catalog";
import { outboundUrl } from "../../data/courseSchema";
import { ehisFetchedAt, ehisProgrammeCount, ehisProviderCount } from "../../data/ehisFacts";

const checkedAtText = catalogCheckedAt.split("-").reverse().join(".");
const updatedAtText = catalogUpdatedAt.split("-").reverse().join(".");
const ehisFetchedAtText = ehisFetchedAt.slice(0, 10).split("-").reverse().join(".");
const languageLabel = (language: string | null | undefined): string => {
  if (language === "et") return "Eesti";
  if (language === "en") return "Inglise";
  return "Märkimata";
};
const languageSort = (a: string, b: string): number => {
  const order: Record<string, number> = { et: 1, en: 2 };
  return (order[a] ?? 99) - (order[b] ?? 99) || languageLabel(a).localeCompare(languageLabel(b), "et");
};
const languages = [...new Set(catalog.flatMap((entry) => entry.language ? [entry.language] : []))]
  .sort(languageSort)
  .map((language) => ({
    language,
    label: languageLabel(language),
    count: catalog.filter((entry) => entry.language === language).length
  }));
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://mikrokvalifikatsioon.ee/#organization",
      name: "Mikrokvalifikatsioon.ee",
      legalName: "Ettevõtluskeskus OÜ",
      url: "https://mikrokvalifikatsioon.ee/"
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Avaleht", item: "https://mikrokvalifikatsioon.ee/" },
        { "@type": "ListItem", position: 2, name: "Kataloog", item: "https://mikrokvalifikatsioon.ee/kataloog/" }
      ]
    },
    {
      // Loend viitab programmilehtedele; rikas Course-schema elab iga programmilehe peal.
      "@type": "ItemList",
      name: "Eesti mikrokvalifikatsioonide ja mikrokraadide võrreldav kataloog",
      numberOfItems: catalog.length,
      itemListElement: catalog.map((entry, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: entry.name,
        url: `https://mikrokvalifikatsioon.ee/kataloog/${entry.slug}/`
      }))
    }
  ]
};
---

<!doctype html>
<html lang="et">
  <head>
    <Seo
      title="Eesti mikrokvalifikatsioonid ja mikrokraadid – kataloog"
      description={`Võrreldav kataloog: ${catalog.length} programmi ${providers.length} koolist. Ametlik EHIS faktikiht: ${ehisProgrammeCount} registreeritud õppekava ${ehisProviderCount} pakkujalt.`}
      canonicalPath="/kataloog/"
      ogTitle="Eesti mikrokvalifikatsioonide ja mikrokraadide kataloog"
      ogDescription="Õppijale võrreldavad programmid ühes kohas ning eraldi EHIS ametlik faktikiht."
      jsonLd={schema}
    />
  </head>
  <body>
    <Nav />

    <main class="report-page simple-report">
      <section class="report-hero simple-report-hero">
        <div class="section-inner">
          <span class="eyebrow">Kataloog</span>
          <h1>Leia mikrokvalifikatsioon või mikrokraad, mida saab päriselt võrrelda.</h1>
          <p>
            Vali valdkond, kool või märksõna ja vaata ühes kohas mahtu, hinda,
            õppevormi ning linki kooli ametlikule lehele. Täielik EHIS turupilt
            ja õppijale võrreldav valik on allpool eraldi numbritena.
          </p>
          <div class="catalog-proof">
            <div><strong>{ehisProgrammeCount}</strong><span>EHIS õppekava</span></div>
            <div><strong>{ehisProviderCount}</strong><span>EHIS pakkujat</span></div>
            <div><strong>{catalog.length}</strong><span>võrreldavat kirjet</span></div>
            <div><strong>{providers.length}</strong><span>kooli kataloogis</span></div>
          </div>
          <p class="report-date">
            Võrreldav kataloog uuendatud: {updatedAtText}. Avalikud allikafaktid kontrollitud: {checkedAtText}. EHIS faktikiht uuendatud: {ehisFetchedAtText}.
            <a href="/andmed/" data-track-event="cta_click" data-track-label="catalog_to_data">Vaata kogu andmekaarti →</a>
          </p>
        </div>
      </section>

      <section class="white" data-tool-section="kataloogifilter">
        <div class="section-inner">
          <div class="form-grid catalog-filters">
            <div class="field">
              <label for="catalogSearch">Otsi nime järgi</label>
              <input id="catalogSearch" data-catalog-search placeholder="Näiteks: andmeanalüüs" />
            </div>
            <div class="field">
              <label for="catalogField">Valdkond</label>
              <select id="catalogField" data-catalog-field>
                <option value="">Kõik valdkonnad</option>
                {fields.map((field) => <option value={field}>{field}</option>)}
              </select>
            </div>
            <div class="field">
              <label for="catalogProvider">Kool</label>
              <select id="catalogProvider" data-catalog-provider>
                <option value="">Kõik koolid</option>
                {providers.map((provider) => <option value={provider}>{provider}</option>)}
              </select>
            </div>
            <div class="field">
              <label for="catalogLanguage">Programmi õppekeel</label>
              <select id="catalogLanguage" data-catalog-language>
                <option value="">Kõik keeled</option>
                {languages.map((item) => <option value={item.language}>{item.label} ({item.count})</option>)}
              </select>
            </div>
          </div>
          <p class="field-help" data-catalog-count>{catalog.length} võrreldavat programmi</p>

          <nav class="field-links" aria-label="Sirvi valdkonniti">
            <span>Võrdle kataloogi valdkonniti:</span>
            {fieldsWithSlug.map((f) => (
              <a href={`/valdkond/${f.slug}/`} data-track-event="cta_click" data-track-label="catalog_field_link">{f.field} <b>{catalog.filter((e) => e.field === f.field).length}</b></a>
            ))}
          </nav>
          <nav class="field-links" aria-label="Sirvi koolide kaupa">
            <span>Koolide kaupa:</span>
            {providersWithSlug.map((p) => (
              <a href={`/koolitaja/${p.slug}/`} data-track-event="cta_click" data-track-label="catalog_provider_link">{p.provider} <b>{catalog.filter((e) => e.provider === p.provider).length}</b></a>
            ))}
          </nav>
          <p class="field-help">
            <a href="/registreerimine/" data-track-event="cta_click" data-track-label="catalog_to_registreerimine">Registreerimistähtaegade ja algusaegade järgi →</a>
            &nbsp;·&nbsp;
            <a href="/oskused/" data-track-event="cta_click" data-track-label="catalog_to_oskused">Otsi oskuse (õpiväljundi) järgi →</a>
            &nbsp;·&nbsp;
            <a href="/teema/" data-track-event="cta_click" data-track-label="catalog_to_teema">Sirvi teemade kaupa →</a>
            &nbsp;·&nbsp;
            <a href="/karjaar/" data-track-event="cta_click" data-track-label="catalog_to_karjaar">Karjäärirajad ja portfoolio →</a>
          </p>

          <div class="measure-list" data-catalog-list>
            {catalog.map((entry) => (
              <article
                class="measure-card"
                data-catalog-entry
                data-name={entry.name.toLowerCase()}
                data-field={entry.field}
                data-provider={entry.provider}
                data-language={entry.language ?? ""}
              >
                <div>
                  <span class="status-tag status-blue">{entry.field}</span>
                  <h3>{entry.name}</h3>
                  <p>{entry.summary}</p>
                </div>
                <dl>
                  <div><dt>Kool</dt><dd>{entry.provider}</dd></div>
                  {entry.language && <div><dt>Programmi õppekeel</dt><dd>{languageLabel(entry.language)}</dd></div>}
                  {entry.ects && <div><dt>Maht</dt><dd>{entry.ects} EAP</dd></div>}
                  {entry.priceText && <div><dt>Hind</dt><dd>{entry.priceText}</dd></div>}
                  {entry.durationText && <div><dt>Kestus</dt><dd>{entry.durationText}</dd></div>}
                </dl>
                {entry.intakeText && <p class="report-date">{entry.intakeText}</p>}
                <div class="catalog-card-actions">
                  <a
                    class="catalog-detail-link"
                    href={`/kataloog/${entry.slug}/`}
                    data-track-event="cta_click"
                    data-track-label="catalog_detail"
                  >Vaata lähemalt →</a>
                  <a
                    href={outboundUrl(entry, "kataloog")}
                    target="_blank"
                    rel="noreferrer"
                    data-track-event="partner_site_click"
                    data-track-label={`catalog_${entry.provider}`}
                  >Kooli leht ↗</a>
                  <label class="compare-pick">
                    <input type="checkbox" data-compare-pick data-url={entry.url} />
                    <span>Võrdle</span>
                  </label>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="white" data-tool-section="kusi-oskust">
        <div class="section-inner narrow">
          <div class="section-head compact-head">
            <span class="kicker">Nõudlus</span>
            <h2>Ei leidnud sobivat? Ütle, mida otsid.</h2>
            <p>Kui sulle vajalikku mikrokvalifikatsiooni veel pole, anna teada. Kogume nõudlust ja teavitame sind, kui selline lisandub.</p>
          </div>
          <form class="lead-form" data-demand-form data-webhook-url={import.meta.env.PUBLIC_SITE_LEAD_WEBHOOK_URL || ""}>
            <div class="form-grid">
              <div class="field full">
                <label for="demandSkill">Mis oskust või teemat otsid? *</label>
                <input id="demandSkill" name="skill" required placeholder="Näiteks: küberturbe alused, AI-tööriistad turunduses, projektijuhtimine" />
              </div>
              <div class="field">
                <label for="demandField">Valdkond</label>
                <select id="demandField" name="field">
                  <option value="">Pole kindel / muu</option>
                  {fields.map((field) => <option value={field}>{field}</option>)}
                </select>
              </div>
              <div class="field">
                <label for="demandEmail">E-mail (et teavitada)</label>
                <input id="demandEmail" name="email" type="email" autocomplete="email" placeholder="sinu@email.ee" />
              </div>
            </div>
            <button class="btn btn-primary" type="submit">Saada soov</button>
            <p class="form-note" data-demand-note>Soovi saab saata ka ilma e-mailita. Kui automaatne saatmine ei tööta, avaneb e-kirja varuvariant.</p>
          </form>
        </div>
      </section>

      <section class="ice">
        <div class="section-inner narrow">
          <div class="plain-warning">
            <h2>Märkasid viga või puuduvat programmi?</h2>
            <p>
              Register on koostatud koolide avalike lehtede põhjal ja hinnad/tähtajad muutuvad.
              Kui näed aegunud infot või sinu kooli programm puudub, kirjuta
              <a href="mailto:info@mikrokvalifikatsioon.ee?subject=Kataloogi%20parandus" data-track-event="email_click" data-track-label="catalog_correction">info@mikrokvalifikatsioon.ee</a>
              — parandame allika põhjal.
            </p>
          </div>
        </div>
      </section>
    </main>

    <Footer label="Mikrokvalifikatsioonide kataloog" />

    <div class="compare-bar" data-compare-bar hidden>
      <span data-compare-count>0 valitud</span>
      <a class="btn btn-primary" href="/vordlus/" data-compare-go data-track-event="cta_click" data-track-label="catalog_compare_go">Võrdle valituid</a>
      <button type="button" class="btn btn-secondary" data-compare-clear>Tühjenda</button>
    </div>

    <style is:global>
      /* .measure-card on display:grid, mis kirjutab UA [hidden]{display:none} üle —
         ilma selleta uuendab filter ainult loendurit, aga kaardid jäävad nähtavale. */
      .measure-card[hidden] { display: none; }
      .catalog-card-actions { display: flex; gap: 16px; align-items: center; white-space: nowrap; flex-wrap: wrap; }
      .catalog-detail-link { font-weight: 700; color: #2e7d22; }
      .field-links { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: 0 0 24px; }
      .field-links span { color: #5f6569; font-weight: 700; font-size: 0.9rem; margin-right: 4px; }
      .field-links a { display: inline-flex; gap: 4px; padding: 6px 12px; border-radius: 999px; background: #eef7ec; color: #2e7d22; font-size: 0.88rem; font-weight: 700; text-decoration: none; border: 1px solid #e2e4e3; }
      .field-links a:hover { background: #e4f7dd; }
      .field-links a b { font-weight: 800; opacity: 0.6; }
      .catalog-proof {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(135px, 1fr));
        gap: 10px;
        margin: 22px 0 6px;
        max-width: 780px;
      }
      .catalog-proof div {
        border: 1px solid #e2e4e3;
        border-radius: 14px;
        background: rgba(255,255,255,0.72);
        padding: 14px 16px;
      }
      .catalog-proof strong {
        display: block;
        color: var(--ink);
        font-size: clamp(1.4rem, 4vw, 2rem);
        line-height: 1;
      }
      .catalog-proof span {
        display: block;
        margin-top: 6px;
        color: var(--muted);
        font-weight: 700;
        font-size: 0.9rem;
      }
      .compare-pick { display: inline-flex; gap: 6px; align-items: center; font-size: 0.9rem; color: #44546a; cursor: pointer; }
      .compare-pick input { width: 16px; height: 16px; min-height: 0; accent-color: #2e7d22; }
      .compare-bar {
        position: fixed; bottom: 16px; left: 50%; transform: translateX(-50%);
        z-index: 50; display: flex; gap: 12px; align-items: center;
        padding: 10px 16px; background: #212121; color: #fff;
        border-radius: 12px; box-shadow: 0 18px 46px rgba(16,35,63,0.3);
      }
      .compare-bar[hidden] { display: none; }
      .compare-bar .btn { width: auto; padding: 9px 14px; font-size: 0.9rem; }
    </style>

    <script>
      const search = document.querySelector("[data-catalog-search]") as HTMLInputElement | null;
      const fieldSelect = document.querySelector("[data-catalog-field]") as HTMLSelectElement | null;
      const providerSelect = document.querySelector("[data-catalog-provider]") as HTMLSelectElement | null;
      const languageSelect = document.querySelector("[data-catalog-language]") as HTMLSelectElement | null;
      const count = document.querySelector("[data-catalog-count]");
      const entries = [...document.querySelectorAll<HTMLElement>("[data-catalog-entry]")];

      let lastVisible = entries.length;
      let searchTimer: ReturnType<typeof setTimeout> | undefined;

      // Otsing salvestatakse alles kui kirjutamine vaibub (väldib müra iga klahvi pealt)
      // ja GA4-natiivse `view_search_results` + `search_term`-ina → näha GA4 "Otsingusõnad"
      // tavaaruandes ilma lisaseadistuseta.
      const trackSearch = (): void => {
        const term = (search?.value || "").trim();
        const field = fieldSelect?.value || "";
        const provider = providerSelect?.value || "";
        const language = languageSelect?.value || "";
        const T = (window as any).digiteekaartTrack;
        if (term.length >= 2) {
          T?.("view_search_results", { search_term: term.toLowerCase().slice(0, 80), results: lastVisible, source: "kataloog" });
        }
        T?.("tool_completed", {
          tool_name: "kataloogifilter",
          result_tier: lastVisible > 0 ? "leitud" : "tühi",
          field: field || "kõik",
          provider: provider || "kõik",
          language: language || "kõik"
        });
      };

      const applyFilters = (): void => {
        const term = (search?.value || "").trim().toLowerCase();
        const field = fieldSelect?.value || "";
        const provider = providerSelect?.value || "";
        const language = languageSelect?.value || "";
        let visible = 0;
        for (const entry of entries) {
          const show =
            (!term || (entry.dataset.name || "").includes(term)) &&
            (!field || entry.dataset.field === field) &&
            (!provider || entry.dataset.provider === provider) &&
            (!language || entry.dataset.language === language);
          entry.hidden = !show;
          if (show) visible += 1;
        }
        lastVisible = visible;
        if (count) count.textContent = `${visible} võrreldavat programmi`;
        clearTimeout(searchTimer);
        searchTimer = setTimeout(trackSearch, 600);
      };

      search?.addEventListener("input", applyFilters);
      fieldSelect?.addEventListener("change", applyFilters);
      providerSelect?.addEventListener("change", applyFilters);
      languageSelect?.addEventListener("change", applyFilters);

      // Sügavlink /kataloog/?q=... eeltäidab otsingu (toetab WebSite SearchActionit ja jagatavaid linke).
      const initialQuery = new URLSearchParams(window.location.search).get("q");
      if (initialQuery && search) {
        search.value = initialQuery;
        applyFilters();
      }

      // Võrdluse valik: kuni 3 programmi, valik püsib sessionStorage'is.
      const compareKey = "mkval:compare";
      const compareBar = document.querySelector("[data-compare-bar]") as HTMLElement | null;
      const compareCount = document.querySelector("[data-compare-count]");
      const compareGo = document.querySelector("[data-compare-go]") as HTMLAnchorElement | null;
      const picks = [...document.querySelectorAll<HTMLInputElement>("[data-compare-pick]")];

      const readPicks = (): string[] => {
        try { return JSON.parse(sessionStorage.getItem(compareKey) || "[]"); } catch { return []; }
      };
      const writePicks = (urls: string[]): void => {
        try { sessionStorage.setItem(compareKey, JSON.stringify(urls)); } catch { /* valik elab siis ainult lehe piires */ }
      };
      const syncCompareUi = (): void => {
        const urls = readPicks();
        picks.forEach((box) => { box.checked = urls.includes(box.dataset.url || ""); });
        if (compareBar) compareBar.hidden = urls.length < 2;
        if (compareCount) compareCount.textContent = `${urls.length} valitud`;
        if (compareGo) compareGo.href = `/vordlus/?p=${urls.map(encodeURIComponent).join("|")}`;
      };
      picks.forEach((box) => {
        box.addEventListener("change", () => {
          let urls = readPicks();
          const url = box.dataset.url || "";
          if (box.checked) {
            if (urls.length >= 3) { box.checked = false; return; }
            if (!urls.includes(url)) urls.push(url);
          } else {
            urls = urls.filter((u) => u !== url);
          }
          writePicks(urls);
          syncCompareUi();
        });
      });
      document.querySelector("[data-compare-clear]")?.addEventListener("click", () => { writePicks([]); syncCompareUi(); });
      syncCompareUi();

      // Nõudlus: "küsi uut oskust" — fikseerib rahuldamata nõudluse (mida järgmisena ehitada).
      const demandForm = document.querySelector("[data-demand-form]") as HTMLFormElement | null;
      const demandNote = document.querySelector("[data-demand-note]");
      const demandTrack = (n: string, p: Record<string, unknown>) => (window as any).digiteekaartTrack?.(n, p);
      demandForm?.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!demandForm.reportValidity()) return;
        const payload = Object.fromEntries(new FormData(demandForm).entries());
        const webhookUrl = demandForm.getAttribute("data-webhook-url") || "";
        demandTrack("demand_request", { skill: String(payload.skill || "").slice(0, 100), field: String(payload.field || "kõik"), has_email: payload.email ? "jah" : "ei" });
        let sent = false;
        if (webhookUrl) {
          try {
            const r = await fetch(webhookUrl, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ form: "demand_request", site: "mikrokvalifikatsioon.ee", ...payload }) });
            sent = r.ok;
          } catch { sent = false; }
        }
        if (!sent) {
          const body = encodeURIComponent("Soovitud oskus: " + (payload.skill || "") + "\nValdkond: " + (payload.field || "-") + "\nE-mail: " + (payload.email || "-"));
          window.location.href = `mailto:info@mikrokvalifikatsioon.ee?subject=${encodeURIComponent("Küsi uut mikrokvalifikatsiooni")}&body=${body}`;
        }
        if (demandNote) demandNote.textContent = sent
          ? "Aitäh! Lisasime su soovi nõudluse-nimekirja. Kui selline programm lisandub, anname teada."
          : "Avasime e-kirja varuvariandi — vajuta saatmiseks Saada.";
        demandForm.reset();
      });
    </script>
  </body>
</html>
