---
import Seo from "../components/Seo.astro";
import Footer from "../components/Footer.astro";
import Faq from "../components/Faq.astro";
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import { catalog, providers, catalogCheckedAt } from "../data/catalog";
import { slugify } from "../data/slug";
import { fieldStats, ectsRangeText, priceRangeText } from "../lib/fieldComparison";

const SITE = "https://mikrokvalifikatsioon.ee";
const PATH = "/mikrokvalifikatsiooni-valimine/";

// "Valimine" intent-leht MITTE-ülikooli mikrokvalifikatsioonidele
// (rakenduskõrgkoolid + koolitusettevõtted). Ülikoolide mikrokraadi valimisel on
// eraldi /mikrokraadi-valimine/ leht. Üks tugev leht katab valimine/valik/valikud
// (ainsus + mitmus) — eraldi õhukesi vorme me ei tee.
const microQuals = catalog.filter((e) => e.providerType !== "ülikool");
const microDegrees = catalog.filter((e) => e.providerType === "ülikool");

const checkedAtText = catalogCheckedAt.split("-").reverse().join(".");

// "Sinu valikud" — valdkonnapõhine ülevaade päris kataloogiandmetest:
// programmide arv, EAP-vahemik, hinnavahemik ja näiteprogrammid. "muu" välja jäetud.
const fieldComparison = fieldStats(microQuals);
const optionFields = fieldComparison.slice(0, 8);
const biggestField = fieldComparison[0] ?? null;

// Tüüpiline maht KKK ja sissejuhatuse jaoks — päris andmetest.
const microEcts = microQuals.map((e) => e.ects).filter((n): n is number => n != null);
const ectsLo = microEcts.length ? Math.min(...microEcts) : null;
const ectsHi = microEcts.length ? Math.max(...microEcts) : null;
const ectsTypicalText =
  ectsLo != null && ectsHi != null
    ? ectsLo === ectsHi
      ? `${ectsLo} EAP`
      : `${ectsLo}–${ectsHi} EAP`
    : "mõni kuni paarkümmend EAP";

// Otsustusraja sammud — kuvatud nummerdatud loendina JA HowTo JSON-LD-s.
const decisionSteps = [
  {
    name: "Alusta eesmärgist",
    text: "Sõnasta üks konkreetne oskus, mida tahad tõendada — mitte „õpin midagi kasulikku“, vaid näiteks „oskan teha andmeanalüüsi“ või „juhin projekti“. Eesmärk määrab kõik järgmised sammud."
  },
  {
    name: "Vaata mahtu ja kestust",
    text: `Kontrolli mahtu (EAP) ja kestust koos. Selle valimi avaldatud mahud jäävad vahemikku ${ectsTypicalText}. Väiksem maht sobib kiiresse graafikusse töö kõrvalt; suurem maht annab põhjalikuma tulemuse, aga nõuab rohkem aega.`
  },
  {
    name: "Kontrolli rahastust ja sihtrühma",
    text: "Vaata, kes kulu katab: tööandja koolituseelarve, õppekava enda rahastus või sina ise. Osa programme on kindlale sihtrühmale rahastatud — kontrolli, kas sina kvalifitseerud. Rahastusradadest räägib leht „Kes maksab?“."
  },
  {
    name: "Vali valdkond",
    text: "Kitsenda otsing valdkonna järgi — näiteks IT ja andmed, majandus ja juhtimine või tehnika ja tootmine. Iga valdkonna lehel näed kõiki selle programme korraga."
  },
  {
    name: "Võrdle kõrvuti",
    text: "Märgi kataloogis kuni kolm sind huvitavat programmi ja vaata need ühes tabelis võrdlustööriistas: hind, maht, kestus ja õppevorm kõrvuti."
  },
  {
    name: "Vali ja registreeru kooli lehel",
    text: "Kui üks programm sobib eesmärgi, mahu, rahastuse ja õppevormiga, mine kooli enda lehele ja registreeru. Lõplik ja siduv info on alati kooli registreerimislehel."
  }
];

// Valdkonnalingid, mida mikrokvalifikatsioonide pakkujad katavad (ilma "muu"-ta).
const microFields = [...new Set(microQuals.map((e) => e.field))]
  .filter((f) => f !== "muu")
  .map((field) => ({ field, slug: slugify(field) }));

const faqItems = [
  {
    question: "Kuidas valida mikrokvalifikatsiooni?",
    answer:
      "Liigu kuues sammus: alusta ühest konkreetsest oskusest (eesmärk), vaata mahtu (EAP) ja kestust koos, kontrolli rahastust ja sihtrühma, kitsenda valdkonna järgi, võrdle kuni kolme programmi kõrvuti ja registreeru kooli enda lehel. Nii valid eesmärgi, mitte kooli nime järgi."
  },
  {
    question: "Millised on mikrokvalifikatsioonide valikud?",
    answer: biggestField
      ? `Selle lehe valimis (rakenduskõrgkoolide ja koolitusettevõtete mikrokvalifikatsioonid) on ${microQuals.length} programmi ${providers.length} koolist mitmes valdkonnas. Kõige laiem valik on valdkonnas „${biggestField.field}“ — ${biggestField.count} programmi. Kõik valdkonnad koos programmide arvuga on allpool „Sinu valikud“ ülevaates ja lehel /valdkond/.`
      : `Selle lehe valimis on ${microQuals.length} programmi ${providers.length} koolist mitmes valdkonnas. Kõik valdkonnad koos programmide arvuga on allpool „Sinu valikud“ ülevaates ja lehel /valdkond/.`
  },
  {
    question: "Mille järgi mikrokvalifikatsiooni valida?",
    answer:
      "Viie tunnuse järgi: hind, maht (EAP või akadeemilised tunnid), kestus, õppevorm (veebis, hübriid või kohapeal) ja kes kulu katab. Esimese sõela teeb aga eesmärk — milline oskus su tööd või karjääri kõige rohkem aitab. Alles siis tasub hindu ja mahte kõrvutada."
  },
  {
    question: "Mikrokvalifikatsioon vs mikrokraad — kumba valida?",
    answer:
      "Mikrokvalifikatsioon on katusmõiste igale lühikesele tunnustatud õppele; mikrokraad on selle ülikooli versioon, mis annab EAP-sid, mida saab hiljem kraadiõppes arvestada. Vali koolitusettevõtte või rakenduskõrgkooli mikrokvalifikatsioon, kui tahad kiiret praktilist oskust; vali ülikooli mikrokraad, kui tahad ainepunkte tasemeõppe jaoks. Ülikoolide oma võrdle lehel /mikrokraadi-valimine/."
  },
  {
    question: "Kui suur on tüüpiline maht (EAP)?",
    answer: `Maht antakse Euroopa ainepunktides (EAP); 1 EAP vastab umbes 26 tunnile õppija tööd. Selle lehe valimis jäävad avaldatud mahud vahemikku ${ectsTypicalText} — väiksem maht tähendab kiiremat lühiõpet, suurem maht põhjalikumat programmi. Osa koolitusettevõtteid annab mahu hoopis akadeemilistes tundides; täpne maht on iga programmi juures kataloogis.`
  },
  {
    question: "Kes mikrokvalifikatsiooni kinni maksab?",
    answer:
      "Kolm rada: tööandja koolituseelarve (kui oskus aitab praegust tööd), õppekava enda sihtrühma rahastus (kui kvalifitseerud) või ise makstes. Osa programme on kindlale sihtrühmale rahastatud — kontrolli kooli lehelt, kas sina kvalifitseerud. Sobiva raja leiad lehelt /kes-maksab/."
  },
  {
    question: "Kust pärinevad valikulehe andmed?",
    answer:
      "Programmide arv, maht, hind ja valdkond pärinevad koolide avalikelt lehtedelt ja need on kontrollitud kuupäeval, mis on iga kirje juures kataloogis. Andmemetoodika on lehel /andmed/. Lõplik ja siduv info on alati kooli enda registreerimislehel."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${SITE}/#organization`,
      name: "Mikrokvalifikatsioon.ee",
      legalName: "Ettevõtluskeskus OÜ",
      url: `${SITE}/`
    },
    {
      "@type": "WebPage",
      "@id": `${SITE}${PATH}#webpage`,
      url: `${SITE}${PATH}`,
      name: "Mikrokvalifikatsiooni valimine: kuidas valida õige?",
      description:
        "Mikrokvalifikatsiooni valimine sammhaaval: kuidas valida õige mikrokvalifikatsioon eesmärgi, mahu, rahastuse ja valdkonna järgi. Reaalsed valikud Eesti pakkujatelt.",
      inLanguage: "et",
      isPartOf: { "@id": `${SITE}/#organization` },
      dateModified: catalogCheckedAt,
      mainEntityOfPage: `${SITE}${PATH}`
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Avaleht", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Kataloog", item: `${SITE}/kataloog/` },
        {
          "@type": "ListItem",
          position: 3,
          name: "Mikrokvalifikatsiooni valimine",
          item: `${SITE}${PATH}`
        }
      ]
    },
    {
      "@type": "HowTo",
      name: "Kuidas valida õige mikrokvalifikatsioon?",
      description:
        "Kuues sammus sobiva mikrokvalifikatsioonini: eesmärk, maht ja kestus, rahastus ja sihtrühm, valdkond, võrdlus ja valik.",
      inLanguage: "et",
      totalTime: "PT15M",
      step: decisionSteps.map((s, index) => ({
        "@type": "HowToStep",
        position: index + 1,
        name: s.name,
        text: s.text,
        url: `${SITE}${PATH}#samm-${index + 1}`
      }))
    },
    {
      "@type": "ItemList",
      name: "Mikrokvalifikatsiooni valikud valdkonniti",
      itemListOrder: "https://schema.org/ItemListOrderDescending",
      numberOfItems: optionFields.length,
      itemListElement: optionFields.map((stat, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: `${stat.field} — ${stat.count} programmi`,
        url: `${SITE}/valdkond/${stat.slug}/`
      }))
    },
    {
      "@type": "FAQPage",
      mainEntity: faqItems.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer }
      }))
    }
  ]
};
---

<!doctype html>
<html lang="et">
  <head>
    <Seo
      title="Mikrokvalifikatsiooni valimine — kuidas valida õige? Sinu valikud | Mikrokvalifikatsioon.ee"
      description="Mikrokvalifikatsiooni valimine sammhaaval: kuidas valida õige mikrokvalifikatsioon eesmärgi, mahu, rahastuse ja valdkonna järgi. Vaata kõiki valikuid Eesti pakkujatelt."
      canonicalPath={PATH}
      ogType="article"
      ogTitle="Mikrokvalifikatsiooni valimine: kuidas valida õige?"
      ogDescription="Otsustusraamistik ja kõik valikud valdkonniti — kuidas valida õige mikrokvalifikatsioon, päris Eesti andmetega."
      jsonLd={schema}
    />
    <style is:global>
      .mkv-options-wrap { overflow-x: auto; }
      .mkv-options {
        width: 100%;
        border-collapse: collapse;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 8px;
        min-width: 760px;
      }
      .mkv-options th, .mkv-options td {
        border: 1px solid #e4ecf2;
        padding: 12px 14px;
        text-align: left;
        vertical-align: top;
        font-size: 0.95rem;
      }
      .mkv-options thead th { background: var(--navy); color: #fff; font-size: 0.9rem; }
      .mkv-options tbody th[scope="row"] { font-weight: 800; background: #f4f8fb; }
      .mkv-options tbody th[scope="row"] a { color: var(--teal); font-weight: 900; }
      .mkv-steps { display: grid; gap: 14px; counter-reset: step; padding-left: 0; list-style: none; }
      .mkv-steps li {
        position: relative;
        padding: 14px 16px 14px 58px;
        border: 1px solid var(--line);
        border-radius: 12px;
        background: #fff;
      }
      .mkv-steps li::before {
        counter-increment: step;
        content: counter(step);
        position: absolute;
        left: 14px;
        top: 14px;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: var(--teal);
        color: #fff;
        font-weight: 900;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .mkv-steps li strong { color: var(--ink); display: block; margin-bottom: 4px; }
      .mkv-steps li p { margin: 0; color: var(--muted); }
    </style>
  </head>
  <body>
    <Nav />

    <main class="report-page simple-report">
      <section class="report-hero simple-report-hero">
        <div class="section-inner">
          <span class="eyebrow">Kuidas valida</span>
          <h1>Mikrokvalifikatsiooni valimine: kuidas valida õige?</h1>
          <p>
            Õige mikrokvalifikatsiooni valid eesmärgi, mitte kooli nime järgi.
            <strong>Alusta ühest konkreetsest oskusest, mida tahad tõendada</strong>, ja sõelu
            siis välja eesmärgile sobiv programm mahu (EAP), kestuse, rahastuse, valdkonna ja
            õppevormi järgi. Siin on selge otsustusraamistik ja kõik su valikud — reaalsed
            andmed {providers.length} koolist.
          </p>
          <div class="actions">
            <a class="btn btn-primary" href="/vordlus/" data-track-event="cta_click" data-track-label="mkv_valimine_hero_tool">Võrdle kuni 3 kõrvuti</a>
            <a class="btn btn-secondary" href="/kataloog/" data-track-event="cta_click" data-track-label="mkv_valimine_hero_kataloog">Vaata kõiki ({catalog.length})</a>
          </div>
        </div>
      </section>

      <!-- Lühivastus — GEO: extractable, otse intentile -->
      <section class="white">
        <div class="section-inner narrow">
          <div class="section-head compact-head">
            <span class="kicker">Lühidalt</span>
            <h2>Kuidas valida õige mikrokvalifikatsioon?</h2>
          </div>
          <p>
            <strong>Vali mikrokvalifikatsioon kuues sammus: eesmärk → maht ja kestus → rahastus
            ja sihtrühm → valdkond → võrdle → vali.</strong> Esmalt sõnasta üks konkreetne
            oskus, mida tahad tõendada; seejärel kitsenda valik valdkonna järgi ja võrdle kuni
            kolme programmi hinda, mahtu, kestust ja õppevormi kõrvuti. Lõplik info on alati
            kooli enda lehel.
          </p>
          <ul class="check">
            <li><strong>{catalog.length}</strong> programmi {providers.length} koolist meie kataloogis.</li>
            <li><strong>{microQuals.length}</strong> neist on rakenduskõrgkoolide ja koolitusettevõtete mikrokvalifikatsioonid.</li>
            <li><strong>{microDegrees.length}</strong> on ülikoolide mikrokraadid — nende valimisel aitab <a href="/mikrokraadi-valimine/">mikrokraadi valimine</a>.</li>
          </ul>
        </div>
      </section>

      <!-- Otsustusraamistik — GEO: HowTo, nummerdatud sammud -->
      <section class="ice">
        <div class="section-inner narrow">
          <div class="section-head compact-head">
            <span class="kicker">Otsustusraamistik</span>
            <h2>Kuus sammu sobiva mikrokvalifikatsioonini.</h2>
            <p>Järgi neid samme järjekorras — eesmärk teeb esimese sõela, hind ja õppevorm viimase.</p>
          </div>
          <ol class="mkv-steps">
            {decisionSteps.map((step, i) => (
              <li id={`samm-${i + 1}`}>
                <strong>{step.name}</strong>
                <p>{step.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- Sinu valikud — GEO: per-field options overview, extractable table -->
      <section class="white">
        <div class="section-inner">
          <div class="section-head compact-head">
            <span class="kicker">Sinu valikud</span>
            <h2>Mikrokvalifikatsioonide valikud valdkonniti.</h2>
            <p>
              Iga valdkonna kohta on toodud programmide arv, mahuvahemik (EAP), hinnavahemik ja
              paar näiteprogrammi — kõik päris kataloogiandmetest. Klõpsa valdkonnal, et näha
              selle kõiki programme ja teha valik.
            </p>
          </div>
          <div class="mkv-options-wrap">
            <table class="mkv-options">
              <thead>
                <tr>
                  <th scope="col">Valdkond</th>
                  <th scope="col">Programme</th>
                  <th scope="col">Maht (EAP)</th>
                  <th scope="col">Hinnavahemik</th>
                  <th scope="col">Näited</th>
                </tr>
              </thead>
              <tbody>
                {optionFields.map((stat) => (
                  <tr>
                    <th scope="row"><a href={`/valdkond/${stat.slug}/`}>{stat.field}</a></th>
                    <td>{stat.count}</td>
                    <td>{ectsRangeText(stat)}</td>
                    <td>{priceRangeText(stat)}</td>
                    <td>
                      {stat.examples.map((ex, i) => (
                        <>
                          {i > 0 && ", "}
                          <a href={`/kataloog/${ex.slug}/`}>{ex.name}</a>
                        </>
                      ))}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="notice">
            Hinnavahemik on tuletatud koolide avaldatud hindadest (kontrollitud {checkedAtText}); kui
            valdkonnas pole ühtki avalikku hinda, on märge „vaata kataloogist“. Maht „kooli lehel“
            tähendab, et osa pakkujaid kasutab EAP asemel akadeemilisi tunde. Metoodika on lehel
            <a href="/andmed/">Andmed</a>.
          </p>
          <p>
            Kõik valdkonnad eraldi lehtedena:
            {microFields.map((f, i) => (
              <>
                {i > 0 && " · "}
                <a href={`/valdkond/${f.slug}/`}>{f.field}</a>
              </>
            ))}.
          </p>
          <div class="actions">
            <a class="btn btn-primary" href="/mikrokvalifikatsioonide-vordlus/" data-track-event="cta_click" data-track-label="mkv_valimine_vordlus">Vaata mikrokvalifikatsioonide võrdlust</a>
            <a class="btn btn-secondary" href="/kataloog/" data-track-event="cta_click" data-track-label="mkv_valimine_kataloog">Ava kogu kataloog</a>
          </div>
        </div>
      </section>

      <!-- Seotud — cross-links -->
      <section class="ice">
        <div class="section-inner narrow">
          <div class="section-head compact-head">
            <span class="kicker">Seotud</span>
            <h2>Vaata edasi.</h2>
          </div>
          <ul class="check">
            <li><a href="/mikrokraadi-valimine/">Mikrokraadi valimine</a> — kuidas valida õige ülikooli mikrokraad (EAP, eeldused, tasemeõpe).</li>
            <li><a href="/mikrokvalifikatsioonide-vordlus/">Mikrokvalifikatsioonide võrdlus</a> — hind, maht, kestus ja õppevorm kõrvuti.</li>
            <li><a href="/mikrokraadide-vordlus/">Mikrokraadide võrdlus</a> — ülikoolide mikrokraadid ühes tabelis.</li>
            <li><a href="/kataloog/">Filtreeritav kataloog</a> ja <a href="/vordlus/">võrdlustööriist</a> — kõrvuta kuni kolm programmi.</li>
            <li><a href="/kes-maksab/">Kes maksab?</a> — tööandja, õppekava rahastus või ise; leia oma rahastusrada.</li>
          </ul>
        </div>
      </section>

      <!-- KKK — GEO: FAQPage, katab valimine/valik/valikud cluster -->
      <section class="white">
        <div class="section-inner narrow">
          <div class="section-head compact-head">
            <span class="kicker">Korduvad küsimused</span>
            <h2>Valimine, valikud ja võrdlemine — lühivastused.</h2>
          </div>
          <Faq items={faqItems} openFirst={3} />
        </div>
      </section>

      <section class="navy">
        <div class="section-inner contact">
          <div>
            <span class="kicker">Järgmine samm</span>
            <h2>Tee valik kindlamaks — võrdle kõrvuti või tee suunatest.</h2>
            <div class="inline-actions">
              <a class="btn btn-primary" href="/vordlus/" data-track-event="cta_click" data-track-label="mkv_valimine_bottom_tool">Võrdle kuni 3 programmi</a>
              <a class="btn btn-secondary" href="/#suunatest" data-track-event="cta_click" data-track-label="mkv_valimine_bottom_suunatest">Tee suunatest</a>
            </div>
          </div>
          <aside class="contact-card">
            <h3>Kontakt</h3>
            <p>Ettevõtluskeskus OÜ</p>
            <p><a href="mailto:info@mikrokvalifikatsioon.ee" data-track-event="email_click" data-track-label="mkv_valimine_email">info@mikrokvalifikatsioon.ee</a></p>
            <p><a href="tel:+37258180435" data-track-event="phone_click" data-track-label="mkv_valimine_phone">+372 5818 0435</a></p>
          </aside>
        </div>
      </section>
    </main>

    <Footer label="Mikrokvalifikatsiooni valimine" />
  </body>
</html>
