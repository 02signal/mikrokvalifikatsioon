    <Footer label="Minu konto" />

    <!-- Kinnitusdialoog (kustutamine / kombinatsioon jne) -->
    <div class="pm pm-modal" data-modal hidden>
      <div class="pm-modal-card" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
        <h3 id="modalTitle" data-modal-title></h3>
        <p data-modal-body></p>
        <div class="pm-modal-actions">
          <button type="button" class="pm-btn pm-btn-primary" data-modal-confirm></button>
          <button type="button" class="pm-btn pm-btn-ghost" data-modal-cancel>Loobu</button>
        </div>
