---
import Seo from "../../components/Seo.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import PmStepper from "../../components/PmStepper.astro";
import "../../styles/global.css";
import "../../styles/pragmatic-momentum.css";
import { catalog } from "../../data/catalog";
import { fieldsWithSlug } from "../../data/catalog";

// ============================================================================
// Minu konto — mkval ET face (account-MVP).
//
// VISUAALNE KEEL: "Pragmaatiline liikumine" (docs/style-tile + onboarding-v3).
// Sora + Atkinson Hyperlegible, jahe-neutraalne taust, roheline = edasiminek,
// tõusvad kriipsud motiivina, seisundi-juhitud ekraanid. Kogu konto-pind on
// .pm juurklassi all, et disainisüsteem ei segaks teiste lehtede global.css-i.
//
// ARHITEKTUUR (konsolideerimise külmutus): see on ÕHUKE NÄGU. Kogu isiku-
// tuvastus, nõusoleku-pearaamat, paketihoidla ja meeldetuletuste ajastus
// elavad AMOS-is. See leht hoiab ainult lühiajalist seansimärki ja anonüümset
// localStorage'i, mille ta migreerib üles. Konto-loogikat siia ei ehita.
//
// STAATILINE DEMO/SILD: apex jääb output:"static", seega /konto/ on staatilised
// lehed + kliendipoolne loogika. TOOTMISES kolib see eraldi SSR-alamdomeenile
// (konto.mikrokvalifikatsioon.ee), kus magic-link'i kinnitus (HMAC confirm-token)
// ja /konto/state · /konto/migrate · /konto/delete elavad AMOS-is. Kuni selleni
// on KONTO-SEISUND SILLATUD union-merge'itud localStorage'ist (vt allpool
// "BRIDGE" kommentaare). Iga sild on UI-märkega ja koodikommentaariga tähistatud.
//
// LIVE PIPE: e-postide korje läheb POST /api/subscribe → AMOS sissevool
// (double-opt-in, consent_purpose course_offers). Paketi salvestamine kasutab
// olemasolevat kind "outcome_package" (mis päriselt jõuab AMOS-i juba täna).
// Uued kontospõhised kinnid (account_create, reminder_subscribed,
// funding_profile_set, notify_list/combo_waitlist) on AMOS-i lepingus VEEL
// defineerimata → need on serverile saadetud "parima püüdega" ja kuni
// backend kinnitab, käituvad sillana (UI ei luba midagi, mida pole).
// ============================================================================

const SITE = "https://mikrokvalifikatsioon.ee";

// Programmide indeks (slug → metaandmed) — sama kuju kui /oskused/, et
// fit-mootor (amos.outcome.fit/v1) saaks kontol paketi katvust arvutada.
const progIndex: Record<string, { name: string; provider: string; ects: number | null; price: string | null; field: string; registrationDeadline: string | null }> = {};
for (const e of catalog) {
  progIndex[e.slug] = {
    name: e.name,
    provider: e.provider,
    ects: e.ects ?? null,
    price: e.priceText ?? null,
    field: e.field,
    registrationDeadline: e.registrationDeadline ?? null,
  };
}
const progJson = JSON.stringify(progIndex).replace(/</g, "\\u003c");

// Valdkonna SLUG -> inimkeelne silt. Select saadab slugi (kanooniline target_ref);
// demo-tee (flag maas) kuvab selle järgi siiski inimkeelse sildi.
const fieldLabelBySlug: Record<string, string> = {};
for (const { field, slug } of fieldsWithSlug) fieldLabelBySlug[slug] = field;
const fieldLabelJson = JSON.stringify(fieldLabelBySlug).replace(/</g, "\\u003c");

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Organization", "@id": `${SITE}/#organization`, name: "Mikrokvalifikatsioon.ee", legalName: "Ettevõtluskeskus OÜ", url: `${SITE}/` },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Avaleht", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Minu konto", item: `${SITE}/konto/` }
      ]
    }
  ]
};
---

<!doctype html>
<html lang="et">
  <head>
    <Seo
      title="Minu konto — hoia oma oskuste pakett alles"
      description="Loo konto: hoiame su valitud oskuste paketi alles ja anname märku, kui sobiv programm, kombinatsioon või registreerimise tähtaeg lisandub. Parooli pole vaja — saadame sisselogimislingi e-postiga."
      canonicalPath="/konto/"
      robots="noindex,follow"
      jsonLd={schema}
    />
    <!-- Pragmaatiline liikumine: Sora (pealkirjad) + Atkinson Hyperlegible (tekst) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Nav />

    <main class="pm pm-stage" id="main" data-konto-root>
      <div class="pm-wrap">
        <nav class="pm-crumbs" aria-label="Asukoht">
          <a href="/">Avaleht</a> › <span>Minu konto</span>
        </nav>
      </div>

      <!-- Edenemis-mõõdik: peidetud välja-logitud (auth) ekraanil, et apex jääks rahulik;
           kuvame kinnitamise (check) ja konto (account) ekraanil. -->
      <div class="pm-wrap" data-stepper-wrap hidden>
        <PmStepper current={2} />
      </div>

      <!-- ============ EKRAAN B — välja logitud: Loo konto / Logi sisse ============ -->
      <!-- STATE s1: usaldus-/rämpsposti-hirm. VASTUS: täpselt mida, miks, ei spämmi, sina kontrollid. -->
      <section class="pm-wrap pm-screen on" data-screen="auth" data-tool-section="konto-login" aria-labelledby="authH">
        <!-- .pm-rise puhkeseis on NÄHTAV (opacity:1); sisenemis-efekti mängib
             JS (revealRise) iga ekraani paljastamisel transition'iga. Nii on keha
             alati nähtav, ka siis kui ekraan paljastatakse alles async-laadimise järel. -->
        <div class="pm-rise">
          <div class="pm-eyebrow">Minu konto</div>
          <h1 id="authH" data-auth-title>Hoia oma valikud <em>alles.</em></h1>
          <p class="pm-lede" data-auth-lede>
            Sinu e-post on sinu keskus - üks koht, kuhu tagasi tulla. Parooli pole vaja: saadame
            sulle e-postiga lingi, mis kinnitab su e-posti ja logib sind sisse.
          </p>

          <!-- Mille konto sulle annab (lühike, kasu-põhine - 60-70+ omanikule). -->
          <ul class="pm-benefits" data-auth-value>
            <li><span class="b" aria-hidden="true">✓</span> <span><b>Hoia oma oskused alles.</b> Su valitud oskuste pakett püsib alles - ka uues seadmes.</span></li>
            <li><span class="b" aria-hidden="true">✓</span> <span><b>Saa teada sobivast programmist või kombinatsioonist.</b> Kui sinu oskustele midagi sobivat lisandub, anname märku - sa ei pea ise otsima.</span></li>
            <li><span class="b" aria-hidden="true">✓</span> <span><b>Tähtaja-meeldetuletus.</b> Anname märku enne, kui registreerimine lõpeb - et sa ei jääks tähtajast ilma.</span></li>
          </ul>

          <div class="pm-banner anon" data-anon-banner hidden></div>

          <!-- Kaks veidi erinevat teed: uus konto (kasu + nõusolek) vs tagasi (lühike). -->
          <div class="pm-mode" role="tablist" aria-label="Vali, mida soovid">
            <button type="button" class="pm-modebtn on" role="tab" aria-selected="true" data-mode-btn="signup">Liitu / loo konto</button>
            <button type="button" class="pm-modebtn" role="tab" aria-selected="false" data-mode-btn="login">Logi sisse</button>
          </div>

          <div class="pm-card" style="max-width:580px">
            <form data-auth-form data-site-lead-form data-source-site="mikrokvalifikatsioon.ee">
              <p class="pm-modehint" data-mode-hint="signup">
                <strong>Uus siin?</strong> Jäta e-post, pane linnuke nõusoleku juurde - hoiame su valikud alles.
              </p>
              <p class="pm-modehint" data-mode-hint="login" hidden>
                <strong>Juba kasutaja?</strong> Sisesta sama e-post, saadame sulle sisselogimislingi.
              </p>
              <div class="pm-field">
                <label for="kontoEmail">Sinu e-post</label>
                <input id="kontoEmail" name="email" type="email" required autocomplete="email" placeholder="nimi@ettevote.ee" />
              </div>
              <div class="pm-trust" data-mode-only="signup" aria-hidden="false">
                <div><span class="t" aria-hidden="true">✓</span> Kogume <b>ainult e-posti</b> - ei nime, ei muud.</div>
                <div><span class="t" aria-hidden="true">✓</span> <b>Ei spämmi</b> - kiri ainult siis, kui on midagi sinu jaoks.</div>
                <div><span class="t" aria-hidden="true">✓</span> <b>Sina kontrollid</b> - eemaldad end ühe klõpsuga.</div>
                <div><span class="t" aria-hidden="true">✓</span> Andmed Eestis · <a href="/privaatsus/">privaatsus</a></div>
              </div>
              <label class="pm-consent" data-consent-row data-mode-only="signup">
                <input type="checkbox" name="consent" data-consent />
                <span>
                  Jah, hoidke mu valikud alles ja andke teada, kui sobiv programm, kombinatsioon või
                  tähtaeg lisandub. Saan nõusoleku igal ajal tagasi võtta (iga kirja jaluses on loobumislink).
                </span>
              </label>
              <p class="pm-error" data-auth-error hidden></p>
              <button class="pm-btn pm-btn-primary" type="submit" data-auth-submit>
                <span data-auth-submit-label>Saada mulle link</span> <span class="arr" aria-hidden="true">→</span>
              </button>
              <div class="pm-reassure">
                <span class="lock" aria-hidden="true">🔒</span> Vajab ainult e-posti. Tasuta. Parooli pole vaja.
              </div>
            </form>
          </div>
        </div>
      </section>

      <!-- ============ EKRAAN C — pärast saatmist: Kontrolli e-posti ============ -->
      <!-- STATE s2: ebakindlus + ootus ("kas tuli?"). VASTUS: kristallselge mis/kellelt/millal + kontroll. -->
      <section class="pm-wrap pm-screen" data-screen="check" hidden aria-labelledby="checkH">
        <div class="pm-card pm-center pm-rise" style="max-width:580px;margin:10px auto">
          <div class="pm-envelope" aria-hidden="true">
            <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#3f9c30" stroke-width="1.8">
              <rect x="3" y="5" width="18" height="14" rx="2.5" /><path d="m3.5 7 8.5 6 8.5-6" />
            </svg>
          </div>
          <h1 id="checkH" style="font-size:30px">Vaata oma e-posti</h1>
          <p class="pm-lede" style="margin:10px auto 4px">
            Saatsime lingi aadressile <span class="pm-addr" data-check-email>su e-postile</span>.
          </p>
          <p style="color:var(--pm-muted)">
            Ava e-kiri ja vajuta <b>„Logi sisse"</b> - see kinnitab su e-posti ja viib su valikute juurde.
            Link kehtib 30 minutit.
          </p>
          <p class="pm-tiny" style="margin-top:10px">
            Küsime kinnitust, et keegi teine ei saaks su e-postiga teavitusi tellida. See on ühekordne samm.
          </p>
          <div class="pm-waitline"><span class="pm-pulse" aria-hidden="true"></span> Ootame, et sa lingile vajutaksid…</div>
          <div class="pm-note">
            <span aria-hidden="true">✉️</span>
            <div>Kiri tuleb aadressilt <b>info@mikrokvalifikatsioon.ee</b>. Ei näe seda? Vaata rämpsposti kausta.</div>
          </div>
          <div class="pm-backrow">
            <button type="button" class="pm-link" data-resend>Saada link uuesti</button>
            <span style="color:var(--pm-line)" aria-hidden="true">·</span>
            <button type="button" class="pm-link" data-change-email>Muuda e-posti</button>
          </div>
          <div class="pm-backrow bridge-note" style="margin-top:8px">
            <button type="button" class="pm-btn pm-btn-ghost" data-demo-login>Mul on link - ava konto (demo) →</button>
          </div>
        </div>
      </section>

      <!-- ============ EKRAAN E — sisse logitud: Minu konto ============ -->
      <!-- STATE s3: saavutus + "mis nüüd?". VASTUS: kinnita (hoitud), orienteeri (3 kogumit), paku järgmine samm. -->
      <section class="pm-wrap pm-screen" data-screen="account" hidden aria-labelledby="acctH">
        <div class="pm-rise">
          <div class="pm-account-bar" style="margin-bottom:8px">
            <div class="pm-welcome">
              <div class="ring" aria-hidden="true">✓</div>
              <div>
                <div class="pm-eyebrow" style="margin:0">Sa oled sees</div>
                <h1 id="acctH" style="font-size:clamp(27px,4vw,38px);margin:2px 0 0">Sinu valikud on <em>hoitud.</em></h1>
              </div>
            </div>
            <button type="button" class="pm-btn pm-btn-ghost" data-logout>Logi välja</button>
          </div>
          <p class="pm-account-email" data-account-email></p>
          <p class="pm-lede" style="margin:14px 0 0">
            Kõik ühes kohas - see on nüüd sinu koht, kuhu tagasi tulla. Vali, mis sind kõige rohkem huvitab.
          </p>

          <p class="pm-banner bridge" data-bridge-banner>
            <strong>Demorežiim.</strong> Su konto seisund (paketid, teavitused, profiil) elab praegu
            ainult selles brauseris. Tootmises hoiab seda AMOS, et see oleks kõigis seadmetes sama.
          </p>

          <!-- 3 kogumit: Minu oskused / Minu programmid / Minu võrdlused -->
          <div class="pm-tabs" role="tablist" aria-label="Minu kogumid">
            <button class="pm-tabbtn on" role="tab" id="tab-osk" aria-selected="true" aria-controls="pane-osk" data-tab="osk">
              Minu oskused <span class="cnt" data-count-osk>0</span>
            </button>
            <button class="pm-tabbtn" role="tab" id="tab-prog" aria-selected="false" aria-controls="pane-prog" data-tab="prog">
              Minu programmid <span class="cnt" data-count-prog>0</span>
            </button>
            <button class="pm-tabbtn" role="tab" id="tab-cmp" aria-selected="false" aria-controls="pane-cmp" data-tab="cmp">
              Minu võrdlused <span class="cnt" data-count-cmp>0</span>
            </button>
          </div>

          <!-- KOGUM 1 — Minu oskused (kaalukontroll + vaste + jälgime-seisund) -->
          <div class="pm-pane on" id="pane-osk" role="tabpanel" aria-labelledby="tab-osk" data-feature="packages">
            <p class="pm-paneintro">
              Need on oskused, mille <b>sina</b> valisid. Sea igaühe tähtsus (klõpsa täppe) - me sätime
              programmid selle järgi. Oskus, millele veel programmi ei ole, jääb samuti alles - jälgime ja
              anname teada.
            </p>
            <div data-skills-body></div>
            <div data-packages-body hidden></div>
            <div class="pm-match" data-best-match hidden>
              <div class="k">Sinu tähtsuste järgi - parim vaste praegu</div>
              <div class="v" data-best-match-name></div>
              <div class="pm-fit"><i data-best-match-bar style="width:0%"></i></div>
              <small class="pm-tiny" data-best-match-meta></small>
            </div>
            <div class="pm-backrow" style="justify-content:flex-start;margin-top:18px" data-packages-empty-actions hidden>
              <a class="pm-btn pm-btn-primary" style="width:auto" href="/oskused/" data-track-event="cta_click" data-track-label="account_to_oskused">
                Ava oskuste leht →
              </a>
            </div>
          </div>

          <!-- KOGUM 2 — Minu programmid (prioriteet + sobivuse riba) -->
          <div class="pm-pane" id="pane-prog" role="tabpanel" aria-labelledby="tab-prog" data-feature="programmes">
            <p class="pm-paneintro">
              Programmid, mis su oskustele kõige lähemal on. Sea järjekord noolte abil - tähtsaim üleval.
              Number näitab su prioriteeti; riba näitab, kui suure osa su oskustest see katab.
            </p>
            <div data-progs-body></div>
            <p class="pm-empty" data-progs-empty hidden>
              Su oskustele pole praegu veel ühtegi programmi vastet. Hoiame oskused alles ja anname märku,
              kui sobiv lisandub.
            </p>
          </div>

          <!-- KOGUM 3 — Minu võrdlused -->
          <div class="pm-pane" id="pane-cmp" role="tabpanel" aria-labelledby="tab-cmp" data-feature="compares">
            <p class="pm-paneintro">
              Võrdlused, mille sa salvestasid. Ava ja vaata programme kõrvuti - hind, maht, õpiväljundid.
            </p>
            <div data-compares-body></div>
            <a class="pm-addbtn" href="/mikrokvalifikatsioonide-vordlus/" data-track-event="cta_click" data-track-label="account_to_vordlus">
              ＋ Lisa uus võrdlus
            </a>
          </div>

          <!-- Konto-haldus: meeldetuletused, teavitused, profiil, nõusolek -->
          <!-- MINU TELLIMUSED — ülevaade, millele oled tellinud teavitusi. -->
          <section class="pm-acc-block" data-feature="subs" aria-labelledby="subsH">
            <h3 id="subsH">Minu tellimused</h3>
            <p class="pm-paneintro">
              Siit näed, millele oled teavitused tellinud - valdkonnad, oskused, kombinatsioonid ja
              tähtaja-meeldetuletused. Saad iga tellimuse siit ka maha võtta.
            </p>
            <div data-subs-list></div>
            <p class="pm-tiny" style="margin-top:10px">
              Tellimusi saad hallata ja maha võtta siin lehel, samuti iga e-kirja jaluse loobumislingiga.
            </p>
          </section>

          <!-- FEATURE 2 — Tähtaja-meeldetuletused -->
          <section class="pm-acc-block" data-feature="reminders" aria-labelledby="remH">
            <h3 id="remH">Tähtaja-meeldetuletused</h3>
            <p class="pm-paneintro">
              Anname e-postiga märku enne, kui mõne sind huvitava programmi registreerimine lõpeb -
              et sa ei jääks tähtajast ilma ja saaksid soovi korral toetust õigel ajal taotleda.
            </p>
            <label class="pm-acc-toggle">
              <input type="checkbox" data-reminders-toggle />
              <span><strong>Tuleta mulle tähtaegu meelde.</strong> Saadame meilini 7 päeva ja 1 päev enne registreerimise lõppu.</span>
            </label>
            <p class="pm-status" data-reminders-status hidden></p>
            <div data-reminders-list></div>
            <p class="pm-tiny" style="margin-top:10px">
              Meeldetuletused käivad su nõusoleku alusel. Saad need siit igal ajal välja lülitada.
              Kuupäevad pärinevad koolide avalikelt lehtedelt ja võivad muutuda - lõplik tähtaeg on alati kooli lehel.
            </p>
          </section>

          <!-- FEATURE 3 — Teavituslehed (valdkond / oskus / KOMBINATSIOON) -->
          <section class="pm-acc-block" data-feature="notify" aria-labelledby="notifyH">
            <h3 id="notifyH">Teavita mind, kui sobiv lisandub</h3>
            <p class="pm-paneintro">
              Ütle, mis valdkond, oskus või oskuste kombinatsioon sind huvitab. Kui sellele lähedane
              programm või kombinatsioon kataloogi lisandub, anname esimesena märku - sa ei pea ise
              pidevalt kontrollima.
            </p>

            <div class="pm-combo-prompt" data-combo-prompt hidden>
              <p data-combo-text></p>
              <button type="button" class="pm-mini" data-combo-subscribe>Teavita, kui see kombinatsioon lisandub</button>
            </div>

            <div class="pm-field">
              <label for="notifyField">Valdkonna järgi</label>
              <select id="notifyField" class="pm-select" data-notify-field>
                <option value="">Vali valdkond</option>
                {/* value = valdkonna SLUG (kanooniline target_ref, nt "it-ja-andmed"),
                    nähtav tekst = inimkeelne silt. Slug saadetakse /subscriptions'ile. */}
                {fieldsWithSlug.map(({ field, slug }) => <option value={slug}>{field}</option>)}
              </select>
            </div>
            <div class="pm-backrow" style="justify-content:flex-start;margin-top:12px">
              <button type="button" class="pm-mini" data-notify-field-add>Lisa teavituslehte</button>
            </div>

            <div data-skill-chips hidden>
              <p class="pm-tiny" style="margin-top:14px">Oskuse järgi (su paketist):</p>
              <div class="pm-chip-row" data-skill-chip-row></div>
            </div>

            <p class="pm-status" data-notify-status hidden></p>
            <div data-notify-list></div>

            <p class="pm-tiny pm-embargo-foot">
              Me ei luba ega lubа kindlat programmi - kogume huvi, et näha, mille järele nõudlust on.
              Kui sobiv lahendus lisandub, saad teate.
            </p>
          </section>

          <!-- FEATURE 4 — Toetuse profiil -->
          <section class="pm-acc-block" data-feature="funding" aria-labelledby="fundH">
            <h3 id="fundH">Kuidas õpinguid rahastada</h3>
            <p class="pm-paneintro">
              Märgi, kuidas sa tõenäoliselt õpinguid maksad - siis näitame sulle just sinu teele sobivad
              sammud ja teavitused, et sa ei jätaks toetust kasutamata.
            </p>
            <div class="pm-funding-options">
              <label class="pm-acc-toggle">
                <input type="radio" name="funding_route" value="ise" data-funding />
                <span><strong>Maksan ise.</strong> Näitame hinda ja võimalikku tasuvust - millal kulu end tagasi teenib.</span>
              </label>
              <label class="pm-acc-toggle">
                <input type="radio" name="funding_route" value="tootukassa" data-funding />
                <span><strong>Töötukassa kaudu.</strong> Anname märku programmidest, mille puhul Töötukassa toetus võib kõne alla tulla. Lõpliku otsuse teeb alati Töötukassa.</span>
              </label>
              <label class="pm-acc-toggle">
                <input type="radio" name="funding_route" value="tooandja" data-funding />
                <span><strong>Tööandja maksab.</strong> Koondame info, mille saad tööandjale esitada - maht, hind, mida pärast oskad.</span>
              </label>
            </div>
            <p class="pm-status" data-funding-status hidden></p>
            <p class="pm-tiny" style="margin-top:8px">
              See on sinu enda hinnang ega ole siduv - toetuse otsustab vastav asutus.
              Rahastuse ja toetuse küsimustes aitab ka
              <a href="https://digiteekaart.ee/" data-track-event="partner_site_click" data-track-label="account_funding_digiteekaart" rel="noopener" style="color:var(--pm-green-deep);font-weight:700">digiteekaart.ee</a>.
