---
import Seo from "../../components/Seo.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/global.css";
import { catalog } from "../../data/catalog";
import { fields } from "../../data/catalog";

// ============================================================================
// Minu konto — mkval ET face (account-MVP).
//
// ARHITEKTUUR (konsolideerimise külmutus): see on ÕHUKE NÄGU. Kogu isiku-
// tuvastus, nõusoleku-pearaamat, paketihoidla ja meeldetuletuste ajastus
// elavad AMOS-is. See leht hoiab ainult lühiajalist seansimärki ja anonüümset
// localStorage'i, mille ta migreerib üles. Konto-loogikat siia ei ehita.
//
// STAATILINE DEMO/SILD: apex jääb output:"static", seega /konto/ on staatilised
// lehed + kliendipoolne loogika. TOOTMISES kolib see eraldi SSR-alamdomeenile
// (konto.mikrokvalifikatsioon.ee), kus magic-link'i kinnitus (HMAC confirm-token)
// ja /konto/state · /konto/migrate · /konto/delete elavad AMOS-is. Kuni selleni
// on KONTO-SEISUND SILLATUD union-merge'itud localStorage'ist (vt allpool
// "BRIDGE" kommentaare). Iga sild on UI-märkega ja koodikommentaariga tähistatud.
//
// LIVE PIPE: e-postide korje läheb POST /api/subscribe → AMOS sissevool
// (double-opt-in, consent_purpose course_offers). Paketi salvestamine kasutab
// olemasolevat kind "outcome_package" (mis päriselt jõuab AMOS-i juba täna).
// Uued kontospõhised kinnid (account_create, reminder_subscribed,
// funding_profile_set, notify_list/combo_waitlist) on AMOS-i lepingus VEEL
// defineerimata → need on serverile saadetud "parima püüdega" ja kuni
// backend kinnitab, käituvad sillana (UI ei luba midagi, mida pole).
// ============================================================================

const SITE = "https://mikrokvalifikatsioon.ee";

// Programmide indeks (slug → metaandmed) — sama kuju kui /oskused/, et
// fit-mootor (amos.outcome.fit/v1) saaks kontol paketi katvust arvutada.
const progIndex: Record<string, { name: string; provider: string; ects: number | null; price: string | null; field: string; registrationDeadline: string | null }> = {};
for (const e of catalog) {
  progIndex[e.slug] = {
    name: e.name,
    provider: e.provider,
    ects: e.ects ?? null,
    price: e.priceText ?? null,
    field: e.field,
    registrationDeadline: e.registrationDeadline ?? null,
  };
}
const progJson = JSON.stringify(progIndex).replace(/</g, "\\u003c");

// Tähtajad sildi-loogika jaoks (slug → registreerimistähtaeg ISO).
const fieldList = fields.filter((f) => f !== "muu");

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Organization", "@id": `${SITE}/#organization`, name: "Mikrokvalifikatsioon.ee", legalName: "Ettevõtluskeskus OÜ", url: `${SITE}/` },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Avaleht", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Minu konto", item: `${SITE}/konto/` }
      ]
    }
  ]
};
---

<!doctype html>
<html lang="et">
  <head>
    <Seo
      title="Minu konto — hoia oma oskuste pakett alles"
      description="Loo konto: hoiame su valitud oskuste paketi alles ja anname märku, kui sobiv programm, kombinatsioon või registreerimise tähtaeg lisandub. Parooli pole vaja — saadame sisselogimislingi e-postiga."
      canonicalPath="/konto/"
      robots="noindex,follow"
      jsonLd={schema}
    />
  </head>
  <body>
    <Nav />

    <main class="report-page simple-report" data-konto-root>
      <!-- ============ EKRAAN B — välja logitud: Loo konto / Logi sisse ============ -->
      <section class="report-hero simple-report-hero" data-screen="auth">
        <div class="section-inner">
          <nav class="crumbs" aria-label="Asukoht">
            <a href="/">Avaleht</a> › <span>Minu konto</span>
          </nav>
          <span class="eyebrow">Minu konto</span>
          <h1>Minu konto</h1>
          <p>
            Üks koht, kus su valitud oskuste pakett püsib alles ja kus saad õigel ajal teada sobivast
            programmist, kombinatsioonist või lähenevast tähtajast. Parooli pole vaja — saadame sulle
            turvalise sisselogimislingi e-postiga.
          </p>
        </div>
      </section>

      <section class="white" data-screen="auth" data-tool-section="konto-login">
        <div class="section-inner narrow">
          <div class="anon-banner" data-anon-banner hidden></div>

          <form class="lead-form" data-auth-form data-site-lead-form data-source-site="mikrokvalifikatsioon.ee">
            <div class="form-grid">
              <div class="field full">
                <label for="kontoEmail">E-post</label>
                <input id="kontoEmail" name="email" type="email" required autocomplete="email" placeholder="sinu@email.ee" />
              </div>
            </div>
            <label class="checkbox" data-consent-row>
              <input type="checkbox" name="consent" data-consent />
              <span>
                Nõustun, et Ettevõtluskeskus OÜ saadab mulle teavitused sobivatest programmidest,
                kombinatsioonidest ja tähtaegadest. Saan nõusoleku igal ajal tagasi võtta (iga kirja
                jaluses on loobumislink). Vaata <a href="/privaatsus/">privaatsust</a>.
              </span>
            </label>
            <p class="field-error" data-auth-error hidden></p>
            <div class="inline-actions">
              <button class="btn btn-primary" type="submit" data-auth-submit>Saada mulle sisselogimislink</button>
            </div>
            <p class="form-note">
              Kui sul on juba konto, saadame lingi sisselogimiseks. Kui veel pole, loome konto.
            </p>
          </form>
        </div>
      </section>

      <!-- ============ EKRAAN C — pärast saatmist: Kontrolli e-posti ============ -->
      <section class="white" data-screen="check" hidden>
        <div class="section-inner narrow">
          <div class="card check-card">
            <h2>Kontrolli oma e-posti</h2>
            <p>
              Saatsime lingi aadressile <strong data-check-email>su e-postile</strong>. Ava e-kiri ja
              vajuta „Logi sisse" — see kinnitab su e-posti ja viib su kontole. Link kehtib 30 minutit.
            </p>
            <p class="field-help">
              Küsime kinnitust, et keegi teine ei saaks su e-postiga teavitusi tellida. See on ühekordne samm.
            </p>
            <div class="inline-actions">
              <button type="button" class="btn btn-primary" data-resend>Saada link uuesti</button>
              <button type="button" class="btn btn-secondary" data-change-email>Muuda e-posti</button>
            </div>
            <p class="form-note">
              Ei näe kirja? Vaata rämpsposti kausta. Kiri tuleb aadressilt info@mikrokvalifikatsioon.ee.
            </p>
            <p class="form-note bridge-note">
              <strong>Märkus:</strong> see on demo-sild. Tootmises saadab AMOS sulle päris sisselogimislingi
              (magic-link). Praegu saad oma konto kohe avada nupust „Ava konto kohe (demo)".
            </p>
            <div class="inline-actions">
              <button type="button" class="btn btn-secondary" data-demo-login>Ava konto kohe (demo)</button>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ EKRAAN E — sisse logitud: Minu konto ============ -->
      <section class="white" data-screen="account" hidden>
        <div class="section-inner narrow">
          <div class="account-bar">
            <div>
              <span class="kicker">Minu konto</span>
              <p class="account-email" data-account-email></p>
            </div>
            <button type="button" class="btn btn-secondary" data-logout>Logi välja</button>
          </div>

          <p class="bridge-banner" data-bridge-banner>
            <strong>Demorežiim.</strong> Su konto seisund (paketid, teavitused, profiil) elab praegu
            ainult selles brauseris. Tootmises hoiab seda AMOS, et see oleks kõigis seadmetes sama.
          </p>

          <!-- FEATURE 1 — Minu oskuste paketid -->
          <article class="acc-card" data-feature="packages">
            <h2>Minu oskuste paketid</h2>
            <p class="payback">
              Hoiame su valitud oskused alles ja näitame, milline programm või kombinatsioon neile
              kõige lähemal on. Nii ei pea sa otsima uuesti.
            </p>
            <div data-packages-body></div>
            <div class="inline-actions" data-packages-empty-actions hidden>
              <a class="btn btn-primary" href="/oskused/" data-track-event="cta_click" data-track-label="account_to_oskused">Ava oskuste leht</a>
            </div>
          </article>

          <!-- FEATURE 2 — Tähtaja-meeldetuletused -->
          <article class="acc-card" data-feature="reminders">
            <h2>Tähtaja-meeldetuletused</h2>
            <p class="payback">
              Anname e-postiga märku enne, kui mõne sind huvitava programmi registreerimine lõpeb —
              et sa ei jääks tähtajast ilma ja saaksid soovi korral toetust õigel ajal taotleda.
            </p>
            <label class="acc-toggle">
              <input type="checkbox" data-reminders-toggle />
              <span><strong>Tuleta mulle tähtaegu meelde.</strong> Saadame meilini 7 päeva ja 1 päev enne registreerimise lõppu.</span>
            </label>
            <p class="acc-status" data-reminders-status hidden></p>
            <div data-reminders-list></div>
            <p class="field-help">
              Meeldetuletused käivad su nõusoleku alusel. Saad need siit igal ajal välja lülitada.
            </p>
            <p class="field-help">
              Kuupäevad pärinevad koolide avalikelt lehtedelt ja võivad muutuda — lõplik tähtaeg on alati kooli lehel.
            </p>
          </article>

          <!-- FEATURE 3 — Teavituslehed (valdkond / oskus / KOMBINATSIOON) -->
          <article class="acc-card" data-feature="notify">
            <h2>Teavita mind, kui sobiv lisandub</h2>
            <p class="payback">
              Ütle, mis valdkond, oskus või oskuste kombinatsioon sind huvitab. Kui sellele lähedane
              programm või kombinatsioon kataloogi lisandub, anname esimesena märku — sa ei pea ise
              pidevalt kontrollima.
            </p>

            <div class="notify-combo" data-combo-prompt hidden>
              <p data-combo-text></p>
              <button type="button" class="btn btn-secondary" data-combo-subscribe>Teavita, kui see kombinatsioon lisandub</button>
            </div>

            <div class="form-grid notify-row">
              <div class="field full">
                <label for="notifyField">Valdkonna järgi</label>
                <select id="notifyField" data-notify-field>
                  <option value="">Vali valdkond</option>
                  {fieldList.map((f) => <option value={f}>{f}</option>)}
                </select>
              </div>
            </div>
            <div class="inline-actions">
              <button type="button" class="btn btn-secondary" data-notify-field-add>Lisa teavituslehte</button>
            </div>

            <div data-skill-chips hidden>
              <p class="field-help">Oskuse järgi (su paketist):</p>
              <div class="chip-row" data-skill-chip-row></div>
            </div>

            <p class="acc-status" data-notify-status hidden></p>
            <div data-notify-list></div>

            <p class="field-help embargo-foot">
              Me ei luba ega lubа kindlat programmi — kogume huvi, et näha, mille järele nõudlust on.
              Kui sobiv lahendus lisandub, saad teate.
            </p>
          </article>

          <!-- FEATURE 4 — Toetuse profiil -->
          <article class="acc-card" data-feature="funding">
            <h2>Kuidas õpinguid rahastada</h2>
            <p class="payback">
              Märgi, kuidas sa tõenäoliselt õpinguid maksad — siis näitame sulle just sinu teele sobivad
              sammud ja teavitused, et sa ei jätaks toetust kasutamata.
            </p>
            <div class="funding-options">
              <label class="acc-toggle">
                <input type="radio" name="funding_route" value="ise" data-funding />
                <span><strong>Maksan ise.</strong> Näitame hinda ja võimalikku tasuvust — millal kulu end tagasi teenib.</span>
              </label>
              <label class="acc-toggle">
                <input type="radio" name="funding_route" value="tootukassa" data-funding />
                <span><strong>Töötukassa kaudu.</strong> Anname märku programmidest, mille puhul Töötukassa toetus võib kõne alla tulla. Lõpliku otsuse teeb alati Töötukassa.</span>
              </label>
              <label class="acc-toggle">
                <input type="radio" name="funding_route" value="tooandja" data-funding />
                <span><strong>Tööandja maksab.</strong> Koondame info, mille saad tööandjale esitada — maht, hind, mida pärast oskad.</span>
              </label>
            </div>
            <p class="acc-status" data-funding-status hidden></p>
            <p class="field-help">
              See on sinu enda hinnang ega ole siduv — toetuse otsustab vastav asutus.
            </p>
            <p class="field-help">
              Rahastuse ja toetuse küsimustes aitab ka <a href="https://digiteekaart.ee/" data-track-event="partner_site_click" data-track-label="account_funding_digiteekaart" rel="noopener">digiteekaart.ee</a>.
            </p>
          </article>

          <!-- FEATURE 5 — Nõusolek & andmed -->
          <article class="acc-card" data-feature="consent">
            <h2>Sinu nõusolek ja andmed</h2>
            <p class="payback">Sa otsustad, mida me sulle saadame ja kui kaua su andmeid hoiame.</p>
            <div class="inline-actions consent-actions">
              <button type="button" class="btn btn-secondary" data-consent-withdraw>Võta teavituste nõusolek tagasi</button>
              <button type="button" class="btn btn-secondary" data-data-download>Lae alla minu andmed</button>
              <button type="button" class="btn btn-secondary" data-account-delete>Kustuta konto ja kõik andmed</button>
            </div>
            <p class="acc-status" data-consent-status hidden></p>
            <p class="field-help">
              Sul on õigus küsida, mis andmeid hoiame, lasta neid parandada või kustutada. Kirjuta
              info@mikrokvalifikatsioon.ee — vastame ühe tööpäeva jooksul.
            </p>
          </article>
        </div>
      </section>
    </main>

    <Footer label="Minu konto" />

    <!-- Kinnitusdialoog (kustutamine / kombinatsioon jne) -->
    <div class="konto-modal" data-modal hidden>
      <div class="konto-modal-card" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
        <h3 id="modalTitle" data-modal-title></h3>
        <p data-modal-body></p>
        <div class="inline-actions">
          <button type="button" class="btn btn-primary" data-modal-confirm></button>
          <button type="button" class="btn btn-secondary" data-modal-cancel>Loobu</button>
        </div>
      </div>
    </div>

    <!-- Lühike toast-teade -->
    <div class="konto-toast" data-toast hidden></div>

    <script type="application/json" id="prog-data" is:inline set:html={progJson} />

    <style>
      .crumbs { font-size: 0.85rem; color: #5a6b80; margin-bottom: 12px; }
      .crumbs a { color: #5a6b80; }
      .crumbs span { color: #212121; }
      [data-screen][hidden] { display: none; }

      .anon-banner {
        background: #eef4ee; border: 1px solid #cfe0cf; border-radius: 10px;
        padding: 14px 16px; margin-bottom: 18px; color: #2f5530; font-size: 0.95rem;
      }
      .anon-banner[hidden] { display: none; }

      .checkbox a { color: var(--teal); font-weight: 700; }
      .field-error { margin: 10px 0 0; color: #a11; font-size: 0.9rem; font-weight: 700; }
      .field-error[hidden] { display: none; }

      .check-card h2 { color: var(--navy); margin-bottom: 10px; }
      .bridge-note { border-top: 1px dashed var(--line); padding-top: 12px; }

      /* Konto (Ekraan E) */
      .account-bar {
        display: flex; justify-content: space-between; align-items: center; gap: 16px;
        flex-wrap: wrap; margin-bottom: 16px;
      }
      .account-bar .btn { width: auto; }
      .account-email { margin: 4px 0 0; font-weight: 800; color: #212121; }
      .bridge-banner {
        background: #fff7e6; border: 1px solid #f0dca8; border-radius: 10px;
        padding: 12px 14px; color: #6b4e00; font-size: 0.92rem; margin: 0 0 20px;
      }

      .acc-card {
        background: #fff; border: 1px solid var(--line); border-radius: 12px;
        padding: 22px; margin-bottom: 18px; box-shadow: var(--shadow);
      }
      .acc-card h2 { color: var(--navy); font-size: 1.35rem; margin-bottom: 6px; }
      .payback { color: var(--muted); margin: 0 0 14px; }

      .acc-toggle {
        display: flex; gap: 12px; align-items: flex-start; padding: 12px 0;
        color: #212121; font-size: 0.97rem; cursor: pointer;
      }
      .acc-toggle input { width: 22px; min-height: 22px; margin-top: 2px; flex: 0 0 auto; }
      .acc-toggle span strong { color: #212121; }
      .funding-options { display: grid; gap: 4px; margin-bottom: 6px; }

      .acc-status {
        margin: 8px 0 0; padding: 9px 12px; border-radius: 8px; font-size: 0.92rem; font-weight: 700;
        background: #eef4ee; color: #2f6b2c;
      }
      .acc-status[hidden] { display: none; }
      .acc-status.is-error { background: #ffe0e0; color: #a11; }

      .acc-empty { color: var(--muted); margin: 0 0 12px; }

      .pkg-card {
        border: 1px solid var(--line); border-radius: 10px; padding: 14px 16px; margin-bottom: 12px;
        background: #fbfdfb;
      }
      .pkg-card-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; }
      .pkg-card-name { font-weight: 800; color: #212121; margin: 0; }
      .pkg-card-name input { font-weight: 800; max-width: 280px; min-height: 38px; }
      .chip-row { display: flex; flex-wrap: wrap; gap: 6px; margin: 10px 0; }
      .chip {
        display: inline-flex; align-items: center; gap: 6px; background: #eef4ee; color: #2f5530;
        border: 1px solid #cfe0cf; border-radius: 999px; padding: 3px 11px; font-size: 0.84rem; font-weight: 700;
      }
      .chip button { background: none; border: 0; color: #2f5530; cursor: pointer; font-size: 0.95rem; padding: 0; line-height: 1; }
      .pkg-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
      .btn-mini {
        width: auto; min-height: 38px; padding: 7px 13px; font-size: 0.86rem; border-radius: 8px;
        background: #fff; color: var(--teal); border: 1px solid var(--teal); font-weight: 800; cursor: pointer;
      }
      .btn-mini.neutral { color: var(--muted); border-color: var(--line); }

      .pm-match { background: #f3f6f3; border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; margin-top: 10px; }
      .pm-match[hidden] { display: none; }
      .pm-best a, .pm-combo a { color: var(--teal); font-weight: 700; }
      .pm-prov { color: var(--muted); font-weight: 400; font-size: 0.88rem; }
      .cov { display: inline-block; background: #eef4ee; color: #2f6b2c; border-radius: 999px; padding: 1px 9px; font-size: 0.78rem; font-weight: 700; }
      .pm-combo { margin: 0; padding-left: 20px; display: grid; gap: 4px; }
      .pm-note { margin: 10px 0 0; font-size: 0.9rem; color: var(--muted); }
      .pm-good { color: #2f6b2c; font-weight: 700; }
      .pm-h2 { margin: 12px 0 5px; font-weight: 700; color: #212121; }

      .reminder-row, .notify-item {
        display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap;
        border: 1px solid var(--line); border-radius: 10px; padding: 11px 14px; margin-top: 8px; background: #fff;
      }
      .reminder-row a, .notify-item a { color: var(--teal); font-weight: 700; }
      .reminder-meta { color: var(--muted); font-size: 0.88rem; }
      .dl-badge { display: inline-block; margin-left: 6px; padding: 1px 8px; border-radius: 999px; font-size: 0.76rem; font-weight: 800; }
      .dl-badge.soon { background: #fff1cc; color: #815900; }
      .dl-badge.today { background: #ffe0e0; color: #a11; }
      .dl-badge.past { background: #eceef0; color: #5f6569; }

      .notify-combo {
        background: #eef4ee; border: 1px solid #cfe0cf; border-radius: 10px; padding: 14px 16px; margin-bottom: 14px;
      }
      .notify-combo[hidden] { display: none; }
      .notify-combo p { margin: 0 0 10px; color: #2f5530; }
      .notify-combo .btn { width: auto; }
      .notify-row { margin-top: 6px; }
      .skill-chip {
        background: #fff; border: 1px solid var(--teal); color: var(--teal); border-radius: 999px;
        padding: 5px 12px; font-size: 0.82rem; font-weight: 700; cursor: pointer;
      }
      .embargo-foot { border-top: 1px dashed var(--line); padding-top: 12px; margin-top: 14px; }
      .consent-actions .btn { width: auto; }

      /* Modal + toast */
      .konto-modal {
        position: fixed; inset: 0; z-index: 80; display: flex; align-items: center; justify-content: center;
        padding: 20px; background: rgba(33,33,33,0.5);
      }
      .konto-modal[hidden] { display: none; }
      .konto-modal-card {
        background: #fff; border-radius: 14px; padding: 26px; max-width: 460px; width: 100%;
        box-shadow: 0 24px 60px rgba(0,0,0,0.3);
      }
      .konto-modal-card h3 { color: var(--navy); margin-bottom: 10px; }
      .konto-modal-card p { color: var(--muted); margin: 0 0 8px; }
      .konto-modal-card .btn { width: auto; }
      .konto-toast {
        position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); z-index: 90;
        background: #212121; color: #fff; padding: 12px 18px; border-radius: 10px; font-weight: 700;
        box-shadow: 0 18px 46px rgba(33,33,33,0.3); max-width: calc(100% - 32px);
      }
      .konto-toast[hidden] { display: none; }

      @media (max-width: 640px) {
        .account-bar { flex-direction: column; align-items: flex-start; }
      }
    </style>

    <script>
      import { computeFit, type CoverageRow } from "../../lib/outcome-fit";
      import { formatEt } from "../../data/dates";

      // ====================================================================
      // KONTO STATE-MACHINE (kliendipoolne; üks <script>).
      //
      // BRIDGE: kogu konto-seisund elab praegu localStorage'is võtme all
      // "mkval:account". TOOTMISES asendab selle AMOS (/konto/state +
      // /konto/migrate). Iga koht, kus me LOEME/KIRJUTAME seda silda, on
      // märgitud kommentaariga "BRIDGE:".
      // ====================================================================

      type PkgItem = { key: string; text: string; progs?: string[] };
      type AccountPackage = { id: string; name: string; items: PkgItem[] };
      type FundingRoute = "ise" | "tootukassa" | "tooandja" | null;
      type AccountState = {
        email: string;
        consent: boolean;            // course_offers nõusolek (double-opt-in kinnitatud sild)
        packages: AccountPackage[];
        interests: string[];         // jälgitavad programmi-slugid (mkval:interest:<slug>)
        notifyFields: string[];      // valdkonna-teavituslehed
        notifySkills: string[];      // oskuse-teavituslehed (õpiväljundi tekst)
        comboWaitlist: string[];     // kombinatsiooni-teavitused (võti = sorditud oskuste liit)
        reminders: boolean;
        funding_route: FundingRoute;
      };

      const PKG_KEY = "mkval:pakett";
      const ACCOUNT_KEY = "mkval:account";        // BRIDGE: AMOS-i konto-seisundi sild
      const INTEREST_RE = /^mkval:interest:(.+)$/;

      const track = (n: string, p: Record<string, unknown> = {}) => (window as any).digiteekaartTrack?.(n, p);
      const $ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => r.querySelector(s) as T | null;
      const $$ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => [...r.querySelectorAll(s)] as T[];

      // ---- Programmide indeks (slug → metaandmed) -----------------------
      let PROG: Record<string, { name: string; provider: string; ects: number | null; price: string | null; field: string; registrationDeadline: string | null }> = {};
      try { PROG = JSON.parse($("#prog-data")?.textContent || "{}"); } catch { PROG = {}; }
      const parsePriceEur = (priceText: string | null): number | null => {
        if (typeof priceText !== "string") return null;
        const m = priceText.replace(/ /g, " ").match(/\d[\d\s]*/);
        if (!m) return null;
        const n = Number(m[0].replace(/\s/g, ""));
        return Number.isFinite(n) && n > 0 ? n : null;
      };
      const escHtml = (s: string) => s.replace(/[&<>"]/g, (c) => (({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }) as Record<string, string>)[c] || c);

      // ---- localStorage helperid ----------------------------------------
      const readPkg = (): PkgItem[] => { try { return JSON.parse(localStorage.getItem(PKG_KEY) || "[]"); } catch { return []; } };
      const readInterestSlugs = (): string[] => {
        const out: string[] = [];
        try {
          for (let i = 0; i < localStorage.length; i++) {
            const k = localStorage.key(i);
            const m = k && INTEREST_RE.exec(k);
            if (m) out.push(m[1]);
          }
        } catch { /* private mode */ }
        return out;
      };
      // BRIDGE: loe/kirjuta konto-seisund localStorage'ist (AMOS asendab selle).
      const readAccount = (): AccountState | null => {
        try { const raw = localStorage.getItem(ACCOUNT_KEY); return raw ? JSON.parse(raw) : null; } catch { return null; }
      };
      const writeAccount = (s: AccountState): void => {
        try { localStorage.setItem(ACCOUNT_KEY, JSON.stringify(s)); } catch { /* private mode */ }
      };
      const clearAccount = (): void => { try { localStorage.removeItem(ACCOUNT_KEY); } catch { /* ignore */ } };

      // ---- LIVE pipe: e-postide korje AMOS-i (api/subscribe) -------------
      // outcome_package on AMOS-i lepingus OLEMAS → jõuab päriselt kohale
      // (double-opt-in, course_offers). Uued account-kinnid on lepingus VEEL
      // defineerimata; saadame need samasse torusse "parima püüdega" ja
      // ei sõltu nende edust UI mõttes (sild ei luba midagi, mida pole).
      const postSubscribe = async (payload: Record<string, unknown>): Promise<boolean> => {
        try {
          const r = await fetch("/api/subscribe", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ source_site: "mikrokvalifikatsioon_ee", ...payload }),
          });
          return r.ok;
        } catch { return false; }
      };

      // ---- Toast + modal -------------------------------------------------
      let toastTimer: ReturnType<typeof setTimeout> | undefined;
      const toast = (msg: string): void => {
        const el = $("[data-toast]");
        if (!el) return;
        el.textContent = msg;
        el.hidden = false;
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => { el.hidden = true; }, 3200);
      };
      const confirmModal = (title: string, body: string, confirmLabel: string): Promise<boolean> =>
        new Promise((resolve) => {
          const modal = $("[data-modal]");
          if (!modal) { resolve(window.confirm(body)); return; }
          $("[data-modal-title]", modal)!.textContent = title;
          $("[data-modal-body]", modal)!.textContent = body;
          const okBtn = $("[data-modal-confirm]", modal) as HTMLButtonElement;
          okBtn.textContent = confirmLabel;
          modal.hidden = false;
          const done = (v: boolean) => { modal.hidden = true; okBtn.onclick = null; cancelBtn.onclick = null; resolve(v); };
          const cancelBtn = $("[data-modal-cancel]", modal) as HTMLButtonElement;
          okBtn.onclick = () => done(true);
          cancelBtn.onclick = () => done(false);
        });

      const status = (sel: string, msg: string, isError = false): void => {
        const el = $(sel);
        if (!el) return;
        el.textContent = msg;
        el.classList.toggle("is-error", isError);
        el.hidden = false;
      };

      // ---- Ekraanide vahetus --------------------------------------------
      const showScreen = (name: "auth" | "check" | "account"): void => {
        $$("[data-screen]").forEach((s) => { s.hidden = s.getAttribute("data-screen") !== name; });
        window.scrollTo({ top: 0, behavior: "auto" });
      };

      // ====================================================================
      // EKRAAN B — Loo konto / Logi sisse
      // ====================================================================
      const anonBanner = $("[data-anon-banner]");
      const authForm = $("[data-auth-form]") as HTMLFormElement | null;
      const emailInput = $("#kontoEmail") as HTMLInputElement | null;
      const consentInput = $("[data-consent]") as HTMLInputElement | null;
      const authError = $("[data-auth-error]");

      const renderAnonBanner = (): void => {
        if (!anonBanner) return;
        const n = readPkg().length;
        const m = readInterestSlugs().length;
        if (n === 0 && m === 0) { anonBanner.hidden = true; return; }
        const parts: string[] = [];
        if (n) parts.push(`${n} salvestatud oskust`);
        if (m) parts.push(`${m} jälgitavat programmi`);
        anonBanner.innerHTML = `📦 Sul on selles brauseris ${parts.join(" ja ")}. Sisse logides toome need sinu kontole — midagi ei kao.`;
        anonBanner.hidden = false;
      };

      authForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (authError) authError.hidden = true;
        const email = (emailInput?.value || "").trim().toLowerCase();
        const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
        const existing = readAccount();
        const isReturning = !!existing && existing.email === email && existing.consent;
        // Nõusolek on uue konto loomiseks kohustuslik, olemasolevasse sisselogimiseks mitte.
        if (!emailOk) {
          if (authError) { authError.textContent = "Palun sisesta korrektne e-post."; authError.hidden = false; }
          return;
        }
        if (!consentInput?.checked && !isReturning) {
          if (authError) { authError.textContent = "Konto loomiseks pane palun linnuke nõusoleku juurde."; authError.hidden = false; }
          return;
        }

        const submitBtn = $("[data-auth-submit]") as HTMLButtonElement;
        submitBtn.disabled = true;
        const origLabel = submitBtn.textContent;
        submitBtn.textContent = "Saadan linki…";
        if (emailInput) emailInput.disabled = true;

        track("lead_form_submit_attempt", { form_name: "account", package_size: readPkg().length, interests: readInterestSlugs().length });

        // LIVE: kanna konto-loomise/sisselogimise soov AMOS-i torusse.
        // Paketi outcome'id ratsutavad outcome_package'iga (OLEMAS lepingus).
        // account_create on lepingus VEEL defineerimata → "parima püüdega".
        const pkg = readPkg();
        const delivery = await Promise.resolve().then(async () => {
          // 1) account_create signaal (bridged — AMOS-i leping ootab uut kindi)
          await postSubscribe({ kind: "account_create", email, consent_purpose: "course_offers", outcomes: pkg.map((i) => i.text) });
          // 2) Paketi outcome'id LIVE kindiga (jõuab AMOS-i juba täna)
          if (pkg.length) {
            const ok = await postSubscribe({ kind: "outcome_package", email, outcomes: pkg.map((i) => i.text) });
            return ok ? "webhook" : "mailto";
          }
          return "webhook";
        });

        track("lead_form_submit", { form_name: "account", delivery, package_size: pkg.length, interests: readInterestSlugs().length });
        track("account_created", { delivery, package_size: pkg.length });

        // BRIDGE: hoia soovitud e-post + nõusolek alles, et demo-login saaks
        // konto luua. TOOTMISES ei salvestaks me midagi enne magic-link'i klõpsu.
        sessionStorage.setItem("mkval:pending_email", email);
        sessionStorage.setItem("mkval:pending_consent", consentInput?.checked ? "1" : (isReturning ? "1" : "0"));

        submitBtn.disabled = false;
        submitBtn.textContent = origLabel;
        if (emailInput) emailInput.disabled = false;

        const checkEmailEl = $("[data-check-email]");
        if (checkEmailEl) checkEmailEl.textContent = email;
        showScreen("check");
      });

      // Track lead_form_start üks kord
      let leadStarted = false;
      authForm?.addEventListener("focusin", () => {
        if (leadStarted) return;
        leadStarted = true;
        track("lead_form_start", { form_name: "account" });
      });

      // ====================================================================
      // EKRAAN C — Kontrolli e-posti
      // ====================================================================
      let resendCooldown = 0;
      $("[data-resend]")?.addEventListener("click", () => {
        const btn = $("[data-resend]") as HTMLButtonElement;
        if (resendCooldown > 0) return;
        toast("Saatsime uue lingi.");
        resendCooldown = 30;
        const tick = () => {
          if (resendCooldown <= 0) { btn.disabled = false; btn.textContent = "Saada link uuesti"; return; }
          btn.disabled = true;
          btn.textContent = `Saada uuesti (saad ${resendCooldown} s pärast)`;
          resendCooldown -= 1;
          setTimeout(tick, 1000);
        };
        tick();
      });
      $("[data-change-email]")?.addEventListener("click", () => {
        if (emailInput) emailInput.value = sessionStorage.getItem("mkval:pending_email") || "";
        showScreen("auth");
      });

      // BRIDGE: demo-login asendab magic-link'i klõpsu. TOOTMISES jõuab kasutaja
      // siia /konto/kinnita?token=… kaudu, kus AMOS kinnitab double-opt-in'i.
      $("[data-demo-login]")?.addEventListener("click", () => {
        const email = sessionStorage.getItem("mkval:pending_email") || "";
        const consent = sessionStorage.getItem("mkval:pending_consent") === "1";
        if (!email) { showScreen("auth"); return; }
        const isNew = !readAccount();
        loginAndMigrate(email, consent);
        track("tool_completed", { tool_name: "account_login" });
        if (isNew) track("result_high_intent", { result_route: "account_create", form_name: "account_create" });
      });

      // ====================================================================
      // EKRAAN D-loogika (sild): login + lossless union-merge migratsioon.
      // (Eraldi leht /konto/kinnita/ teeb sama päris magic-link'i tokeniga.)
      // ====================================================================
      const blankState = (email: string, consent: boolean): AccountState => ({
        email, consent,
        packages: [], interests: [], notifyFields: [], notifySkills: [], comboWaitlist: [],
        reminders: false, funding_route: null,
      });

      const migrateInto = (state: AccountState): { movedOutcomes: number; movedProgs: number } => {
        // 1. PAKETID — union item .key järgi
        const localPkg = readPkg();
        let movedOutcomes = 0;
        if (localPkg.length) {
          let target = state.packages[state.packages.length - 1];
          if (!target) {
            target = { id: `pkg_${Date.now()}`, name: "Minu salvestatud pakett", items: [] };
            state.packages.push(target);
          }
          const have = new Set(target.items.map((i) => i.key));
          for (const it of localPkg) {
            if (have.has(it.key)) {
              // progs[] union olemasolevasse
              const ex = target.items.find((x) => x.key === it.key);
              if (ex) {
                const set = new Set([...(ex.progs || []), ...(it.progs || [])]);
                ex.progs = [...set];
              }
            } else {
              target.items.push({ key: it.key, text: it.text, progs: [...(it.progs || [])] });
              have.add(it.key);
              movedOutcomes += 1;
            }
          }
        }
        // 2. INTERESTS (per-programme notify) — union slug järgi
        const localInterests = readInterestSlugs();
        const interestSet = new Set([...state.interests, ...localInterests]);
        const before = state.interests.length;
        state.interests = [...interestSet];
        const movedProgs = state.interests.length - before;
        // 3. reminders/funding/consent — server (siin: olemasolev seisund) on tõeallikas;
        //    EI alanda kinnitatud nõusolekut puuduva localiga.
        return { movedOutcomes, movedProgs };
      };

      const loginAndMigrate = (email: string, consent: boolean): void => {
        // BRIDGE: AMOS-i /konto/state asemel loeme localStorage'ist.
        let state = readAccount();
        if (!state || state.email !== email) {
          state = state && state.email === email ? state : blankState(email, consent);
        }
        if (consent) state.consent = true;     // ära alanda kinnitatud nõusolekut
        const moved = migrateInto(state);
        // BRIDGE: AMOS-i /konto/migrate asemel kirjutame localStorage'i.
        writeAccount(state);
        // Migratsioon õnnestus (kirjutus läbi) → puhasta anonüümne local.
        if (moved.movedOutcomes || moved.movedProgs) {
          try { localStorage.removeItem(PKG_KEY); } catch { /* ignore */ }
          for (const slug of readInterestSlugs()) { try { localStorage.removeItem(`mkval:interest:${slug}`); } catch { /* ignore */ } }
          toast(`Tõime su ${moved.movedOutcomes} oskust ja ${moved.movedProgs} jälgitavat programmi kontole.`);
        }
        renderAccount(state);
        showScreen("account");
      };

      // ====================================================================
      // EKRAAN E — Minu konto (renderdus)
      // ====================================================================
      const buildProjection = (items: PkgItem[]): CoverageRow[] => {
        const matchable = items.filter((i) => i.progs && i.progs.length);
        const cover = new Map<string, Set<string>>();
        for (const it of matchable) {
          for (const slug of it.progs as string[]) {
            if (!cover.has(slug)) cover.set(slug, new Set());
            (cover.get(slug) as Set<string>).add(it.key);
          }
        }
        return [...cover.entries()].map(([slug, set]) => {
          const p = PROG[slug];
          return {
            variant_ref: slug,
            outcome_refs: [...set],
            eap: p && p.ects != null ? p.ects : null,
            price_eur: parsePriceEur(p ? p.price : null),
            title: p ? p.name : slug,
            school: p ? p.provider : null,
          };
        });
      };

      const matchHtml = (items: PkgItem[]): { html: string; comboUncovered: string[]; comboSize: number; allInOne: boolean } => {
        const matchable = items.filter((i) => i.progs && i.progs.length);
        if (!matchable.length) return { html: "", comboUncovered: [], comboSize: 0, allInOne: false };
        const total = matchable.length;
        const projection = buildProjection(matchable);
        const fit = computeFit(matchable.map((i) => i.key), projection);
        const best = fit.best_single;
        const combo = fit.combination;
        const meta = (slug: string) => PROG[slug] || { name: slug, provider: "", ects: null, price: null };
        const line = (slug: string, n?: number): string => {
          const p = meta(slug);
          const facts = [p.provider, p.ects != null ? `${p.ects} EAP` : "", p.price || ""].filter(Boolean).join(" · ");
          const cov = n != null ? ` <span class="cov">katab ${n}/${total}</span>` : "";
          return `<a href="/kataloog/${slug}/" data-track-event="cta_click" data-track-label="account_match_detail">${escHtml(p.name)}</a> <span class="pm-prov">${escHtml(facts)}</span>${cov}`;
        };
        const allInOne = !!best && best.fully_covers;
        let html = `<h4 class="pm-h2">Sobivaim (${total} oskust)</h4>`;
        if (best) {
          html += `<p class="pm-best">${line(best.variant_ref, best.covered_count)}</p>`;
          if (allInOne) {
            html += `<p class="pm-note pm-good">✓ See üksik programm katab kogu su paketi.</p>`;
          } else {
            html += `<p class="pm-h2">Täielikuks katteks (${combo.covered_refs.length}/${total}) sobib kombinatsioon:</p>`;
            html += `<ol class="pm-combo">${combo.variants.map((v) => `<li>${line(v.variant_ref)}</li>`).join("")}</ol>`;
            const tail = combo.fully_covered
              ? "Ükski üksik programm ei kata kogu su paketti — sa soovid oskuste kombinatsiooni, mida praegu pakub vaid mitu eri programmi."
              : `Praegused programmid katavad sinu paketist ${combo.covered_refs.length}/${total} oskust — kõigile su valitud oskustele veel ühtegi katet pole.`;
            html += `<p class="pm-note">${tail}</p>`;
          }
        }
        // Kombinatsioon, mida ükski üksik programm ei kata → combo_size > 1
        const comboKeys = combo.fully_covered && combo.program_count > 1 && !allInOne
          ? matchable.map((i) => i.key)
          : [];
        return { html, comboUncovered: comboKeys, comboSize: combo.program_count, allInOne };
      };

      const dlBadge = (iso: string | null): string => {
        if (!iso) return "";
        const DAY = 86400000;
        const today = new Date(); today.setHours(0, 0, 0, 0);
        const due = new Date(iso + "T00:00:00");
        const days = Math.round((due.getTime() - today.getTime()) / DAY);
        if (days < 0) return `<span class="dl-badge past">möödas</span>`;
        if (days === 0) return `<span class="dl-badge today">täna!</span>`;
        if (days <= 14) return `<span class="dl-badge soon">${days} p</span>`;
        return `<span class="dl-badge past">${days} p</span>`;
      };

      let CURRENT: AccountState | null = null;
      const persist = (): void => { if (CURRENT) writeAccount(CURRENT); };   // BRIDGE → AMOS

      const renderAccount = (state: AccountState): void => {
        CURRENT = state;
        $("[data-account-email]")!.textContent = state.email;
        renderPackages();
        renderReminders();
        renderNotify();
        renderFunding();
      };

      // ---- FEATURE 1: paketid ----
      let packageMatchTracked = false;
      const renderPackages = (): void => {
        if (!CURRENT) return;
        const body = $("[data-packages-body]")!;
        const emptyActions = $("[data-packages-empty-actions]");
        if (!CURRENT.packages.length || CURRENT.packages.every((p) => !p.items.length)) {
          body.innerHTML = `<p class="acc-empty">Sul pole veel salvestatud paketti. Mine oskuste lehele, korja sobivad oskused ja vajuta „Salvesta kontole".</p>`;
          if (emptyActions) emptyActions.hidden = false;
          return;
        }
        if (emptyActions) emptyActions.hidden = true;
        body.innerHTML = "";
        for (const pkg of CURRENT.packages) {
          if (!pkg.items.length) continue;
          const card = document.createElement("div");
          card.className = "pkg-card";
          card.dataset.pkgId = pkg.id;
          const chips = pkg.items.map((i) => `<span class="chip">${escHtml(i.text)}</span>`).join("");
          const m = matchHtml(pkg.items);
          card.innerHTML = `
            <div class="pkg-card-head">
              <p class="pkg-card-name" data-pkg-name>${escHtml(pkg.name)}</p>
            </div>
            <div class="chip-row">${chips}</div>
            <div class="pkg-actions">
              <button type="button" class="btn-mini" data-pkg-rename>Nimeta ümber</button>
              <button type="button" class="btn-mini neutral" data-pkg-delete>Kustuta pakett</button>
            </div>
            <div class="pm-match">${m.html}</div>`;
          body.appendChild(card);
        }
        // package_view + package_match (taaskasutatud)
        track("package_view", { count: CURRENT.packages.reduce((s, p) => s + p.items.length, 0) });
        if (!packageMatchTracked) {
          packageMatchTracked = true;
          for (const pkg of CURRENT.packages) {
            const m = matchHtml(pkg.items);
            if (m.comboSize) track("package_match", { combo_size: m.comboSize, all_in_one: m.allInOne ? "jah" : "ei" });
          }
        }
        track("tool_completed", { tool_name: "saved_package" });
      };

      $("[data-packages-body]")?.addEventListener("click", async (e) => {
        const t = e.target as HTMLElement;
        const card = t.closest("[data-pkg-id]") as HTMLElement | null;
        if (!card || !CURRENT) return;
        const id = card.dataset.pkgId!;
        const pkg = CURRENT.packages.find((p) => p.id === id);
        if (!pkg) return;
        if (t.matches("[data-pkg-delete]")) {
          const ok = await confirmModal("Kustuta pakett?", "Kustuta see pakett? Seda ei saa tagasi võtta.", "Jah, kustuta");
          if (!ok) return;
          CURRENT.packages = CURRENT.packages.filter((p) => p.id !== id);
          persist();
          renderPackages();
          toast("Pakett kustutatud.");
        } else if (t.matches("[data-pkg-rename]")) {
          const nameEl = $("[data-pkg-name]", card)!;
          const cur = pkg.name;
          nameEl.innerHTML = `<input type="text" value="${escHtml(cur)}" data-pkg-name-input maxlength="60" />`;
          const input = $("[data-pkg-name-input]", card) as HTMLInputElement;
          input.focus();
          const save = () => {
            pkg.name = (input.value || "").trim().slice(0, 60) || cur;
            persist();
            renderPackages();
          };
          input.addEventListener("blur", save, { once: true });
          input.addEventListener("keydown", (ev) => { if ((ev as KeyboardEvent).key === "Enter") input.blur(); });
        }
      });

      // ---- FEATURE 2: meeldetuletused ----
      // Jälgitavad programmid = paketi programmid ∪ interest-slugid.
      const watchedSlugs = (): string[] => {
        if (!CURRENT) return [];
        const set = new Set<string>(CURRENT.interests);
        for (const pkg of CURRENT.packages) for (const it of pkg.items) for (const s of (it.progs || [])) set.add(s);
        return [...set].filter((s) => PROG[s]);
      };
      const renderReminders = (): void => {
        if (!CURRENT) return;
        const toggle = $("[data-reminders-toggle]") as HTMLInputElement;
        toggle.checked = CURRENT.reminders;
        const list = $("[data-reminders-list]")!;
        const slugs = watchedSlugs().filter((s) => PROG[s].registrationDeadline);
        if (!slugs.length) {
          list.innerHTML = `<p class="acc-empty">Sa ei jälgi veel ühtegi programmi tähtajaga. Lisa programm paketti või vajuta kataloogis „Teavita tähtajast", siis ilmub see siia. <a href="/kataloog/" data-track-event="cta_click" data-track-label="account_to_kataloog">Ava kataloog</a>.</p>`;
          return;
        }
        list.innerHTML = slugs.map((s) => {
          const p = PROG[s];
          return `<div class="reminder-row" data-watch="${escHtml(s)}">
            <span><a href="/kataloog/${escHtml(s)}/">${escHtml(p.name)}</a>
              <span class="reminder-meta">Registreerimine kuni ${formatEt(p.registrationDeadline as string)}</span> ${dlBadge(p.registrationDeadline)}</span>
            <button type="button" class="btn-mini neutral" data-unwatch="${escHtml(s)}">Lakka jälgimast</button>
          </div>`;
        }).join("");
      };
      $("[data-reminders-toggle]")?.addEventListener("change", async (e) => {
        if (!CURRENT) return;
        const on = (e.target as HTMLInputElement).checked;
        CURRENT.reminders = on;
        persist();
        // LIVE-bridge: reminder_subscribed AMOS-i torusse (course_offers; kind veel lepingus defineerimata).
        if (on) await postSubscribe({ kind: "deadline_reminder", email: CURRENT.email, consent_purpose: "course_offers", slugs: watchedSlugs() });
        status("[data-reminders-status]", on ? "Tehtud — tuletame tähtajad meelde." : "Meeldetuletused välja lülitatud.");
        track("cta_click", { cta_label: "reminders_toggle", enabled: on ? "jah" : "ei" });
        track("reminder_subscribed", { enabled: on ? "jah" : "ei" });
      });
      $("[data-reminders-list]")?.addEventListener("click", (e) => {
        const t = e.target as HTMLElement;
        const slug = t.getAttribute("data-unwatch");
        if (!slug || !CURRENT) return;
        CURRENT.interests = CURRENT.interests.filter((s) => s !== slug);
        persist();
        renderReminders();
        toast("Ei jälgi enam seda programmi.");
      });

      // ---- FEATURE 3: teavituslehed ----
      const renderNotify = (): void => {
        if (!CURRENT) return;
        // Kombinatsiooni-soovitus: kui mõne paketi match annab kombinatsiooni (combo_size>1, terviklik kate)
        const comboPrompt = $("[data-combo-prompt]")!;
        let comboItems: PkgItem[] | null = null;
        for (const pkg of CURRENT.packages) {
          const m = matchHtml(pkg.items);
          if (m.comboUncovered.length) { comboItems = pkg.items.filter((i) => m.comboUncovered.includes(i.key)); break; }
        }
        if (comboItems && comboItems.length > 1) {
          const names = comboItems.map((i) => i.text);
          const key = [...names].map((s) => s.toLowerCase()).sort().join(" + ");
          comboPrompt.dataset.comboKey = key;
          $("[data-combo-text]", comboPrompt)!.textContent =
            `Sinu pakett vajab praegu mitut eri programmi: ${names.join(" + ")}. Ühtegi üht programmi, mis kõik need oskused korraga annaks, praegu kataloogis pole.`;
          comboPrompt.hidden = CURRENT.comboWaitlist.includes(key);
        } else {
          comboPrompt.hidden = true;
        }

        // Oskuse-chipid paketi õpiväljunditest
        const skillWrap = $("[data-skill-chips]")!;
        const allSkills = new Set<string>();
        for (const pkg of CURRENT.packages) for (const it of pkg.items) allSkills.add(it.text);
        const available = [...allSkills].filter((s) => !CURRENT!.notifySkills.includes(s));
        if (available.length) {
          skillWrap.hidden = false;
          $("[data-skill-chip-row]", skillWrap)!.innerHTML = available
            .map((s) => `<button type="button" class="skill-chip" data-skill="${escHtml(s)}">+ ${escHtml(s)}</button>`).join("");
        } else {
          skillWrap.hidden = true;
        }

        // Aktiivsed teavituslehed
        const list = $("[data-notify-list]")!;
        const rows: string[] = [];
        for (const f of CURRENT.notifyFields) rows.push(notifyRow("valdkond", f, `Valdkond: ${f}`));
        for (const s of CURRENT.notifySkills) rows.push(notifyRow("oskus", s, `Oskus: ${s}`));
        for (const c of CURRENT.comboWaitlist) rows.push(notifyRow("kombinatsioon", c, `Kombinatsioon: ${c}`));
        if (!rows.length) {
          list.innerHTML = `<p class="acc-empty">Sa ei jälgi veel ühtegi valdkonda ega kombinatsiooni. Vali ülalt, mis sind huvitab.</p>`;
        } else {
          list.innerHTML = rows.join("");
        }
      };
      const notifyRow = (kind: string, value: string, label: string): string =>
        `<div class="notify-item" data-notify-kind="${kind}" data-notify-value="${escHtml(value)}">
          <span>${escHtml(label)}</span>
          <button type="button" class="btn-mini neutral" data-notify-remove>Lakka jälgimast</button>
        </div>`;

      const addNotify = async (kind: "valdkond" | "oskus" | "kombinatsioon", value: string): Promise<void> => {
        if (!CURRENT || !value) return;
        if (kind === "valdkond") { if (!CURRENT.notifyFields.includes(value)) CURRENT.notifyFields.push(value); }
        else if (kind === "oskus") { if (!CURRENT.notifySkills.includes(value)) CURRENT.notifySkills.push(value); }
        else { if (!CURRENT.comboWaitlist.includes(value)) CURRENT.comboWaitlist.push(value); }
        persist();
        // LIVE-bridge: notify_list / combo_waitlist AMOS-i torusse.
        await postSubscribe({
          kind: "notify_list", email: CURRENT.email, consent_purpose: "course_offers",
          field: kind === "valdkond" ? value : null,
          combo: kind === "kombinatsioon" ? value.split(" + ") : (kind === "oskus" ? [value] : null),
        });
        renderNotify();
        status("[data-notify-status]", "Lisatud — anname märku, kui sobiv programm või kombinatsioon lisandub.");
        const route = kind === "kombinatsioon" ? "notify_combo" : kind === "valdkond" ? "notify_field" : "notify_skill";
        track("result_high_intent", { result_route: route, combo_size: kind === "kombinatsioon" ? value.split(" + ").length : 1 });
        if (kind === "kombinatsioon") track("combo_waitlist", { combo_size: value.split(" + ").length });
      };

      $("[data-notify-field-add]")?.addEventListener("click", () => {
        const sel = $("[data-notify-field]") as HTMLSelectElement;
        if (sel.value) { addNotify("valdkond", sel.value); sel.value = ""; }
      });
      $("[data-skill-chip-row]")?.addEventListener("click", (e) => {
        const s = (e.target as HTMLElement).getAttribute("data-skill");
        if (s) addNotify("oskus", s);
      });
      $("[data-combo-subscribe]")?.addEventListener("click", () => {
        const key = $("[data-combo-prompt]")?.dataset.comboKey;
        if (key) addNotify("kombinatsioon", key);
      });
      $("[data-notify-list]")?.addEventListener("click", (e) => {
        const t = e.target as HTMLElement;
        if (!t.matches("[data-notify-remove]") || !CURRENT) return;
        const row = t.closest("[data-notify-kind]") as HTMLElement;
        const kind = row.dataset.notifyKind, value = row.dataset.notifyValue || "";
        if (kind === "valdkond") CURRENT.notifyFields = CURRENT.notifyFields.filter((x) => x !== value);
        else if (kind === "oskus") CURRENT.notifySkills = CURRENT.notifySkills.filter((x) => x !== value);
        else CURRENT.comboWaitlist = CURRENT.comboWaitlist.filter((x) => x !== value);
        persist();
        renderNotify();
        toast("Eemaldatud.");
      });

      // ---- FEATURE 4: toetuse profiil ----
      const renderFunding = (): void => {
        if (!CURRENT) return;
        $$("[data-funding]").forEach((el) => {
          (el as HTMLInputElement).checked = (el as HTMLInputElement).value === CURRENT!.funding_route;
        });
      };
      $$("[data-funding]").forEach((el) => el.addEventListener("change", async (e) => {
        if (!CURRENT) return;
        const route = (e.target as HTMLInputElement).value as "ise" | "tootukassa" | "tooandja";
        CURRENT.funding_route = route;
        persist();
        // LIVE-bridge: funding_profile AMOS-i torusse (kind veel lepingus defineerimata).
        await postSubscribe({ kind: "funding_profile", email: CURRENT.email, consent_purpose: "course_offers", funding_route: route });
        status("[data-funding-status]", "Salvestatud — kohandame su teavitused selle järgi.");
        track("tool_completed", { tool_name: "funding_profile", result_route: route });
        track("funding_profile_set", { result_route: route });
      }));

      // ---- FEATURE 5: nõusolek & andmed ----
      $("[data-consent-withdraw]")?.addEventListener("click", async () => {
        if (!CURRENT) return;
        const ok = await confirmModal("Võta nõusolek tagasi?", "Pärast seda me sulle teavitusi ei saada. Su konto ja paketid jäävad alles. Kindel?", "Jah, võta tagasi");
        if (!ok) return;
        CURRENT.consent = false;
        CURRENT.reminders = false;
        persist();
        renderReminders();
        status("[data-consent-status]", "Nõusolek tagasi võetud. Teavitusi me sulle enam ei saada.");
        track("cta_click", { cta_label: "consent_withdraw" });
      });
      $("[data-data-download]")?.addEventListener("click", () => {
        if (!CURRENT) return;
        toast("Saadame su andmete koopia e-postiga.");
        // BRIDGE: tootmises käivitab see AMOS-i andmete-koopia voo.
      });
      $("[data-account-delete]")?.addEventListener("click", async () => {
        if (!CURRENT) return;
        const ok = await confirmModal(
          "Kustuta konto?",
          "Kustutame su paketid, teavituslehed, meeldetuletused ja profiili. Seda ei saa tagasi võtta. Su e-post pannakse loobumisnimekirja, et sulle enam ei kirjutataks.",
          "Jah, kustuta konto");
        if (!ok) return;
        track("cta_click", { cta_label: "account_delete" });
        // LIVE-bridge: AMOS-i kustutus käib erasure-kujuga (suppression → deletion).
        await postSubscribe({ kind: "account_delete", email: CURRENT.email });
        clearAccount();
        CURRENT = null;
        toast("Su konto on kustutatud. Aitäh, et proovisid.");
        // logi välja
        if (emailInput) emailInput.value = "";
        if (consentInput) consentInput.checked = false;
        renderAnonBanner();
        showScreen("auth");
      });

      // ---- Logi välja ----
      $("[data-logout]")?.addEventListener("click", () => {
        // BRIDGE: tootmises tühistab see ainult seansi (konto jääb AMOS-i alles).
        CURRENT = null;
        renderAnonBanner();
        showScreen("auth");
      });

      // ====================================================================
      // ALGSEISUND — kui konto on juba selles brauseris (sild), näita kontot.
      // ====================================================================
      const boot = (): void => {
        renderAnonBanner();
        const existing = readAccount();
        if (existing && existing.email) {
          renderAccount(existing);
          showScreen("account");
        } else {
          showScreen("auth");
        }
      };
      boot();
    </script>
  </body>
</html>
