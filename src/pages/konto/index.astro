    <!-- Lühike toast-teade -->
    <div class="pm pm-toast" data-toast hidden></div>

    <script type="application/json" id="prog-data" is:inline set:html={progJson} />
    <script type="application/json" id="field-label-data" is:inline set:html={fieldLabelJson} />

    <script>
      import { computeFit, type CoverageRow } from "../../lib/outcome-fit";
      import { formatEt } from "../../data/dates";
      // REAL-PATH libs (built concurrently). Demo path never calls these (flag OFF).
      import {
        kontoEnabled, requestLogin, getSession, clearSession, getNamesFor, setName,
        fetchState, syncPackages, deleteAccount, KONTO_API_BASE,
      } from "../../lib/konto-api";
      import { buildSyncPayload, namesFromSync, packagesUnsyncable } from "../../lib/konto-sync";
      import { outcomeRefForText } from "../../data/outcomeRefs";
      import {
        migrateLegacy, emptyState,
        type PackagesState, type PkgItem as StatePkgItem,
      } from "../../lib/packages";

      // ====================================================================
      // KONTO STATE-MACHINE (kliendipoolne; üks <script>).
      //
      // BRIDGE: kogu konto-seisund elab praegu localStorage'is võtme all
      // "mkval:account". TOOTMISES asendab selle AMOS (/konto/state +
      // /konto/migrate). Iga koht, kus me LOEME/KIRJUTAME seda silda, on
      // märgitud kommentaariga "BRIDGE:".
      //
      // UI-LOOGIKA EI MUUTNUD: see fail reskinnib ja korrastab konto IA
      // (3 kogumit + kaalukontroll + programmi prioriteet), aga kogu konto-API
      // sild (kontoEnabled / requestLogin / verifyLogin / fetchState /
      // syncPackages / deleteAccount / getNames) jääb MUUTMATA — me ainult
      // tarbime seda. Lipu-distsipliin (PUBLIC_KONTO_API_BASE) on puutumata.
      // ====================================================================

      type PkgItem = { key: string; text: string; progs?: string[]; w?: number };
      type AccountPackage = { id: string; name: string; items: PkgItem[] };
      type FundingRoute = "ise" | "tootukassa" | "tooandja" | null;
      type AccountState = {
        email: string;
        consent: boolean;            // course_offers nõusolek (double-opt-in kinnitatud sild)
        packages: AccountPackage[];
        interests: string[];         // jälgitavad programmi-slugid (mkval:interest:<slug>)
        notifyFields: string[];      // valdkonna-teavituslehed
        notifySkills: string[];      // oskuse-teavituslehed (õpiväljundi tekst)
        comboWaitlist: string[];     // kombinatsiooni-teavitused (võti = sorditud oskuste liit)
        reminders: boolean;
        funding_route: FundingRoute;
        progOrder?: string[];        // kasutaja prioriteet programmidele (slug-järjekord)
      };

      const PKG_KEY = "mkval:pakett";
      const ACCOUNT_KEY = "mkval:account";        // BRIDGE: AMOS-i konto-seisundi sild
      const INTEREST_RE = /^mkval:interest:(.+)$/;
      const WL = ["huvi", "tähtis", "väga tähtis"];   // kaalu-sildid (1..3)

      const track = (n: string, p: Record<string, unknown> = {}) => (window as any).digiteekaartTrack?.(n, p);
      const $ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => r.querySelector(s) as T | null;
      const $$ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => [...r.querySelectorAll(s)] as T[];

      // ---- Programmide indeks (slug → metaandmed) -----------------------
      let PROG: Record<string, { name: string; provider: string; ects: number | null; price: string | null; field: string; registrationDeadline: string | null }> = {};
      try { PROG = JSON.parse($("#prog-data")?.textContent || "{}"); } catch { PROG = {}; }
      // Valdkonna slug -> inimkeelne silt (demo-tee kuvamiseks; select annab slugi).
      let FIELD_LABEL: Record<string, string> = {};
      try { FIELD_LABEL = JSON.parse($("#field-label-data")?.textContent || "{}"); } catch { FIELD_LABEL = {}; }
      const parsePriceEur = (priceText: string | null): number | null => {
        if (typeof priceText !== "string") return null;
        const m = priceText.replace(/ /g, " ").match(/\d[\d\s]*/);
        if (!m) return null;
        const n = Number(m[0].replace(/\s/g, ""));
        return Number.isFinite(n) && n > 0 ? n : null;
      };
      const escHtml = (s: string) => s.replace(/[&<>"]/g, (c) => (({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }) as Record<string, string>)[c] || c);

      // ---- localStorage helperid ----------------------------------------
      const readPkg = (): PkgItem[] => { try { return JSON.parse(localStorage.getItem(PKG_KEY) || "[]"); } catch { return []; } };
      const readInterestSlugs = (): string[] => {
        const out: string[] = [];
        try {
          for (let i = 0; i < localStorage.length; i++) {
            const k = localStorage.key(i);
            const m = k && INTEREST_RE.exec(k);
            if (m) out.push(m[1]);
          }
        } catch { /* private mode */ }
        return out;
      };
      // BRIDGE: loe/kirjuta konto-seisund localStorage'ist (AMOS asendab selle).
      const readAccount = (): AccountState | null => {
        try { const raw = localStorage.getItem(ACCOUNT_KEY); return raw ? JSON.parse(raw) : null; } catch { return null; }
      };
      const writeAccount = (s: AccountState): void => {
        try { localStorage.setItem(ACCOUNT_KEY, JSON.stringify(s)); } catch { /* private mode */ }
      };
      const clearAccount = (): void => { try { localStorage.removeItem(ACCOUNT_KEY); } catch { /* ignore */ } };

      // ---- SAMA-SEADE e-post (AINULT kuvamiseks) ----
      // REAL-tee server EI tagasta nime ega e-posti. Et sisselogitud vaade saaks
      // näidata "kellena sa oled", hoiame kasutaja enda kirjutatud e-posti AINULT
      // selles brauseris (sama seade, kus link küsiti). Risti-seadme sisselogimisel
      // jääb tühjaks → vaade kuvab neutraalse "Sinu konto". Pühitakse välja logides
      // ja konto kustutamisel. EI lähe kunagi serverisse ega analüütikasse.
      const TYPED_EMAIL_KEY = "mkval:konto_typed_email";
      const rememberTypedEmail = (email: string): void => {
        try { if (email) localStorage.setItem(TYPED_EMAIL_KEY, email); } catch { /* private mode */ }
      };
      const readTypedEmail = (): string | null => {
        try { const v = localStorage.getItem(TYPED_EMAIL_KEY); return v && v.length > 0 ? v : null; } catch { return null; }
      };
      const clearTypedEmail = (): void => { try { localStorage.removeItem(TYPED_EMAIL_KEY); } catch { /* ignore */ } };

      // ---- REAL-PATH source: mkval:paketid v2 PackagesState (/oskused/ source) ----
      // Used ONLY by the sync path (kontoEnabled). Mirrors /oskused/ loadState:
      // stored v2 wins; else migrate legacy mkval:pakett; else empty.
      const PKGS_KEY = "mkval:paketid";
      const loadLocalState = (): PackagesState => {
        let stored: PackagesState | null = null;
        try {
          const raw = localStorage.getItem(PKGS_KEY);
          if (raw) {
            const s = JSON.parse(raw);
            if (s && typeof s.v === "number" && s.v >= 2 && Array.isArray(s.packages)) stored = s as PackagesState;
          }
        } catch { stored = null; }
        let legacy: StatePkgItem[] = [];
        try { legacy = JSON.parse(localStorage.getItem(PKG_KEY) || "[]"); } catch { legacy = []; }
        if (stored && stored.packages.length) return stored;
        if (Array.isArray(legacy) && legacy.length) {
          return migrateLegacy(legacy, null, { id: "p_seed", name: "Minu pakett", createdAt: 0 });
        }
        return stored ?? emptyState();
      };

      // ---- REAL-PATH: client_id -> package_ref map (stable, local-only) ----
      // Keeps syncPackages idempotent: on re-sync we pass the known package_ref
      // per item so the server reuses it instead of minting a duplicate.
      const PKGREF_MAP_KEY = "mkval:pkgrefs";   // local-only; NEVER sent wholesale
      const readPkgRefMap = (): Record<string, string> => {
        try { return JSON.parse(localStorage.getItem(PKGREF_MAP_KEY) || "{}") || {}; } catch { return {}; }
      };
      const writePkgRefMap = (m: Record<string, string>): void => {
        try { localStorage.setItem(PKGREF_MAP_KEY, JSON.stringify(m)); } catch { /* private mode */ }
      };

      // ---- LIVE pipe: e-postide korje AMOS-i (api/subscribe) -------------
      // outcome_package on AMOS-i lepingus OLEMAS → jõuab päriselt kohale
      // (double-opt-in, course_offers). Uued account-kinnid on lepingus VEEL
      // defineerimata; saadame need samasse torusse "parima püüdega" ja
      // ei sõltu nende edust UI mõttes (sild ei luba midagi, mida pole).
      const postSubscribe = async (payload: Record<string, unknown>): Promise<boolean> => {
        try {
          const r = await fetch("/api/subscribe", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ source_site: "mikrokvalifikatsioon_ee", ...payload }),
          });
          return r.ok;
        } catch { return false; }
      };

      // ---- REAL-PATH konto-haldus (Bearer) — uued AMOS-i otspunktid ------
      // Need on Codexi paralleelselt ehitatud konto-halduse kutsed: paketi
      // kustutamine ja tellimuste lisamine/maha võtmine. Need EI ela
      // konto-api.ts-is (selle auth/sessiooni/päringu loogika jääb puutumata) —
      // siin tarbime sama Bearer-sessiooni nagu fetchState/syncPackages.
      //
      // GRAATSILINE DEGRADEERUMINE (kõva reegel): kuni AMOS-i host on need
      // uuesti juurutanud, võivad nad anda 404/401. Sel juhul tagastame
      // "pending" — leht hoiab juhtnupu alles ja näitab rahulikku "tuleb peagi"
      // seisu. EI VÕLTSI kunagi edu, mida serveris ei toimunud. Tagastus:
      //   "ok"      — server kinnitas (2xx);
      //   "pending" — otspunkt veel pole live (404/401) → juhtnupp jääb, kuvame ootel;
      //   "error"   — võrk/muu tõrge → näita rahulikku viga, lase uuesti proovida.
      type WireResult = "ok" | "pending" | "error";
      const kontoUrl = (path: string): string => `${(KONTO_API_BASE || "").replace(/\/+$/, "")}${path}`;
      const postKonto = async (path: string, body: Record<string, unknown>): Promise<WireResult> => {
        if (!kontoEnabled()) return "pending";
        const session = getSession();
        if (!session) return "error";
        try {
          const r = await fetch(kontoUrl(path), {
            method: "POST",
            headers: { "Content-Type": "application/json", Authorization: `Bearer ${session}` },
            body: JSON.stringify(body),
          });
          if (r.ok) return "ok";
          // 404 = host pole uut otspunkti veel juurutanud; 401 = sama (uus
          // marsruut tundmatu) → kohtle ootel-olekuna, ÄRA kustuta sessiooni.
          if (r.status === 404 || r.status === 401) return "pending";
          return "error";
        } catch { return "error"; }
      };
      // POST /packages/delete {package_ref}
      const deletePackageRemote = (packageRef: string): Promise<WireResult> =>
        postKonto("/api/konto/v1/packages/delete", { package_ref: packageRef });

      // ---- /subscriptions LEPINGU-PIIR: UI kind+väärtus -> kanooniline ------
      // Backend (amos.crm.package_subscription/v1) lubab AINULT neid kinde:
      //   field · skill · combination · programme_reminder · funding
      // ja target_ref peab olema läbipaistmatu (PII-vaba) ja vastama grammatikale
      //   ^[a-z][a-z0-9:_-]{1,96}$
      // Meie SISEMINE UI hoiab oma kinde (valdkond/oskus/kombinatsioon/...) ja
      // AccountState'i välju MUUTMATA - teisendus toimub AINULT siin, päringu
      // piiril. Mida ei saa väljendada kanoonilise läbipaistmatu viitena (oskus
      // ilma out_-viiteta, kombinatsioon ilma kanoonilise viiteta), jääb KLIENDI-
      // POOLSEKS - tagastame null ja EI saada (ükski 400 ei teki).
      const TARGET_REF_RE = /^[a-z][a-z0-9:_-]{1,96}$/;
      const OUT_REF_RE = /^out_[0-9a-f]{24}$/;
      type Canonical = { kind: string; target_ref: string };
      const toCanonicalSubscription = (uiKind: string, rawValue: string): Canonical | null => {
        const value = (rawValue || "").trim();
        switch (uiKind) {
          case "field":
          case "valdkond": {
            // value on juba valdkonna SLUG (select annab slugi). Pea grammatikast kinni.
            return value && TARGET_REF_RE.test(value) ? { kind: "field", target_ref: value } : null;
          }
          case "skill":
          case "oskus": {
            // Oskus -> kanooniline out_<hex> viide. Kui teksti pole kataloogis
            // (out_ viidet ei teki), JÄTA KLIENDI-POOLSEKS (null) - mitte saada.
            const ref = outcomeRefForText(value);
            return ref && OUT_REF_RE.test(ref) ? { kind: "skill", target_ref: ref } : null;
          }
          case "combination":
          case "combo":
          case "kombinatsioon": {
            // Kanoonilist kombinatsiooni-viidet meil kliendi pool pole (võti on
            // oskuste-tekstide liit, mis pole läbipaistmatu) -> KLIENDI-POOLNE.
            return null;
          }
          case "programme_reminder":
          case "deadline_reminder":
          case "reminder": {
            // Püsiv sentinel kõigi jälgitavate tähtaegade jaoks (backend lubab seda).
            return { kind: "programme_reminder", target_ref: "reminder_all" };
          }
          case "funding":
          case "funding_profile": {
            // value = marsruut (ise/tootukassa/tooandja) -> rahastus_<route>.
            const ref = `rahastus_${value}`;
            return value && TARGET_REF_RE.test(ref) ? { kind: "funding", target_ref: ref } : null;
          }
          default:
            return null;
        }
      };

      // POST /subscriptions {kind,target_ref} — saadab KANOONILISE kuju.
      // Tagastus "pending", kui väärtust ei saa kanooniliselt väljendada
      // (kutsuja jätab siis kliendi-poolseks, ausa "tuleb peagi" seisuga) -
      // me EI saada kunagi väärtust, mille backend tagasi lükkaks.
      const subscribeRemote = (kind: string, targetRef: string): Promise<WireResult> => {
        const canon = toCanonicalSubscription(kind, targetRef);
        if (!canon) return Promise.resolve("pending");
        return postKonto("/api/konto/v1/subscriptions", { kind: canon.kind, target_ref: canon.target_ref });
      };
      // POST /subscriptions/unsubscribe {ref}
      const unsubscribeRemote = (ref: string): Promise<WireResult> =>
        postKonto("/api/konto/v1/subscriptions/unsubscribe", { ref });

      // ---- Toast + modal -------------------------------------------------
      let toastTimer: ReturnType<typeof setTimeout> | undefined;
      const toast = (msg: string): void => {
        const el = $("[data-toast]");
        if (!el) return;
        el.textContent = msg;
        el.hidden = false;
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => { el.hidden = true; }, 3200);
      };
      const confirmModal = (title: string, body: string, confirmLabel: string): Promise<boolean> =>
        new Promise((resolve) => {
          const modal = $("[data-modal]");
          if (!modal) { resolve(window.confirm(body)); return; }
          $("[data-modal-title]", modal)!.textContent = title;
          $("[data-modal-body]", modal)!.textContent = body;
          const okBtn = $("[data-modal-confirm]", modal) as HTMLButtonElement;
          okBtn.textContent = confirmLabel;
          modal.hidden = false;
          const done = (v: boolean) => { modal.hidden = true; okBtn.onclick = null; cancelBtn.onclick = null; resolve(v); };
          const cancelBtn = $("[data-modal-cancel]", modal) as HTMLButtonElement;
          okBtn.onclick = () => done(true);
          cancelBtn.onclick = () => done(false);
        });

      const status = (sel: string, msg: string, isError = false): void => {
        const el = $(sel);
        if (!el) return;
        el.textContent = msg;
        el.classList.toggle("is-error", isError);
        el.hidden = false;
      };

      // ---- Stepper + ekraanide vahetus ----------------------------------
      const setStep = (n: number): void => {
        $$("[data-pm-step]").forEach((el) => {
          const i = Number(el.getAttribute("data-pm-step"));
          el.classList.toggle("active", i === n);
          el.classList.toggle("done", i < n);
          if (i === n) el.setAttribute("aria-current", "step"); else el.removeAttribute("aria-current");
        });
      };
      // Mängi paljastatud ekraani .pm-rise(de)l sisenemise-efekt TRANSITION'iga.
      // MIKS NII: CSS-animatsiooni `both`-täide jättis peidetud (display:none)
      // ekraani, mis paljastatakse alles hiljem (account pärast async fetchState'i),
      // opacity:0 peale = tühi keha. Transition-mustriga on puhkeseis NÄHTAV
      // (opacity:1) ja efekt on vaid kaunistus: paneme korraks .pm-rise-enter
      // (opacity:0 + nihe, transition:none), sunnime reflow ja eemaldame klassi
      // järgmisel kaadril → element liugleb nähtavaks. Kui efekt ei käivitu (nt
      // reduced-motion), jääb keha ikka NÄHTAVAKS.
      const revealRise = (name: "auth" | "check" | "account"): void => {
        const sec = $(`[data-screen="${name}"]`);
        if (!sec) return;
        const rises = $$(".pm-rise", sec);
        for (const el of rises) {
          el.classList.add("pm-rise-enter");   // algseis: opacity:0, transition:none
          void el.offsetWidth;                 // sunni reflow, et algseis kinnistuks
        }
        requestAnimationFrame(() => {
          for (const el of rises) el.classList.remove("pm-rise-enter"); // → liugleb nähtavaks
        });
      };

      const showScreen = (name: "auth" | "check" | "account"): void => {
        // Ekraani nähtavuse otsustab .pm-screen.on KLASS (CSS:
        // `.pm-screen{display:none}` / `.pm-screen.on{display:block}`), seega
        // peame klassi vahetama - AINULT `hidden`-atribuudi eemaldamine EI tee
        // ekraani nähtavaks (jääks `.pm-screen` ilma `.on`-ita display:none'i).
        // Hoiame `hidden` ka sünkroonis (a11y + `[hidden]` !important kindlustab
        // peitmise) - aga `.on` on see, mis ekraani PÄRISELT kuvab.
        $$("[data-screen]").forEach((s) => {
          const match = s.getAttribute("data-screen") === name;
          s.classList.toggle("on", match);
          (s as HTMLElement).hidden = !match;
        });
        const stepperWrap = $("[data-stepper-wrap]");
        if (stepperWrap) {
          // Auth on rahulik (apex-laadne) → peida mõõdik. Sammud (data-pm-step)
          // on 0-põhised: 0 "Vali, mis huvitab", 1 "Salvesta endale",
          // 2 "Kinnita e-post" (=check), 3 "Sinu konto" (=account).
          stepperWrap.hidden = name === "auth";
          if (name === "check") setStep(2);     // samm 3 - "Kinnita e-post"
          if (name === "account") setStep(3);   // samm 4 - "Sinu konto"
        }
        // Mängi just avatud ekraani sisenemise-efekt (vt revealRise). Keha on
        // niikuinii nähtav (puhkeseis opacity:1) - see on vaid kaunistus.
        revealRise(name);
        window.scrollTo({ top: 0, behavior: "auto" });
      };

      // ====================================================================
      // EKRAAN B — Loo konto / Logi sisse
      // ====================================================================
      const anonBanner = $("[data-anon-banner]");
      const authForm = $("[data-auth-form]") as HTMLFormElement | null;
      const emailInput = $("#kontoEmail") as HTMLInputElement | null;
      const consentInput = $("[data-consent]") as HTMLInputElement | null;
      const authError = $("[data-auth-error]");

      // ---- Auth-mood: "signup" (uus konto + nõusolek) vs "login" (lühike tagasi-tee) ----
      // Sama magic-link'i mehhanism mõlemas; erinevad ainult copy + rõhk + nõusoleku-rida.
      type AuthMode = "signup" | "login";
      let authMode: AuthMode = "signup";
      const setAuthMode = (m: AuthMode): void => {
        authMode = m;
        $$("[data-mode-btn]").forEach((b) => {
          const on = b.getAttribute("data-mode-btn") === m;
          b.classList.toggle("on", on);
          b.setAttribute("aria-selected", on ? "true" : "false");
        });
        $$("[data-mode-hint]").forEach((el) => { (el as HTMLElement).hidden = el.getAttribute("data-mode-hint") !== m; });
        // signup-only plokid (usaldusriba, nõusolek) on login-moodis peidetud,
        // et tagasi-tee oleks lahja: "sisesta e-post, saadame lingi".
        $$("[data-mode-only]").forEach((el) => { (el as HTMLElement).hidden = el.getAttribute("data-mode-only") !== m; });
        const lbl = $("[data-auth-submit-label]");
        if (lbl) lbl.textContent = m === "login" ? "Saada sisselogimislink" : "Loo konto ja saada link";
        if (authError) authError.hidden = true;
      };
      $$("[data-mode-btn]").forEach((b) => b.addEventListener("click", () => {
        const m = b.getAttribute("data-mode-btn") as AuthMode;
        setAuthMode(m);
        track("cta_click", { cta_label: "auth_mode", auth_mode: m });
      }));

      const renderAnonBanner = (): void => {
        if (!anonBanner) return;
        const n = readPkg().length;
        const m = readInterestSlugs().length;
        if (n === 0 && m === 0) { anonBanner.hidden = true; return; }
        const parts: string[] = [];
        if (n) parts.push(`${n} salvestatud oskust`);
        if (m) parts.push(`${m} jälgitavat programmi`);
        anonBanner.innerHTML = `📦 Sul on selles brauseris ${parts.join(" ja ")}. Sisse logides toome need sinu kontole - midagi ei kao.`;
        anonBanner.hidden = false;
      };

      authForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (authError) authError.hidden = true;
        const email = (emailInput?.value || "").trim().toLowerCase();
        const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
        const existing = readAccount();
        // "Tagasi-tee": kasutaja valis Logi sisse VÕI demo-sild teab juba kinnitatud kontot.
        // Sel juhul ei nõua me nõusoleku-linnukest uuesti (nõusoleku-rida on login-moodis
        // niikuinii peidetud). Uue konto (signup) loomiseks jääb nõusolek KOHUSTUSLIKUKS.
        const isReturning = authMode === "login" || (!!existing && existing.email === email && existing.consent);
        // Nõusolek on uue konto loomiseks kohustuslik, olemasolevasse sisselogimiseks mitte.
        if (!emailOk) {
          if (authError) { authError.textContent = "Palun sisesta korrektne e-post."; authError.hidden = false; }
          return;
        }
        if (!consentInput?.checked && !isReturning) {
          if (authError) { authError.textContent = "Konto loomiseks pane palun linnuke nõusoleku juurde."; authError.hidden = false; }
          return;
        }

        // ===== REAL PATH (flag ON): magic-link request, no demo bridge =====
        if (kontoEnabled()) {
          const btn = $("[data-auth-submit]") as HTMLButtonElement;
          const origLabel = btn?.textContent ?? "";
          if (btn) { btn.disabled = true; btn.textContent = "Saadan linki…"; }
          if (emailInput) emailInput.disabled = true;
          track("lead_form_submit_attempt", { form_name: "account" });
          track("account_login_request", {}); // no PII
          // SAMA-SEADE identiteet: hoia kasutaja enda kirjutatud e-post AINULT
          // siia brauserisse, et sisselogitud vaade saaks näidata "kellena sa
          // oled". EI lähe serverisse (ainult requestLogin saab e-posti) ega
          // analüütikasse. Risti-seadme sisselogimisel jääb see tühjaks ja vaade
          // kuvab neutraalse "Sinu konto" (vt syncAndRenderReal).
          rememberTypedEmail(email);
          try { await requestLogin(email); } catch { /* näita kontrolli-e-posti niikuinii; saab uue tellida */ }
          track("lead_form_submit", { form_name: "account", delivery: "magic_link" });
          if (btn) { btn.disabled = false; btn.textContent = origLabel; }
          if (emailInput) emailInput.disabled = false;
          const checkEmailEl = $("[data-check-email]");
          if (checkEmailEl) checkEmailEl.textContent = email;
          showScreen("check");
          return; // ÄRA jätka demo-sillaga
        }
        // ===== DEMO PATH (flag OFF): muutmata allpool =====

        const submitBtn = $("[data-auth-submit]") as HTMLButtonElement;
        submitBtn.disabled = true;
        const origLabel = submitBtn.textContent;
        submitBtn.textContent = "Saadan linki…";
        if (emailInput) emailInput.disabled = true;

        track("lead_form_submit_attempt", { form_name: "account", package_size: readPkg().length, interests: readInterestSlugs().length });

        // LIVE: kanna konto-loomise/sisselogimise soov AMOS-i torusse.
        // Paketi outcome'id ratsutavad outcome_package'iga (OLEMAS lepingus).
        // account_create on lepingus VEEL defineerimata → "parima püüdega".
        const pkg = readPkg();
        const delivery = await Promise.resolve().then(async () => {
          // 1) account_create signaal (bridged — AMOS-i leping ootab uut kindi)
          await postSubscribe({ kind: "account_create", email, consent_purpose: "course_offers", outcomes: pkg.map((i) => i.text) });
          // 2) Paketi outcome'id LIVE kindiga (jõuab AMOS-i juba täna)
          if (pkg.length) {
            const ok = await postSubscribe({ kind: "outcome_package", email, outcomes: pkg.map((i) => i.text) });
            return ok ? "webhook" : "mailto";
          }
          return "webhook";
        });

        track("lead_form_submit", { form_name: "account", delivery, package_size: pkg.length, interests: readInterestSlugs().length });
        track("account_created", { delivery, package_size: pkg.length });

        // BRIDGE: hoia soovitud e-post + nõusolek alles, et demo-login saaks
        // konto luua. TOOTMISES ei salvestaks me midagi enne magic-link'i klõpsu.
        sessionStorage.setItem("mkval:pending_email", email);
        sessionStorage.setItem("mkval:pending_consent", consentInput?.checked ? "1" : (isReturning ? "1" : "0"));

        submitBtn.disabled = false;
        submitBtn.textContent = origLabel;
        if (emailInput) emailInput.disabled = false;

        const checkEmailEl = $("[data-check-email]");
        if (checkEmailEl) checkEmailEl.textContent = email;
        showScreen("check");
      });

      // Track lead_form_start üks kord
      let leadStarted = false;
      authForm?.addEventListener("focusin", () => {
        if (leadStarted) return;
        leadStarted = true;
        track("lead_form_start", { form_name: "account" });
      });

      // ====================================================================
      // EKRAAN C — Kontrolli e-posti
      // ====================================================================
      let resendCooldown = 0;
      $("[data-resend]")?.addEventListener("click", () => {
        const btn = $("[data-resend]") as HTMLButtonElement;
        if (resendCooldown > 0) return;
        toast("Saatsime uue lingi.");
        resendCooldown = 30;
        const tick = () => {
          if (resendCooldown <= 0) { btn.disabled = false; btn.textContent = "Saada link uuesti"; return; }
          btn.disabled = true;
          btn.textContent = `Saada uuesti (saad ${resendCooldown} s pärast)`;
          resendCooldown -= 1;
          setTimeout(tick, 1000);
        };
        tick();
      });
      $("[data-change-email]")?.addEventListener("click", () => {
        if (emailInput) emailInput.value = sessionStorage.getItem("mkval:pending_email") || "";
        showScreen("auth");
      });

      // REAL PATH (flag ON): peida demo-login nupp + selle demo-sild ja lülita
      // kontrolli-ekraani tekst magic-link'i sõnumiks. Staatiline leht → runtime-toggle.
      if (kontoEnabled()) {
        const demoBtn = $("[data-demo-login]");
        if (demoBtn) {
          const demoWrap = demoBtn.closest(".bridge-note") as HTMLElement | null;
          (demoWrap ?? demoBtn).setAttribute("hidden", "");
        }
      } else {
        // BRIDGE: demo-login asendab magic-link'i klõpsu. TOOTMISES jõuab kasutaja
        // siia /konto/kinnita?token=… kaudu, kus AMOS kinnitab double-opt-in'i.
        $("[data-demo-login]")?.addEventListener("click", () => {
          const email = sessionStorage.getItem("mkval:pending_email") || "";
          const consent = sessionStorage.getItem("mkval:pending_consent") === "1";
          if (!email) { showScreen("auth"); return; }
          const isNew = !readAccount();
          loginAndMigrate(email, consent);
          track("tool_completed", { tool_name: "account_login" });
          if (isNew) track("result_high_intent", { result_route: "account_create", form_name: "account_create" });
        });
      }

      // ====================================================================
      // EKRAAN D-loogika (sild): login + lossless union-merge migratsioon.
      // (Eraldi leht /konto/kinnita/ teeb sama päris magic-link'i tokeniga.)
      // ====================================================================
      const blankState = (email: string, consent: boolean): AccountState => ({
        email, consent,
        packages: [], interests: [], notifyFields: [], notifySkills: [], comboWaitlist: [],
        reminders: false, funding_route: null, progOrder: [],
      });

      const migrateInto = (state: AccountState): { movedOutcomes: number; movedProgs: number } => {
        // 1. PAKETID — union item .key järgi
        const localPkg = readPkg();
        let movedOutcomes = 0;
        if (localPkg.length) {
          let target = state.packages[state.packages.length - 1];
          if (!target) {
            target = { id: `pkg_${Date.now()}`, name: "Minu salvestatud pakett", items: [] };
            state.packages.push(target);
          }
          const have = new Set(target.items.map((i) => i.key));
          for (const it of localPkg) {
            if (have.has(it.key)) {
              // progs[] union olemasolevasse
              const ex = target.items.find((x) => x.key === it.key);
              if (ex) {
                const set = new Set([...(ex.progs || []), ...(it.progs || [])]);
                ex.progs = [...set];
              }
            } else {
              target.items.push({ key: it.key, text: it.text, progs: [...(it.progs || [])], w: it.w ?? 2 });
              have.add(it.key);
              movedOutcomes += 1;
            }
          }
        }
        // 2. INTERESTS (per-programme notify) — union slug järgi
        const localInterests = readInterestSlugs();
        const interestSet = new Set([...state.interests, ...localInterests]);
        const before = state.interests.length;
        state.interests = [...interestSet];
        const movedProgs = state.interests.length - before;
        // 3. reminders/funding/consent — server (siin: olemasolev seisund) on tõeallikas;
        //    EI alanda kinnitatud nõusolekut puuduva localiga.
        return { movedOutcomes, movedProgs };
      };

      const loginAndMigrate = (email: string, consent: boolean): void => {
        // BRIDGE: AMOS-i /konto/state asemel loeme localStorage'ist.
        let state = readAccount();
        if (!state || state.email !== email) {
          state = state && state.email === email ? state : blankState(email, consent);
        }
        if (consent) state.consent = true;     // ära alanda kinnitatud nõusolekut
        const moved = migrateInto(state);
        // BRIDGE: AMOS-i /konto/migrate asemel kirjutame localStorage'i.
        writeAccount(state);
        // Migratsioon õnnestus (kirjutus läbi) → puhasta anonüümne local.
        if (moved.movedOutcomes || moved.movedProgs) {
          try { localStorage.removeItem(PKG_KEY); } catch { /* ignore */ }
          for (const slug of readInterestSlugs()) { try { localStorage.removeItem(`mkval:interest:${slug}`); } catch { /* ignore */ } }
          toast(`Tõime su ${moved.movedOutcomes} oskust ja ${moved.movedProgs} jälgitavat programmi kontole.`);
        }
        renderAccount(state);
        showScreen("account");
      };

      // ====================================================================
      // EKRAAN E — Minu konto (renderdus)
      // ====================================================================
      const buildProjection = (items: PkgItem[]): CoverageRow[] => {
        const matchable = items.filter((i) => i.progs && i.progs.length);
        const cover = new Map<string, Set<string>>();
        for (const it of matchable) {
          for (const slug of it.progs as string[]) {
            if (!cover.has(slug)) cover.set(slug, new Set());
            (cover.get(slug) as Set<string>).add(it.key);
          }
        }
        return [...cover.entries()].map(([slug, set]) => {
          const p = PROG[slug];
          return {
            variant_ref: slug,
            outcome_refs: [...set],
            eap: p && p.ects != null ? p.ects : null,
            price_eur: parsePriceEur(p ? p.price : null),
            title: p ? p.name : slug,
            school: p ? p.provider : null,
          };
        });
      };

      const matchHtml = (items: PkgItem[]): { html: string; comboUncovered: string[]; comboSize: number; allInOne: boolean } => {
        const matchable = items.filter((i) => i.progs && i.progs.length);
        if (!matchable.length) return { html: "", comboUncovered: [], comboSize: 0, allInOne: false };
        const total = matchable.length;
        const projection = buildProjection(matchable);
        const fit = computeFit(matchable.map((i) => i.key), projection);
        const best = fit.best_single;
        const combo = fit.combination;
        const meta = (slug: string) => PROG[slug] || { name: slug, provider: "", ects: null, price: null };
        const line = (slug: string, n?: number): string => {
          const p = meta(slug);
          const facts = [p.provider, p.ects != null ? `${p.ects} EAP` : "", p.price || ""].filter(Boolean).join(" · ");
          const cov = n != null ? ` <span class="pm-tag ok">katab ${n}/${total}</span>` : "";
          return `<a href="/kataloog/${slug}/" data-track-event="cta_click" data-track-label="account_match_detail">${escHtml(p.name)}</a> <span style="color:var(--pm-muted);font-weight:400;font-size:0.88rem">${escHtml(facts)}</span>${cov}`;
        };
        const allInOne = !!best && best.fully_covers;
        let html = `<h4 style="font-family:var(--pm-disp);font-weight:700;margin:0 0 5px">Sobivaim (${total} oskust)</h4>`;
        if (best) {
          html += `<p style="margin:0 0 6px">${line(best.variant_ref, best.covered_count)}</p>`;
          if (allInOne) {
            html += `<p class="pm-tiny" style="color:var(--pm-green-deep);font-weight:700">✓ See üksik programm katab kogu su paketi.</p>`;
          } else {
            html += `<p style="font-family:var(--pm-disp);font-weight:700;margin:8px 0 5px">Täielikuks katteks (${combo.covered_refs.length}/${total}) sobib kombinatsioon:</p>`;
            html += `<ol style="margin:0;padding-left:20px;display:grid;gap:4px">${combo.variants.map((v) => `<li>${line(v.variant_ref)}</li>`).join("")}</ol>`;
            const tail = combo.fully_covered
              ? "Ükski üksik programm ei kata kogu su paketti - sa soovid oskuste kombinatsiooni, mida praegu pakub vaid mitu eri programmi."
              : `Praegused programmid katavad sinu paketist ${combo.covered_refs.length}/${total} oskust - kõigile su valitud oskustele veel ühtegi katet pole.`;
            html += `<p class="pm-tiny" style="margin-top:8px">${tail}</p>`;
          }
        }
        // Kombinatsioon, mida ükski üksik programm ei kata → combo_size > 1
        const comboKeys = combo.fully_covered && combo.program_count > 1 && !allInOne
          ? matchable.map((i) => i.key)
          : [];
        return { html, comboUncovered: comboKeys, comboSize: combo.program_count, allInOne };
      };

      const dlBadge = (iso: string | null): string => {
        if (!iso) return "";
        const DAY = 86400000;
        const today = new Date(); today.setHours(0, 0, 0, 0);
        const due = new Date(iso + "T00:00:00");
        const days = Math.round((due.getTime() - today.getTime()) / DAY);
        if (days < 0) return `<span class="pm-dl-badge past">möödas</span>`;
        if (days === 0) return `<span class="pm-dl-badge today">täna!</span>`;
        if (days <= 14) return `<span class="pm-dl-badge soon">${days} p</span>`;
        return `<span class="pm-dl-badge past">${days} p</span>`;
      };

      let CURRENT: AccountState | null = null;
      const persist = (): void => { if (CURRENT) writeAccount(CURRENT); };   // BRIDGE → AMOS

      // Lameda oskuste loend kõigist pakettidest (kogum "Minu oskused" allikas).
      const allItems = (): PkgItem[] => {
        if (!CURRENT) return [];
        const out: PkgItem[] = [];
        for (const pkg of CURRENT.packages) for (const it of pkg.items) out.push(it);
        return out;
      };

      const setCount = (sel: string, n: number): void => {
        const el = $(sel);
        if (el) el.textContent = String(n);
      };

      const renderAccount = (state: AccountState): void => {
        CURRENT = state;
        $("[data-account-email]")!.textContent = `Sa oled sees e-postiga ${state.email}`;
        renderSkills();
        renderProgrammes();
        renderCompares();
        renderReminders();
        renderNotify();
        renderFunding();
        renderSubscriptions();
      };

      // ---- KOGUM 1: Minu oskused (kaalukontroll + vaste/jälgime + parim vaste) ----
      let packageMatchTracked = false;
      const renderSkills = (): void => {
        if (!CURRENT) return;
        const body = $("[data-skills-body]")!;
        const emptyActions = $("[data-packages-empty-actions]");
        const bestBox = $("[data-best-match]");
        const items = allItems();
        setCount("[data-count-osk]", items.length);
        if (!items.length) {
          body.innerHTML = `<p class="pm-empty">Sul pole veel salvestatud oskusi. Mine oskuste lehele, korja sobivad oskused ja vajuta „Salvesta kontole".</p>`;
          if (emptyActions) emptyActions.hidden = false;
          if (bestBox) bestBox.hidden = true;
          return;
        }
        if (emptyActions) emptyActions.hidden = true;

        // Match per item: leia esimene programm, mis seda oskust õpetab (sild — demo).
        const itemMatch = (it: PkgItem): { slug: string; name: string } | null => {
          for (const slug of it.progs || []) {
            const p = PROG[slug];
            if (p) return { slug, name: `${p.provider} · ${p.name}` };
          }
          return null;
        };

        // Sorteeri kaalu järgi kahanevalt (väga tähtis üleval), stabiilselt.
        const order = items
          .map((it, idx) => ({ it, idx, w: it.w ?? 2 }))
          .sort((a, b) => (b.w - a.w) || (a.idx - b.idx));

        body.innerHTML = order.map(({ it }) => {
          const w = it.w ?? 2;
          const m = itemMatch(it);
          const dots = [1, 2, 3].map((d) =>
            `<button type="button" class="pm-dot ${d <= w ? "fill" : ""}" data-set-weight="${escHtml(it.key)}" data-w="${d}" title="${WL[d - 1]}" aria-label="Tähtsus: ${WL[d - 1]} - ${escHtml(it.text)}"></button>`
          ).join("");
          const tag = m
            ? `<span class="pm-tag ok">✓ Õpetatakse: <a href="/kataloog/${escHtml(m.slug)}/" data-track-event="cta_click" data-track-label="account_skill_match">${escHtml(m.name)}</a></span>`
            : `<span class="pm-tag wait">⌛ Veel pole vastet - jälgime ja anname teada</span>`;
          return `<div class="pm-srow">
            <div class="pm-weight"><div class="pm-dots" role="group" aria-label="Tähtsus: ${escHtml(it.text)}">${dots}</div><small>${WL[w - 1]}</small></div>
            <div class="body"><div class="nm">${escHtml(it.text)}</div>${tag}</div>
          </div>`;
        }).join("");

        // Parim vaste kasutaja tähtsuste järgi: kõige raskem oskus, millel on vaste.
        renderBestMatch(items, bestBox);

        // package_view + package_match (taaskasutatud GA4 sündmused).
        track("package_view", { count: items.length });
        if (!packageMatchTracked) {
          packageMatchTracked = true;
          for (const pkg of CURRENT.packages) {
            const mh = matchHtml(pkg.items);
            if (mh.comboSize) track("package_match", { combo_size: mh.comboSize, all_in_one: mh.allInOne ? "jah" : "ei" });
          }
        }
        track("tool_completed", { tool_name: "saved_package" });
      };

      const renderBestMatch = (items: PkgItem[], bestBox: HTMLElement | null): void => {
        if (!bestBox) return;
        const matchable = items.filter((i) => i.progs && i.progs.length);
        if (!matchable.length) { bestBox.hidden = true; return; }
        // computeFit annab parima üksiku programmi; pealkirjastame selle "tähtsuste järgi".
        const total = matchable.length;
        const projection = buildProjection(matchable);
        const fit = computeFit(matchable.map((i) => i.key), projection);
        const best = fit.best_single;
        if (!best) { bestBox.hidden = true; return; }
        const p = PROG[best.variant_ref];
        if (!p) { bestBox.hidden = true; return; }
        const pct = total > 0 ? Math.round((best.covered_count / total) * 100) : 0;
        $("[data-best-match-name]")!.innerHTML = `<a href="/kataloog/${escHtml(best.variant_ref)}/" data-track-event="cta_click" data-track-label="account_best_match">${escHtml(p.provider)} · ${escHtml(p.name)}</a>`;
        const bar = $("[data-best-match-bar]") as HTMLElement;
        if (bar) bar.style.width = `${pct}%`;
        const facts = [
          `Katab su ${best.covered_count}/${total} oskust`,
          p.ects != null ? `${p.ects} EAP` : "",
          p.price || "",
        ].filter(Boolean).join(" · ");
        $("[data-best-match-meta]")!.textContent = facts;
        bestBox.hidden = false;
      };

      // Kaalu seadmine (klõps täpil) — uuendab seisundit ja renderdab uuesti.
      $("[data-skills-body]")?.addEventListener("click", (e) => {
        const t = e.target as HTMLElement;
        const key = t.getAttribute("data-set-weight");
        if (!key || !CURRENT) return;
        const w = Number(t.getAttribute("data-w")) || 2;
        for (const pkg of CURRENT.packages) {
          const it = pkg.items.find((x) => x.key === key);
          if (it) { it.w = w; break; }
        }
        persist();
        renderSkills();
        renderProgrammes();
        track("cta_click", { cta_label: "skill_weight", weight: w });
      });

      // ---- KOGUM 2: Minu programmid (prioriteet + sobivuse riba) ----
      // Programmid = kõik slug'id, mis su oskusi katavad, kahanev kattuvuse järgi,
      // aga kasutaja saab järjekorda noolega muuta (progOrder hoiab valiku).
      const computeProgRows = (): { slug: string; covered: number; total: number; pct: number }[] => {
        const items = allItems().filter((i) => i.progs && i.progs.length);
        if (!items.length) return [];
        const total = items.length;
        const cover = new Map<string, number>();
        for (const it of items) {
          const seen = new Set<string>();
          for (const slug of it.progs || []) {
            if (!PROG[slug] || seen.has(slug)) continue;
            seen.add(slug);
            cover.set(slug, (cover.get(slug) || 0) + 1);
          }
        }
        let rows = [...cover.entries()].map(([slug, covered]) => ({
          slug, covered, total, pct: total > 0 ? Math.round((covered / total) * 100) : 0,
        }));
        // Kasutaja prioriteet (progOrder) — kui olemas, järjesta selle järgi; uued lõppu.
        const order = CURRENT?.progOrder || [];
        if (order.length) {
          rows.sort((a, b) => {
            const ia = order.indexOf(a.slug), ib = order.indexOf(b.slug);
            if (ia === -1 && ib === -1) return b.covered - a.covered;
            if (ia === -1) return 1;
            if (ib === -1) return -1;
            return ia - ib;
          });
        } else {
          rows.sort((a, b) => (b.covered - a.covered) || a.slug.localeCompare(b.slug));
        }
        return rows;
      };

      const renderProgrammes = (): void => {
        if (!CURRENT) return;
        const body = $("[data-progs-body]")!;
        const empty = $("[data-progs-empty]");
        const rows = computeProgRows();
        setCount("[data-count-prog]", rows.length);
        if (!rows.length) {
          body.innerHTML = "";
          if (empty) empty.hidden = false;
          return;
        }
        if (empty) empty.hidden = true;
        // Sünkroni progOrder nähtava järjekorraga (et nooled oleksid stabiilsed).
        CURRENT.progOrder = rows.map((r) => r.slug);
        body.innerHTML = rows.map((r, i) => {
          const p = PROG[r.slug];
          const facts = [p.provider, p.ects != null ? `${p.ects} EAP` : "", p.price || ""].filter(Boolean).join(" · ");
          return `<div class="pm-prow" data-prog="${escHtml(r.slug)}">
            <div class="pm-rank" aria-hidden="true">${i + 1}</div>
            <div class="body">
              <div class="nm"><a href="/kataloog/${escHtml(r.slug)}/" data-track-event="cta_click" data-track-label="account_prog_detail">${escHtml(p.name)}</a></div>
              <div class="meta">${escHtml(facts)} · katab ${r.covered}/${r.total} oskust</div>
              <div class="pm-fitbar"><i style="width:${r.pct}%"></i></div>
            </div>
            <div class="pm-moves">
              <button type="button" class="pm-mv" data-prog-move="-1" data-slug="${escHtml(r.slug)}" ${i === 0 ? "disabled" : ""} aria-label="Liiguta ülespoole">↑</button>
              <button type="button" class="pm-mv" data-prog-move="1" data-slug="${escHtml(r.slug)}" ${i === rows.length - 1 ? "disabled" : ""} aria-label="Liiguta allapoole">↓</button>
            </div>
          </div>`;
        }).join("");
      };

      $("[data-progs-body]")?.addEventListener("click", (e) => {
        const t = e.target as HTMLElement;
        const dir = t.getAttribute("data-prog-move");
        const slug = t.getAttribute("data-slug");
        if (!dir || !slug || !CURRENT) return;
        const order = [...(CURRENT.progOrder || computeProgRows().map((r) => r.slug))];
        const i = order.indexOf(slug);
        const j = i + Number(dir);
        if (i < 0 || j < 0 || j >= order.length) return;
        [order[i], order[j]] = [order[j], order[i]];
        CURRENT.progOrder = order;
        persist();
        renderProgrammes();
        track("cta_click", { cta_label: "programme_reorder" });
      });

      // ---- KOGUM 3: Minu võrdlused ----
      // Sild: serveris/AMOS-is veel ei ole salvestatud võrdlusi → näitame
      // sissejuhatava tühiseisundi + lingi võrdluslehele. Kui hiljem tuleb
      // konto-API väli, saab siia loendi lisada (degradeerub graatsiliselt).
      const renderCompares = (): void => {
        const body = $("[data-compares-body]");
        if (!body) return;
        setCount("[data-count-cmp]", 0);
        body.innerHTML = `<p class="pm-empty">Sul pole veel salvestatud võrdlusi. Vali kataloogis kaks programmi ja vajuta „Võrdle kõrvuti" - võrdlus ilmub siia.</p>`;
      };

      // ---- FEATURE 2: meeldetuletused ----
      // Jälgitavad programmid = paketi programmid ∪ interest-slugid.
      const watchedSlugs = (): string[] => {
        if (!CURRENT) return [];
        const set = new Set<string>(CURRENT.interests);
        for (const pkg of CURRENT.packages) for (const it of pkg.items) for (const s of (it.progs || [])) set.add(s);
        return [...set].filter((s) => PROG[s]);
      };
      const renderReminders = (): void => {
        if (!CURRENT) return;
        const toggle = $("[data-reminders-toggle]") as HTMLInputElement;
        toggle.checked = CURRENT.reminders;
        const list = $("[data-reminders-list]")!;
        const slugs = watchedSlugs().filter((s) => PROG[s].registrationDeadline);
        if (!slugs.length) {
          list.innerHTML = `<p class="pm-empty">Sa ei jälgi veel ühtegi programmi tähtajaga. Lisa programm paketti või vajuta kataloogis „Teavita tähtajast", siis ilmub see siia. <a href="/kataloog/" data-track-event="cta_click" data-track-label="account_to_kataloog">Ava kataloog</a>.</p>`;
          return;
        }
        list.innerHTML = slugs.map((s) => {
          const p = PROG[s];
          return `<div class="pm-row" data-watch="${escHtml(s)}">
            <span><a href="/kataloog/${escHtml(s)}/">${escHtml(p.name)}</a>
              <span class="meta">Registreerimine kuni ${formatEt(p.registrationDeadline as string)}</span> ${dlBadge(p.registrationDeadline)}</span>
            <button type="button" class="pm-mini neutral" data-unwatch="${escHtml(s)}">Lakka jälgimast</button>
          </div>`;
        }).join("");
      };
      $("[data-reminders-toggle]")?.addEventListener("change", async (e) => {
        const on = (e.target as HTMLInputElement).checked;
        // REAL-PATH: meeldetuletus on serveri tellimus (kanooniline kind
        // "programme_reminder", target_ref "reminder_all" - teisendus piiril).
        // Sees → POST /subscriptions; väljas → leia serveri-tellimuse ref ja
        // POST /subscriptions/unsubscribe. Mõlemad degradeeruvad graatsiliselt.
        if (kontoEnabled()) {
          track("cta_click", { cta_label: "reminders_toggle", enabled: on ? "jah" : "ei" });
          if (on) {
            const res = await subscribeRemote("deadline_reminder", "all");
            if (res === "ok") {
              status("[data-reminders-status]", "Tehtud - tuletame tähtajad meelde.");
              await refreshServerSubs();
              track("reminder_subscribed", { enabled: "jah" });
            } else {
              (e.target as HTMLInputElement).checked = false;   // ära jäta valet "sees"-seisu
              status("[data-reminders-status]",
                res === "pending"
                  ? "Meeldetuletuste sisselülitamine siit on peagi tulekul."
                  : "Sisselülitamine ei õnnestunud. Proovi hetke pärast uuesti.",
                res === "error");
            }
          } else {
            const sub = (serverSubs || []).find((s) => s && (s.kind === "programme_reminder" || s.kind === "deadline_reminder" || s.kind === "reminder") && typeof s.ref === "string");
            const res = sub?.ref ? await unsubscribeRemote(sub.ref) : "pending";
            if (res === "ok") {
              status("[data-reminders-status]", "Meeldetuletused välja lülitatud.");
              await refreshServerSubs();
            } else {
              (e.target as HTMLInputElement).checked = true;
              status("[data-reminders-status]",
                res === "pending"
                  ? "Väljalülitamine siit on peagi tulekul. Praegu saad loobuda iga e-kirja jaluse lingiga."
                  : "Väljalülitamine ei õnnestunud. Proovi hetke pärast uuesti.",
                res === "error");
            }
          }
          return;
        }
        if (!CURRENT) return;
        CURRENT.reminders = on;
        persist();
        // LIVE-bridge: reminder_subscribed AMOS-i torusse (course_offers; kind veel lepingus defineerimata).
        if (on) await postSubscribe({ kind: "deadline_reminder", email: CURRENT.email, consent_purpose: "course_offers", slugs: watchedSlugs() });
        renderSubscriptions();
        status("[data-reminders-status]", on ? "Tehtud - tuletame tähtajad meelde." : "Meeldetuletused välja lülitatud.");
        track("cta_click", { cta_label: "reminders_toggle", enabled: on ? "jah" : "ei" });
        track("reminder_subscribed", { enabled: on ? "jah" : "ei" });
      });
      $("[data-reminders-list]")?.addEventListener("click", (e) => {
        const t = e.target as HTMLElement;
        const slug = t.getAttribute("data-unwatch");
        if (!slug || !CURRENT) return;
        CURRENT.interests = CURRENT.interests.filter((s) => s !== slug);
        persist();
        renderReminders();
        toast("Ei jälgi enam seda programmi.");
      });

      // ---- FEATURE 3: teavituslehed ----
      const renderNotify = (): void => {
        if (!CURRENT) return;
        // Kombinatsiooni-soovitus: kui mõne paketi match annab kombinatsiooni (combo_size>1, terviklik kate)
        const comboPrompt = $("[data-combo-prompt]")!;
        let comboItems: PkgItem[] | null = null;
        for (const pkg of CURRENT.packages) {
          const m = matchHtml(pkg.items);
          if (m.comboUncovered.length) { comboItems = pkg.items.filter((i) => m.comboUncovered.includes(i.key)); break; }
        }
        if (comboItems && comboItems.length > 1) {
          const names = comboItems.map((i) => i.text);
          const key = [...names].map((s) => s.toLowerCase()).sort().join(" + ");
          comboPrompt.dataset.comboKey = key;
          $("[data-combo-text]", comboPrompt)!.textContent =
            `Sinu pakett vajab praegu mitut eri programmi: ${names.join(" + ")}. Ühtegi üht programmi, mis kõik need oskused korraga annaks, praegu kataloogis pole.`;
          comboPrompt.hidden = CURRENT.comboWaitlist.includes(key);
        } else {
          comboPrompt.hidden = true;
        }

        // Oskuse-chipid paketi õpiväljunditest
        const skillWrap = $("[data-skill-chips]")!;
        const allSkills = new Set<string>();
        for (const pkg of CURRENT.packages) for (const it of pkg.items) allSkills.add(it.text);
        const available = [...allSkills].filter((s) => !CURRENT!.notifySkills.includes(s));
        if (available.length) {
          skillWrap.hidden = false;
          $("[data-skill-chip-row]", skillWrap)!.innerHTML = available
            .map((s) => `<button type="button" class="pm-skill-chip" data-skill="${escHtml(s)}">+ ${escHtml(s)}</button>`).join("");
        } else {
          skillWrap.hidden = true;
        }

        // Aktiivsed teavituslehed
        const list = $("[data-notify-list]")!;
        const rows: string[] = [];
        for (const f of CURRENT.notifyFields) rows.push(notifyRow("valdkond", f, `Valdkond: ${f}`));
        for (const s of CURRENT.notifySkills) rows.push(notifyRow("oskus", s, `Oskus: ${s}`));
        for (const c of CURRENT.comboWaitlist) rows.push(notifyRow("kombinatsioon", c, `Kombinatsioon: ${c}`));
        if (!rows.length) {
          list.innerHTML = `<p class="pm-empty" style="margin-top:12px">Sa ei jälgi veel ühtegi valdkonda ega kombinatsiooni. Vali ülalt, mis sind huvitab.</p>`;
        } else {
          list.innerHTML = rows.join("");
        }
      };
      const notifyRow = (kind: string, value: string, label: string): string =>
        `<div class="pm-row" data-notify-kind="${kind}" data-notify-value="${escHtml(value)}">
          <span>${escHtml(label)}</span>
          <button type="button" class="pm-mini neutral" data-notify-remove>Lakka jälgimast</button>
        </div>`;

      const addNotify = async (kind: "valdkond" | "oskus" | "kombinatsioon", value: string): Promise<void> => {
        if (!CURRENT || !value) return;
        if (kind === "valdkond") { if (!CURRENT.notifyFields.includes(value)) CURRENT.notifyFields.push(value); }
        else if (kind === "oskus") { if (!CURRENT.notifySkills.includes(value)) CURRENT.notifySkills.push(value); }
        else { if (!CURRENT.comboWaitlist.includes(value)) CURRENT.comboWaitlist.push(value); }
        persist();
        // LIVE-bridge: notify_list / combo_waitlist AMOS-i torusse.
        await postSubscribe({
          kind: "notify_list", email: CURRENT.email, consent_purpose: "course_offers",
          field: kind === "valdkond" ? value : null,
          combo: kind === "kombinatsioon" ? value.split(" + ") : (kind === "oskus" ? [value] : null),
        });
        renderNotify();
        renderSubscriptions();
        status("[data-notify-status]", "Lisatud - anname märku, kui sobiv programm või kombinatsioon lisandub.");
        const route = kind === "kombinatsioon" ? "notify_combo" : kind === "valdkond" ? "notify_field" : "notify_skill";
        track("result_high_intent", { result_route: route, combo_size: kind === "kombinatsioon" ? value.split(" + ").length : 1 });
        if (kind === "kombinatsioon") track("combo_waitlist", { combo_size: value.split(" + ").length });
      };

      $("[data-notify-field-add]")?.addEventListener("click", () => {
        const sel = $("[data-notify-field]") as HTMLSelectElement;
        if (!sel.value) return;
        // REAL-PATH: telli valdkonna-teavitus serverisse (POST /subscriptions).
        if (kontoEnabled()) {
          const field = sel.value;
          sel.value = "";
          subscribeRealAndNote("field", field, "Lisatud - anname märku, kui sellesse valdkonda sobiv programm lisandub.");
          return;
        }
        // DEMO-tee (flag maas): salvesta inimkeelne silt (select annab slugi),
        // et olemasolev demo-kuva jääks muutmata.
        addNotify("valdkond", FIELD_LABEL[sel.value] || sel.value); sel.value = "";
      });
      $("[data-skill-chip-row]")?.addEventListener("click", (e) => {
        const s = (e.target as HTMLElement).getAttribute("data-skill");
        if (!s) return;
        // REAL-PATH: oskuse-chipid tulevad kliendi paketist (CURRENT) ja seda
        // serveri-teel pole - chip-rida jääb serveri-teel tühjaks. Kui chip
        // siiski olemas (segarežiim), telli oskus serverisse.
        if (kontoEnabled()) { subscribeRealAndNote("skill", s, "Lisatud - anname märku, kui sellele oskusele programm lisandub."); return; }
        addNotify("oskus", s);
      });
      $("[data-combo-subscribe]")?.addEventListener("click", () => {
        const key = $("[data-combo-prompt]")?.dataset.comboKey;
        if (!key) return;
        if (kontoEnabled()) { subscribeRealAndNote("combo", key, "Lisatud - anname märku, kui see kombinatsioon lisandub."); return; }
        addNotify("kombinatsioon", key);
      });
      $("[data-notify-list]")?.addEventListener("click", (e) => {
        const t = e.target as HTMLElement;
        if (!t.matches("[data-notify-remove]") || !CURRENT) return;
        const row = t.closest("[data-notify-kind]") as HTMLElement;
        const kind = row.dataset.notifyKind, value = row.dataset.notifyValue || "";
        if (kind === "valdkond") CURRENT.notifyFields = CURRENT.notifyFields.filter((x) => x !== value);
        else if (kind === "oskus") CURRENT.notifySkills = CURRENT.notifySkills.filter((x) => x !== value);
        else CURRENT.comboWaitlist = CURRENT.comboWaitlist.filter((x) => x !== value);
        persist();
        renderNotify();
        renderSubscriptions();
        toast("Eemaldatud.");
      });

      // ---- MINU TELLIMUSED: ülevaade kõigist teavitustellimustest ----
      // Demo-tee koondab CURRENT-i tellimused üheks loendiks (eemaldamine peegeldab
      // olemasolevatesse jaotistesse). Serveri-tee näitab "tuleb peagi" tühjaseisu,
      // STRUKTUURITUNA nii, et kui /state hakkab tellimusi tagastama, joonistame need
      // sama loendina (vt renderServerSubscriptions). Mehhanism (loobumine serveris)
      // saabub koos backendiga - me ei võltsi serverikutset, mida veel pole.
      type SubRow = { kind: string; value: string; label: string; removable: boolean };
      const renderSubscriptions = (): void => {
        const list = $("[data-subs-list]");
        if (!list) return;
        if (!CURRENT) return;   // serveri-tee kasutab renderServerSubscriptions
        const rows: SubRow[] = [];
        if (CURRENT.reminders) rows.push({ kind: "reminder", value: "all", label: "Tähtaja-meeldetuletused (sees)", removable: true });
        for (const f of CURRENT.notifyFields) rows.push({ kind: "valdkond", value: f, label: `Valdkond: ${f}`, removable: true });
        for (const s of CURRENT.notifySkills) rows.push({ kind: "oskus", value: s, label: `Oskus: ${s}`, removable: true });
        for (const c of CURRENT.comboWaitlist) rows.push({ kind: "kombinatsioon", value: c, label: `Kombinatsioon: ${c}`, removable: true });
        if (!rows.length) {
          list.innerHTML = `<p class="pm-empty">Sa pole veel ühtegi teavitust tellinud. Lisa allpool valdkond, oskus või kombinatsioon - siis anname märku, kui sobiv lisandub.</p>`;
          return;
        }
        list.innerHTML = rows.map((r) =>
          `<div class="pm-row" data-sub-kind="${escHtml(r.kind)}" data-sub-value="${escHtml(r.value)}">
            <span>${escHtml(r.label)}</span>
            ${r.removable ? `<button type="button" class="pm-mini neutral" data-sub-remove>Lõpeta tellimus</button>` : ""}
          </div>`).join("");
      };
      // Serveri-tee tellimuste vaade (LIVE): /state tagastab subscriptions[]
      // kujul { ref, kind, label_ref, state }. Kuvame iga tellimuse loetava
      // sildiga ja "Lõpeta tellimus" nupuga (POST /subscriptions/unsubscribe).
      // Tühi loend → puhas tühjaseis. Maha võtmine degradeerub graatsiliselt,
      // kui unsubscribe-otspunkt pole veel live (vt klõpsukäsitleja allpool).
      type ServerSub = { ref?: string; kind?: string; label_ref?: string; state?: string };
      // kind -> loetav eesliide (eesti, lühike). Tundmatu kind → "Tellimus".
      const SUB_KIND_LABEL: Record<string, string> = {
        // Kanoonilised backend-kinnid (amos.crm.package_subscription/v1).
        field: "Valdkond",
        skill: "Oskus",
        combination: "Kombinatsioon",
        programme_reminder: "Tähtaja-meeldetuletus",
        funding: "Toetuse profiil",
        // Vanad/sisemised sildid - jätame ühilduvuseks.
        valdkond: "Valdkond",
        oskus: "Oskus",
        kombinatsioon: "Kombinatsioon",
        combo: "Kombinatsioon",
        combo_waitlist: "Kombinatsioon",
        reminder: "Tähtaja-meeldetuletus",
        deadline_reminder: "Tähtaja-meeldetuletus",
        funding_profile: "Toetuse profiil",
        notify_list: "Teavitus",
      };
      // Rahastus-marsruudi viide -> inimkeelne nimi (rahastus_ise -> "ise maksan").
      const FUNDING_LABEL: Record<string, string> = {
        rahastus_ise: "maksan ise",
        rahastus_tootukassa: "Töötukassa kaudu",
        rahastus_tooandja: "tööandja maksab",
      };
      const subLabel = (s: ServerSub): string => {
        const kind = typeof s.kind === "string" ? s.kind : "";
        const prefix = SUB_KIND_LABEL[kind] || "Tellimus";
        const ref = typeof s.label_ref === "string" && s.label_ref.trim() ? s.label_ref.trim() : "";
        if (!ref) return prefix;
        // Tee läbipaistmatu viide loetavaks, kus oskame (valdkonna slug, rahastus,
        // tähtaja-sentinel); muidu kuva viide nii nagu on.
        if (kind === "field" && FIELD_LABEL[ref]) return `${prefix}: ${FIELD_LABEL[ref]}`;
        if (kind === "funding" && FUNDING_LABEL[ref]) return `${prefix}: ${FUNDING_LABEL[ref]}`;
        if (kind === "programme_reminder" && ref === "reminder_all") return prefix;
        return `${prefix}: ${ref}`;
      };
      const renderServerSubscriptions = (subs: ServerSub[] | null): void => {
        const list = $("[data-subs-list]");
        if (!list) return;
        const rows = (subs || []).filter((s) => s && (s.state == null || s.state === "active"));
        if (!rows.length) {
          list.innerHTML = `<p class="pm-empty">Sa pole veel ühtegi teavitust tellinud. Lisa allpool valdkond, oskus või kombinatsioon - siis anname märku, kui sobiv lisandub.</p>`;
          return;
        }
        list.innerHTML = rows.map((s) => {
          const ref = typeof s.ref === "string" ? s.ref : "";
          const removeBtn = ref
            ? `<button type="button" class="pm-mini neutral" data-server-unsub="${escHtml(ref)}">Lõpeta tellimus</button>`
            : "";
          return `<div class="pm-row" data-server-sub-ref="${escHtml(ref)}">
            <span>${escHtml(subLabel(s))}</span>
            ${removeBtn}
          </div>`;
        }).join("");
      };
      // REAL-PATH: lõpeta tellimus (POST /subscriptions/unsubscribe {ref}).
      // Õnnestumisel võtame rea ära; "pending" (404/401) korral hoiame nupu ja
      // näitame rahulikku ootel-teadet; tõrkel "proovi uuesti". Demo-tee
      // ([data-sub-remove]) on eraldi käsitleja ja jääb puutumata.
      $("[data-subs-list]")?.addEventListener("click", async (e) => {
        if (!kontoEnabled()) return;   // demo-tee kasutab [data-sub-remove]
        const btn = (e.target as HTMLElement).closest("[data-server-unsub]") as HTMLButtonElement | null;
        if (!btn) return;
        const ref = btn.getAttribute("data-server-unsub") || "";
        if (!ref) return;
        const row = btn.closest("[data-server-sub-ref]") as HTMLElement | null;
        const origLabel = btn.textContent || "Lõpeta tellimus";
        btn.disabled = true; btn.textContent = "Lõpetan…";
        const res = await unsubscribeRemote(ref);
        if (res === "ok") {
          row?.remove();
          const list = $("[data-subs-list]");
          if (list && !list.querySelector("[data-server-sub-ref]")) renderServerSubscriptions([]);
          toast("Tellimus lõpetatud.");
          track("cta_click", { cta_label: "subscription_remove" });
          return;
        }
        btn.disabled = false; btn.textContent = origLabel;
        if (res === "pending") {
          status("[data-notify-status]", "Tellimuse maha võtmine siit on peagi tulekul. Praegu saad loobuda iga e-kirja jaluse lingiga.");
        } else {
          status("[data-notify-status]", "Tellimuse lõpetamine ei õnnestunud. Proovi hetke pärast uuesti.", true);
        }
      });
      // REAL-PATH: pärast tellimuse lisamist tõmba /state uuesti ja joonista
      // tellimuste loend serveri tõe järgi (mitte oletatuna).
      const refreshServerSubs = async (): Promise<void> => {
        try {
          const srv = await fetchState();
          serverSubs = Array.isArray(srv?.subscriptions) ? srv!.subscriptions : null;
          renderServerSubscriptions(serverSubs);
        } catch { /* hoia praegune vaade */ }
      };
      // REAL-PATH: telli teavitus (POST /subscriptions {kind,target_ref}).
      // "ok" → kinnita + värskenda loend serverist; "pending" (404/401) → aus
      // ootel-teade (otspunkt pole veel live); "error" → proovi uuesti.
      const subscribeRealAndNote = async (kind: string, targetRef: string, okMsg: string): Promise<void> => {
        const res = await subscribeRemote(kind, targetRef);
        if (res === "ok") {
          status("[data-notify-status]", okMsg);
          await refreshServerSubs();
          track("result_high_intent", { result_route: `notify_${kind}` });
        } else if (res === "pending") {
          status("[data-notify-status]", "Tellimuse lisamine siit on peagi tulekul. Praegu kogume su huvi ja anname teada, kui see live'i läheb.");
        } else {
          status("[data-notify-status]", "Tellimuse lisamine ei õnnestunud. Proovi hetke pärast uuesti.", true);
        }
      };
      $("[data-subs-list]")?.addEventListener("click", (e) => {
        const t = e.target as HTMLElement;
        if (!t.matches("[data-sub-remove]") || !CURRENT) return;
        const row = t.closest("[data-sub-kind]") as HTMLElement;
        const kind = row.dataset.subKind, value = row.dataset.subValue || "";
        if (kind === "reminder") {
          CURRENT.reminders = false;
          const tog = $("[data-reminders-toggle]") as HTMLInputElement | null;
          if (tog) tog.checked = false;
        } else if (kind === "valdkond") {
          CURRENT.notifyFields = CURRENT.notifyFields.filter((x) => x !== value);
        } else if (kind === "oskus") {
          CURRENT.notifySkills = CURRENT.notifySkills.filter((x) => x !== value);
        } else if (kind === "kombinatsioon") {
          CURRENT.comboWaitlist = CURRENT.comboWaitlist.filter((x) => x !== value);
        }
        persist();
        renderNotify();
        renderReminders();
        renderSubscriptions();
        toast("Tellimus lõpetatud.");
        track("cta_click", { cta_label: "subscription_remove", sub_kind: kind || "" });
      });

      // ---- FEATURE 4: toetuse profiil ----
      const renderFunding = (): void => {
        if (!CURRENT) return;
        $$("[data-funding]").forEach((el) => {
          (el as HTMLInputElement).checked = (el as HTMLInputElement).value === CURRENT!.funding_route;
        });
      };
      $$("[data-funding]").forEach((el) => el.addEventListener("change", async (e) => {
        const route = (e.target as HTMLInputElement).value as "ise" | "tootukassa" | "tooandja";
        // REAL-PATH: toetuse profiil on serveri tellimus (kanooniline kind
        // "funding", target_ref "rahastus_<route>" - teisendus piiril).
        // POST /subscriptions; degradeerub graatsiliselt.
        if (kontoEnabled()) {
          track("tool_completed", { tool_name: "funding_profile", result_route: route });
          track("funding_profile_set", { result_route: route });
          const res = await subscribeRemote("funding_profile", route);
          if (res === "ok") {
            status("[data-funding-status]", "Salvestatud - kohandame su teavitused selle järgi.");
            await refreshServerSubs();
          } else {
            status("[data-funding-status]",
              res === "pending"
                ? "Toetuse profiili salvestamine siit on peagi tulekul."
                : "Salvestamine ei õnnestunud. Proovi hetke pärast uuesti.",
              res === "error");
          }
          return;
        }
        if (!CURRENT) return;
        CURRENT.funding_route = route;
        persist();
        // LIVE-bridge: funding_profile AMOS-i torusse (kind veel lepingus defineerimata).
        await postSubscribe({ kind: "funding_profile", email: CURRENT.email, consent_purpose: "course_offers", funding_route: route });
        status("[data-funding-status]", "Salvestatud - kohandame su teavitused selle järgi.");
        track("tool_completed", { tool_name: "funding_profile", result_route: route });
        track("funding_profile_set", { result_route: route });
      }));

      // ---- FEATURE 5: nõusolek & andmed ----
      $("[data-consent-withdraw]")?.addEventListener("click", async () => {
        if (!CURRENT) return;
        const ok = await confirmModal("Võta nõusolek tagasi?", "Pärast seda me sulle teavitusi ei saada. Su konto ja paketid jäävad alles. Kindel?", "Jah, võta tagasi");
        if (!ok) return;
        CURRENT.consent = false;
        CURRENT.reminders = false;
        persist();
        renderReminders();
        status("[data-consent-status]", "Nõusolek tagasi võetud. Teavitusi me sulle enam ei saada.");
        track("cta_click", { cta_label: "consent_withdraw" });
      });
      $("[data-data-download]")?.addEventListener("click", () => {
        if (!CURRENT) return;
        toast("Saadame su andmete koopia e-postiga.");
        // BRIDGE: tootmises käivitab see AMOS-i andmete-koopia voo.
      });
      $("[data-account-delete]")?.addEventListener("click", async () => {
        if (!CURRENT) return;
        const ok = await confirmModal(
          "Kustuta konto?",
          "Kustutame su paketid, teavituslehed, meeldetuletused ja profiili. Seda ei saa tagasi võtta. Su e-post pannakse loobumisnimekirja, et sulle enam ei kirjutataks.",
          "Jah, kustuta konto");
        if (!ok) return;
        if (kontoEnabled()) {
          // REAL PATH (flag ON): AMOS kustutab paketid serverist; deleteAccount()
          // pühib KOGU kohaliku konto-oleku (sessioon + nimekaart + pkgref-kaart).
          // EI kutsu postSubscribe — see on DEMO-tee. PII ei lähe analüütikasse.
          await deleteAccount();
          clearTypedEmail();   // pühi ka sama-seadme kuvatav e-post
          track("cta_click", { cta_label: "account_delete" });
          CURRENT = null;
          if (emailInput) emailInput.value = "";
          if (consentInput) consentInput.checked = false;
          renderAnonBanner();
          showScreen("auth");
          toast("Konto ja paketid kustutatud.");
          return;
        }
        // DEMO PATH (flag OFF): puutumata — sild AMOS-i erasure-kujuga.
        track("cta_click", { cta_label: "account_delete" });
        // LIVE-bridge: AMOS-i kustutus käib erasure-kujuga (suppression → deletion).
        await postSubscribe({ kind: "account_delete", email: CURRENT.email });
        clearAccount();
        CURRENT = null;
        toast("Su konto on kustutatud. Aitäh, et proovisid.");
        // logi välja
        if (emailInput) emailInput.value = "";
        if (consentInput) consentInput.checked = false;
        renderAnonBanner();
        showScreen("auth");
      });

      // ---- Logi välja ----
      $("[data-logout]")?.addEventListener("click", () => {
        // REAL PATH: lõpeta seanss (kustuta token). DEMO: tühista ainult sild.
        if (kontoEnabled()) clearSession();
        clearTypedEmail();   // sama-seadme kuvatav e-post läheb koos väljalogimisega
        CURRENT = null;
        renderAnonBanner();
        showScreen("auth");
      });

      // ---- Kogumite sakid (tabs) ----
      $$("[data-tab]").forEach((btn) => btn.addEventListener("click", () => {
        const t = btn.getAttribute("data-tab");
        $$("[data-tab]").forEach((b) => {
          const on = b.getAttribute("data-tab") === t;
          b.classList.toggle("on", on);
          b.setAttribute("aria-selected", on ? "true" : "false");
        });
        $$(".pm-pane").forEach((p) => p.classList.toggle("on", p.id === `pane-${t}`));
        track("cta_click", { cta_label: "account_tab", tab: t || "" });
      }));

      // ====================================================================
      // REAL PATH (flag ON): renderda konto-ekraan SERVERI pakettidest.
      // Nimed + nimekaart jäävad localStorage'i; serverisse EI saadeta kunagi.
      // ====================================================================
      type ServerPackage = {
        package_ref: string;
        outcome_refs?: string[];
        fit?: {
          fit_version?: string;
          package_size?: number;
          best_single?: {
            variant_ref?: string;
            covered_count?: number;
            fully_covers?: boolean;
            title?: string | null;
            school?: string | null;
            eap?: number | null;
          } | null;
          combination?: {
            variants?: {
              variant_ref?: string;
              adds_refs?: string[];
              title?: string | null;
              school?: string | null;
              eap?: number | null;
            }[];
            covered_refs?: string[];
            uncovered_refs?: string[];
            fully_covered?: boolean;
            program_count?: number;
          };
        } | null;
        last_best_single_covered_count?: number | null;
        last_covered_count?: number | null;
        last_program_count?: number | null;
        last_fully_covered?: boolean | null;
        last_best_variant_ref?: string | null;
      };

      const slugLike = (ref: string): boolean => /^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(ref);
      const serverVariantLine = (v: { variant_ref?: string; title?: string | null; school?: string | null; eap?: number | null }, covered: number | null, total: number): string => {
        const ref = typeof v.variant_ref === "string" ? v.variant_ref : "";
        const title = (typeof v.title === "string" && v.title.trim()) ? v.title.trim() : (ref || "Sobiv programm");
        const label = slugLike(ref)
          ? `<a href="/kataloog/${escHtml(ref)}/">${escHtml(title)}</a>`
          : escHtml(title);
        const meta = [
          typeof v.school === "string" && v.school.trim() ? escHtml(v.school.trim()) : "",
          typeof v.eap === "number" && Number.isFinite(v.eap) ? `${v.eap} EAP` : "",
          covered != null && total > 0 ? `katab ${covered}/${total}` : "",
        ].filter(Boolean).join(" · ");
        return `${label}${meta ? ` <span style="color:var(--pm-muted);font-size:0.88rem">${meta}</span>` : ""}`;
      };

      const realFitHtml = (pkg: ServerPackage, total: number): string => {
        const fit = pkg.fit;
        const best = fit?.best_single || null;
        const combo = fit?.combination || null;
        if (fit && best) {
          const bestCovered = typeof best.covered_count === "number" ? best.covered_count : null;
          let html = `<div class="pm-match"><h4 style="font-family:var(--pm-disp);font-weight:700;margin:0 0 5px">Sobivaim sinu paketile</h4>`;
          html += `<p style="margin:0 0 6px">${serverVariantLine(best, bestCovered, total)}</p>`;
          if (best.fully_covers === true) {
            html += `<p class="pm-tiny" style="color:var(--pm-green-deep);font-weight:700">See üks programm katab kogu su paketi.</p>`;
          } else if (combo && Array.isArray(combo.variants) && combo.variants.length) {
            const covered = Array.isArray(combo.covered_refs) ? combo.covered_refs.length : null;
            html += `<p style="font-family:var(--pm-disp);font-weight:700;margin:8px 0 5px">Täielikuks katteks sobib kombinatsioon${covered != null ? ` (${covered}/${total})` : ""}:</p>`;
            html += `<ol style="margin:0;padding-left:20px;display:grid;gap:4px">${combo.variants.map((v) => {
              const adds = Array.isArray(v.adds_refs) ? v.adds_refs.length : null;
              return `<li>${serverVariantLine(v, adds, total)}</li>`;
            }).join("")}</ol>`;
            if (combo.fully_covered === true) {
              html += `<p class="pm-tiny" style="margin-top:8px">Üksik programm ei kata veel kõike, aga kombinatsioon annab täiskatte.</p>`;
            } else {
              html += `<p class="pm-tiny" style="margin-top:8px">Praegune kataloog ei kata veel kõiki valitud oskusi. Anname märku, kui parem vaste lisandub.</p>`;
            }
          }
          return `${html}</div>`;
        }

        const covered = pkg.last_covered_count ?? null;
        const bestSingle = pkg.last_best_single_covered_count ?? null;
        const progN = pkg.last_program_count ?? null;
        const full = pkg.last_fully_covered === true;
        if (covered == null || progN == null) return "";
        const coverLine = full
          ? `Parim kate: ${bestSingle ?? covered}/${total} oskust ühest programmist.`
          : `Parim kate: ${covered}/${total} oskust ${progN} programmiga.`;
        return `<p class="pm-tiny" style="margin-top:8px">${escHtml(coverLine)}</p>`;
      };

      // Serveri-tee tellimused (LIVE): syncAndRenderReal seab selle /state
      // vastusest (subscriptions[]). null/tühi → puhas tühjaseis.
      let serverSubs: ServerSub[] | null = null;
      const renderRealAccount = (packages: ServerPackage[]): void => {
        const body = $("[data-skills-body]");
        const emptyActions = $("[data-packages-empty-actions]");
        const bestBox = $("[data-best-match]");
        renderServerSubscriptions(serverSubs);   // tellimuste ülevaade (serveri-tee)
        if (!body) return;
        if (bestBox) bestBox.hidden = true;
        // Serveri-teel pole kliendi õpiväljundi-teksti ega kaalu (PII-vaba sild),
        // seega Minu oskused -kogum näitab paketi-kaarte serveri kattuvusega.
        // Kaalukontroll/jälgime-rida on demo-tee (klient-tekst) omadus; serveri-tee
        // degradeerub graatsiliselt: pakett + suurus + sobivuse plokk.
        const totalOutcomes = packages.reduce((s, p) => s + (p.outcome_refs?.length ?? 0), 0);
        setCount("[data-count-osk]", totalOutcomes);
        setCount("[data-count-prog]", packages.length);
        setCount("[data-count-cmp]", 0);
        if (!packages.length) {
          body.innerHTML = `<p class="pm-empty">Sul pole veel salvestatud paketti. Mine oskuste lehele, korja sobivad oskused ja vajuta „Salvesta kontole".</p>`;
          if (emptyActions) emptyActions.hidden = false;
          renderRealProgrammes([]);
          renderCompares();
          showScreen("account");
          return;
        }
        if (emptyActions) emptyActions.hidden = true;
        body.innerHTML = "";
        // Järjesta serveri salvestatud tähtsuse (weight) järgi - väiksem = tähtsam.
        // Nii püsib kasutaja seatud reprioritiseerimine ka uuel laadimisel/teises seadmes.
        const ordered = [...packages].sort((a, b) => {
          const wa = typeof (a as any).weight === "number" ? (a as any).weight : Number.MAX_SAFE_INTEGER;
          const wb = typeof (b as any).weight === "number" ? (b as any).weight : Number.MAX_SAFE_INTEGER;
          return wa - wb;
        });
        for (const pkg of ordered) {
          const name = getNamesFor(pkg.package_ref) || "Pakett";   // ainult kliendipoolne nimi
          const size = pkg.outcome_refs?.length ?? 0;
          const card = document.createElement("div");
          card.className = "pm-srow";
          card.style.alignItems = "flex-start";
          card.dataset.pkgRef = pkg.package_ref;
          const match = realFitHtml(pkg, size);
          card.innerHTML = `
            <div class="body">
              <div class="nm">${escHtml(name)} <span class="pm-tag ok">${size} oskust</span></div>
              ${match}
              <p class="pm-status" data-pkg-status hidden></p>
            </div>
            <button type="button" class="pm-mini neutral" data-pkg-remove="${escHtml(pkg.package_ref)}">Eemalda</button>`;
          body.appendChild(card);
        }
        renderRealProgrammes(packages);
        renderCompares();
        track("package_view", { count: totalOutcomes });
        showScreen("account");
      };

      // ---- REAL-PATH: ühe paketi EEMALDAMINE (POST /packages/delete) ----
      // Delegeeritud klõps Minu oskused -kogumi kaartidel. Õnnestumisel võtame
      // kaardi ära ja puhastame kohaliku pkgref-kaardi rea. Kui otspunkt pole
      // veel live (404/401 → "pending"), HOIAME nupu alles ja näitame rahulikku
      // "tuleb peagi" seisu - EI võltsi edu. Tõrkel rahulik "proovi uuesti".
      let pkgDeleteBusy = false;
      $("[data-skills-body]")?.addEventListener("click", async (e) => {
        if (!kontoEnabled()) return;   // demo-tee ei kasuta serveri-kustutust
        const btn = (e.target as HTMLElement).closest("[data-pkg-remove]") as HTMLButtonElement | null;
        if (!btn) return;
        const ref = btn.getAttribute("data-pkg-remove") || "";
        if (!ref || pkgDeleteBusy) return;
        const card = btn.closest("[data-pkg-ref]") as HTMLElement | null;
        const statusEl = card ? (card.querySelector("[data-pkg-status]") as HTMLElement | null) : null;
        const showCard = (msg: string): void => { if (statusEl) { statusEl.textContent = msg; statusEl.hidden = false; } };
        const ok = await confirmModal(
          "Eemalda see pakett?",
          "Võtame selle paketi su kontolt ära. Su teised paketid ja oskused jäävad alles.",
          "Jah, eemalda");
        if (!ok) return;
        pkgDeleteBusy = true;
        const origLabel = btn.textContent || "Eemalda";
        btn.disabled = true; btn.textContent = "Eemaldan…";
        const res = await deletePackageRemote(ref);
        pkgDeleteBusy = false;
        if (res === "ok") {
          // Puhasta kohalik pkgref-kaart (client_id -> package_ref) sellest reast.
          try {
            const map = readPkgRefMap();
            for (const cid of Object.keys(map)) if (map[cid] === ref) delete map[cid];
            writePkgRefMap(map);
          } catch { /* private mode */ }
          card?.remove();
          toast("Pakett eemaldatud.");
          track("cta_click", { cta_label: "package_remove" });
          // Kui ühtegi kaarti enam pole, näita tühjaseisu.
          const body = $("[data-skills-body]");
          if (body && !body.querySelector("[data-pkg-ref]")) {
            body.innerHTML = `<p class="pm-empty">Sul pole enam ühtegi salvestatud paketti. Mine oskuste lehele, korja sobivad oskused ja vajuta „Salvesta kontole".</p>`;
            const emptyActions = $("[data-packages-empty-actions]");
            if (emptyActions) emptyActions.hidden = false;
            setCount("[data-count-osk]", 0);
            setCount("[data-count-prog]", 0);
            renderRealProgrammes([]);
          }
          return;
        }
        btn.disabled = false; btn.textContent = origLabel;
        if (res === "pending") {
          showCard("Paketi eemaldamine siit on peagi tulekul. Praegu saad kogu konto kustutada allpool.");
        } else {
          showCard("Eemaldamine ei õnnestunud. Proovi hetke pärast uuesti.");
        }
      });

      // Serveri-tee programmide kogum: parim üksik + kombinatsioon kõigist pakettidest.
      const renderRealProgrammes = (packages: ServerPackage[]): void => {
        const body = $("[data-progs-body]");
        const empty = $("[data-progs-empty]");
        if (!body) return;
        const lines: string[] = [];
        let rank = 1;
        for (const pkg of packages) {
          const total = pkg.outcome_refs?.length ?? 0;
          const best = pkg.fit?.best_single || null;
          if (best && best.variant_ref) {
            const pct = total > 0 && typeof best.covered_count === "number" ? Math.round((best.covered_count / total) * 100) : 0;
            lines.push(`<div class="pm-prow">
              <div class="pm-rank" aria-hidden="true">${rank++}</div>
              <div class="body"><div class="nm">${serverVariantLine(best, typeof best.covered_count === "number" ? best.covered_count : null, total)}</div>
              <div class="pm-fitbar"><i style="width:${pct}%"></i></div></div>
            </div>`);
          }
        }
        setCount("[data-count-prog]", lines.length);
        if (!lines.length) {
          body.innerHTML = "";
          if (empty) empty.hidden = false;
          return;
        }
        if (empty) empty.hidden = true;
        body.innerHTML = lines.join("");
      };

      // Sünki kohalikud paketid üles (idempotentne) ja renderda serveri seisust.
      const syncAndRenderReal = async (): Promise<void> => {
        try {
          const local = loadLocalState();
          if (local.packages.length) {
            const knownMap = readPkgRefMap();
            const payload = buildSyncPayload(local, outcomeRefForText, (clientId: string) => knownMap[clientId]);
            if (payload && payload.length) {
              const synced = await syncPackages(payload);
              if (synced && synced.packages) {
                const nextMap = { ...knownMap };
                for (const row of synced.packages) nextMap[row.client_id] = row.package_ref;
                writePkgRefMap(nextMap);
                const names = namesFromSync(local, synced.packages);
                for (const ref of Object.keys(names)) setName(ref, names[ref]);
                if (packagesUnsyncable(local, outcomeRefForText) > 0) {
                  toast("Mõnda paketti ei saanud veel sünkroonida.");
                }
              }
            }
          }
        } catch { /* sünk parima võimaliku; renderda ikkagi serveri seis */ }
        const bridge = $("[data-bridge-banner]");
        if (bridge) (bridge as HTMLElement).hidden = true;   // REAL: see pole demorežiim
        // VASTUPIDAVUS: fetchState neelab võrgu-/401-tõrke ise (→ null), aga
        // hoiame renderduse omaette try/catch'is, et ükski ootamatu viga EI
        // jätaks kasutajat tühjale ekraanile. Tõrke korral näitame ikkagi konto
        // ekraani tühja-seisundiga (renderRealAccount([]) joonistab tühja teate).
        let srvPackages: ServerPackage[] = [];
        let masked: string | null = null;
        try {
          const srv = await fetchState();
          srvPackages = (srv?.packages as ServerPackage[]) ?? [];
          // LIVE: server tagastab maskitud e-posti (`email_masked`, nt
          // "a***@ettevote.ee"). Kuvame selle PEAMISE identiteedina - see
          // töötab ka risti-seadmel (ei sõltu sama-seadme kirjutatud e-postist).
          masked = srv?.email_masked ?? null;
          // LIVE: server tagastab tellimuste loendi (`subscriptions`). Kuvame
          // need "Minu tellimused" all; tühi → puhas tühjaseis.
          serverSubs = Array.isArray(srv?.subscriptions) ? srv!.subscriptions : null;
        } catch { srvPackages = []; }
        // IDENTITEET: 1) serveri maskitud e-post (kui tuleb), 2) sama-seadme
        // kirjutatud e-post, 3) neutraalne "Sinu konto" + märge, et e-post on peagi.
        renderIdentity(masked, readTypedEmail());
        try {
          renderRealAccount(srvPackages);
        } catch {
          renderRealAccount([]);   // näita konto tühja-seisundit, mitte tühja keha
        }
      };

      // ---- Sisselogitud identiteet ("kellena sa oled, mis e-mailiga") ----
      // Kolm taset, kõige usaldusväärsem esimesena:
      //   1) serveri MASKITUD e-post (email_masked) - töötab RISTI-SEADMEL,
      //      sest tuleb serverist, mitte sellest brauserist. PEAMINE identiteet.
      //   2) sama-seadme kirjutatud e-post (kui server seda veel ei anna ja
      //      kasutaja logis samas brauseris sisse).
      //   3) neutraalne "Sinu konto" + rahulik märge (risti-seade, e-postita).
      const renderIdentity = (maskedEmail: string | null, typedEmail: string | null): void => {
        const el = $("[data-account-email]");
        if (!el) return;
        if (maskedEmail) {
          el.textContent = `Sa oled sees e-postiga ${maskedEmail}`;
        } else if (typedEmail) {
          el.textContent = `Sa oled sees e-postiga ${typedEmail}`;
        } else {
          // Risti-seadme sisselogimine: me ei tea e-posti ega päki seda välja.
          el.innerHTML = `Sinu konto <span class="pm-soon">(e-posti kuvamine on peagi)</span>`;
        }
      };

      // ====================================================================
      // ALGSEISUND
      //   REAL (flag ON) + seanss   -> sünki kohalikud paketid, renderda serverist.
      //   REAL (flag ON) + seanssita -> väljalogitud hero (e-posti vorm).
      //   DEMO (flag OFF)            -> olemasolev mkval:account sild (MUUTMATA).
      // ====================================================================
      const boot = (): void => {
        renderAnonBanner();
        if (kontoEnabled()) {
          if (getSession()) {
            // VASTUPIDAVUS: kui serveri-laadimine ootamatult tõrgub, ÄRA jäta
            // kasutajat tühjale ekraanile - näita konto tühja-seisundit (sees,
            // aga ilma pakettideta), et keha oleks alati olemas.
            syncAndRenderReal().catch(() => { renderRealAccount([]); });
          } else { showScreen("auth"); }
          return;
        }
        // ===== DEMO PATH (flag OFF): MUUTMATA loogika =====
        const existing = readAccount();
        if (existing && existing.email) {
          renderAccount(existing);
          showScreen("account");
        } else {
          showScreen("auth");
        }
      };
      boot();
    </script>
  </body>
</html>
