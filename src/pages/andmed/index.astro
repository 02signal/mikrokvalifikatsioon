---
import Seo from "../../components/Seo.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/global.css";
import Nav from "../../components/Nav.astro";
import { catalog, providers, fields, catalogCheckedAt, catalogUpdatedAt } from "../../data/catalog";
import { parsePriceEur } from "../../data/courseSchema";
import {
  ehisAttribution,
  ehisFetchedAt,
  ehisFieldCount,
  ehisFieldStats,
  ehisLicence,
  ehisProgrammeCount,
  ehisProviderCount,
  ehisProviderStats,
  ehisProviderTypeStats
} from "../../data/ehisFacts";

const checkedAtText = catalogCheckedAt.split("-").reverse().join(".");
const updatedAtText = catalogUpdatedAt.split("-").reverse().join(".");
const ehisFetchedAtText = ehisFetchedAt.split("-").reverse().join(".");

const byField = fields
  .map((field) => ({ field, count: catalog.filter((entry) => entry.field === field).length }))
  .sort((a, b) => b.count - a.count);
const maxField = Math.max(...byField.map((f) => f.count));

const providerTypes = [
  { type: "ülikool", label: "Ülikoolid" },
  { type: "rakenduskõrgkool", label: "Rakenduskõrgkoolid" },
  { type: "erakool", label: "Erakoolitajad" }
]
  .map((t) => ({ ...t, count: catalog.filter((e) => e.providerType === t.type).length }))
  .filter((t) => t.count > 0);

const formats = [
  { format: "veebis", label: "Veebis" },
  { format: "hübriid", label: "Hübriid" },
  { format: "kohapeal", label: "Kohapeal" }
]
  .map((f) => ({ ...f, count: catalog.filter((e) => e.format === f.format).length }))
  .filter((f) => f.count > 0);

const prices = catalog
  .map((e) => parsePriceEur(e.priceText))
  .filter((p): p is number => p != null && p > 0);
const minPrice = prices.length ? Math.min(...prices) : null;
const maxPrice = prices.length ? Math.max(...prices) : null;
const freeCount = catalog.filter((e) => parsePriceEur(e.priceText) === 0).length;
const withPrice = catalog.filter((e) => e.priceText).length;

const ectsVals = catalog.map((e) => e.ects).filter((n): n is number => n != null);
const minEcts = ectsVals.length ? Math.min(...ectsVals) : null;
const maxEcts = ectsVals.length ? Math.max(...ectsVals) : null;

const etCount = catalog.filter((e) => e.language === "et").length;
const enCount = catalog.filter((e) => e.language === "en").length;
const topEhisProviders = ehisProviderStats.slice(0, 10);
const maxEhisProvider = Math.max(...topEhisProviders.map((row) => row.count));
const topEhisFields = ehisFieldStats.slice(0, 10);
const maxEhisField = Math.max(...topEhisFields.map((row) => row.count));

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://mikrokvalifikatsioon.ee/#organization",
      name: "Mikrokvalifikatsioon.ee",
      legalName: "Ettevõtluskeskus OÜ",
      url: "https://mikrokvalifikatsioon.ee/"
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Avaleht", item: "https://mikrokvalifikatsioon.ee/" },
        { "@type": "ListItem", position: 2, name: "Andmed", item: "https://mikrokvalifikatsioon.ee/andmed/" }
      ]
    },
    {
      "@type": "Dataset",
      name: "Eesti mikrokvalifikatsioonide ja mikrokraadide andmekiht",
      description: `Avaandmestik sisaldab kahte kihti: EHIS ametlik faktikiht (${ehisProgrammeCount} registreeritud õppekava ${ehisProviderCount} pakkujalt) ning õppijale võrreldav kasutajakataloog (${catalog.length} programmi ${providers.length} pakkujalt koos hinna, formaadi ja vastuvõtuga).`,
      url: "https://mikrokvalifikatsioon.ee/andmed/",
      inLanguage: "et",
      dateModified: catalogUpdatedAt,
      temporalCoverage: `${ehisFetchedAt}/${catalogCheckedAt}`,
      license: "https://creativecommons.org/licenses/by/4.0/",
      creator: { "@id": "https://mikrokvalifikatsioon.ee/#organization" },
      variableMeasured: ["EHIS õppekava kood", "programmi nimi", "pakkuja", "pakkuja tüüp", "valdkond", "maht (EAP)", "õpiväljundid", "hind", "õppevorm", "keel", "vastuvõtt"],
      distribution: [
        { "@type": "DataDownload", name: "Õppijale võrreldav kasutajakataloog", encodingFormat: "application/json", contentUrl: "https://mikrokvalifikatsioon.ee/catalog.json" },
        { "@type": "DataDownload", name: "EHIS ametlik faktikiht", encodingFormat: "application/json", contentUrl: "https://mikrokvalifikatsioon.ee/ehis-catalog.json" }
      ]
    }
  ]
};
---

<!doctype html>
<html lang="et">
  <head>
    <Seo
      title="Andmed | Eesti mikrokvalifikatsioonide turg ja avaandmed"
      description={`Eesti mikrokvalifikatsioonide turg andmetes: EHIS ametlik faktikiht ${ehisProgrammeCount} õppekava / ${ehisProviderCount} pakkujat ja võrreldav kataloog ${catalog.length} programmi / ${providers.length} pakkujat.`}
      canonicalPath="/andmed/"
      ogTitle="Eesti mikrokvalifikatsioonide turg andmetes"
      ogDescription="Turukaart ja avaandmed: programmide arv, pakkujad, valdkonnad, hinnad ja mahud — masinloetavalt."
      jsonLd={schema}
    />
  </head>
  <body>
    <Nav />

    <main class="report-page simple-report">
      <section class="report-hero simple-report-hero">
        <div class="section-inner">
          <span class="eyebrow">Avaandmed ja turukaart</span>
          <h1>Eesti mikrokvalifikatsioonide turg andmetes.</h1>
          <p>
            Koondvaade kahest kihist: EHIS ametlik faktikiht näitab kogu registreeritud
            mikrokvalifikatsiooni õppekavade universumit; võrreldav kataloog lisab õppijale olulised
            kasutusandmed nagu hind, õppevorm, vastuvõtt ja kooli leht.
          </p>
          <div class="actions">
            <a class="btn btn-primary" href="/ehis-catalog.json" data-track-event="cta_click" data-track-label="andmed_ehis_json">Ava EHIS faktikiht</a>
            <a class="btn btn-secondary" href="/catalog.json" data-track-event="cta_click" data-track-label="andmed_catalog_json">Ava võrreldav kataloog</a>
            <a class="btn btn-secondary" href="/kuidas-koostame/" data-track-event="cta_click" data-track-label="andmed_metoodika">Kuidas andmed kogume</a>
          </div>
          <p class="report-date">EHIS snapshot: {ehisFetchedAtText}. Võrreldav kataloog uuendatud: {updatedAtText}. Avalikud allikafaktid kontrollitud: {checkedAtText}</p>
        </div>
      </section>

      <section class="white">
        <div class="section-inner">
          <div class="proof wide-proof">
            <div><strong>{ehisProgrammeCount}</strong><span>EHIS registreeritud õppekava</span></div>
            <div><strong>{ehisProviderCount}</strong><span>EHIS pakkujat</span></div>
            <div><strong>{ehisFieldCount}</strong><span>EHIS õppekavarühma</span></div>
            <div><strong>{catalog.length}</strong><span>võrreldavat kataloogikirjet</span></div>
            <div><strong>{providers.length}</strong><span>kooli kataloogis</span></div>
            <div><strong>{fields.length}</strong><span>valdkonda</span></div>
            {minEcts != null && maxEcts != null && (
              <div><strong>{minEcts}–{maxEcts}</strong><span>EAP vahemik</span></div>
            )}
            {minPrice != null && maxPrice != null && (
              <div><strong>{minPrice}–{maxPrice} €</strong><span>hinnavahemik ({withPrice} avaldatud)</span></div>
            )}
            {freeCount > 0 && (
              <div><strong>{freeCount}</strong><span>sihtrühmale rahastatud</span></div>
            )}
          </div>
        </div>
      </section>

      <section class="ice">
        <div class="section-inner">
          <div class="section-head compact-head">
            <span class="kicker">EHIS ametlik universum</span>
            <h2>Kõik EHIS-is registreeritud mikrokvalifikatsiooni õppekavad.</h2>
          </div>
          <p class="lede">
            See kiht on mõeldud uurimiseks, turuanalüüsiks ja uute pakkujate avastamiseks. Siin on ametlik
            õppekava kood, pakkuja, pakkuja tüüp, EAP, õppekavarühm, keel ja õpiväljundid. Hinda,
            vastuvõtuaega ja turunduslikku kirjeldust EHIS tavaliselt ei anna — need lisanduvad võrreldavas kataloogis.
          </p>
          <div class="grid-3">
            <article class="card">
              <h3>Pakkuja tüübid</h3>
              <ul class="data-list">
                {ehisProviderTypeStats.map((row) => <li><span>{row.label}</span><strong>{row.count}</strong></li>)}
              </ul>
            </article>
            <article class="card span-2">
              <h3>Suurimad pakkujad EHIS-is</h3>
              <div class="bars compact-bars">
                {topEhisProviders.map((row) => (
                  <div class="bar-row">
                    <span class="bar-label">{row.label}</span>
                    <span class="bar-track"><span class="bar-fill" style={`width:${Math.round((row.count / maxEhisProvider) * 100)}%`}></span></span>
                    <span class="bar-value">{row.count}</span>
                  </div>
                ))}
              </div>
            </article>
          </div>
          <div class="section-head compact-head subhead">
            <span class="kicker">Õppekavarühmad</span>
            <h2>Kus turu maht koondub.</h2>
          </div>
          <div class="bars">
            {topEhisFields.map((row) => (
              <div class="bar-row">
                <span class="bar-label">{row.label}</span>
                <span class="bar-track"><span class="bar-fill" style={`width:${Math.round((row.count / maxEhisField) * 100)}%`}></span></span>
                <span class="bar-value">{row.count}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="white">
        <div class="section-inner">
          <div class="section-head compact-head">
            <span class="kicker">Võrreldav kataloog</span>
            <h2>Õppijale võrreldavate kirjete jaotus valdkondade kaupa.</h2>
          </div>
          <div class="bars">
            {byField.map((row) => (
              <div class="bar-row">
                <span class="bar-label">{row.field}</span>
                <span class="bar-track"><span class="bar-fill" style={`width:${Math.round((row.count / maxField) * 100)}%`}></span></span>
                <span class="bar-value">{row.count}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="ice">
        <div class="section-inner">
          <div class="grid-3">
            <article class="card">
              <h3>Pakkuja tüüp</h3>
              <ul class="data-list">
                {providerTypes.map((row) => <li><span>{row.label}</span><strong>{row.count}</strong></li>)}
              </ul>
            </article>
            <article class="card">
              <h3>Õppevorm</h3>
              <ul class="data-list">
                {formats.map((row) => <li><span>{row.label}</span><strong>{row.count}</strong></li>)}
                <li><span>Märkimata</span><strong>{catalog.length - formats.reduce((s, f) => s + f.count, 0)}</strong></li>
              </ul>
            </article>
            <article class="card">
              <h3>Õppekeel</h3>
              <ul class="data-list">
                <li><span>Eesti keel</span><strong>{etCount}</strong></li>
                <li><span>Inglise keel</span><strong>{enCount}</strong></li>
              </ul>
            </article>
          </div>
        </div>
      </section>

      <section class="ice">
        <div class="section-inner narrow">
          <div class="section-head compact-head">
            <span class="kicker">Avaandmed</span>
            <h2>Kasuta mõlemat andmekihti oma analüüsis.</h2>
          </div>
          <p>
            EHIS faktikiht annab ametliku täisuniversumi. Võrreldav kataloog annab õppija ja turunduse
            jaoks vajalikud lisaväljad. Mõlemad on masinloetavad, et otsingud, turuülevaated ja
            uurimisprojektid ei peaks staatilisi numbreid käsitsi kopeerima.
          </p>
          <ul class="check">
            <li><a href="/ehis-catalog.json" data-track-event="cta_click" data-track-label="andmed_ehis_json_2">ehis-catalog.json</a> — EHIS ametlik faktikiht ({ehisProgrammeCount} õppekava, {ehisProviderCount} pakkujat)</li>
            <li><a href="/catalog.json" data-track-event="cta_click" data-track-label="andmed_json">catalog.json</a> — õppijale võrreldav kasutajakataloog ({catalog.length} programmi, {providers.length} pakkujat)</li>
            <li><a href="/llms.txt" data-track-event="cta_click" data-track-label="andmed_llms">llms.txt</a> — kokkuvõte AI-assistentidele</li>
          </ul>
          <p class="field-help">
            <strong>Kuidas viidata:</strong> „Mikrokvalifikatsioon.ee andmekiht, EHIS snapshot {ehisFetchedAtText}, võrreldav kataloog uuendatud {updatedAtText}; avalikud allikafaktid kontrollitud {checkedAtText},
            https://mikrokvalifikatsioon.ee/andmed/". Vaata ka <a href="/kuidas-koostame/">metoodikat ja sõltumatust</a> ning <a href="/aastaraport/">turu aastaraportit</a>.
            <br /><strong>Litsents:</strong> <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noreferrer">CC BY 4.0</a> — vaba kasutada viitega.
            <br /><strong>EHIS viide:</strong> {ehisAttribution}. {ehisLicence}.
          </p>
          <p class="notice">
            See ei ole ametlik riiklik register. Ametlik info mikrokvalifikatsiooni õppekavade ja
            tunnistuste kohta on Eesti Hariduse Infosüsteemis
            (<a href="https://ehis.edu.ee/" target="_blank" rel="noreferrer" data-track-event="official_source_click" data-track-label="andmed_ehis">EHIS</a>)
            ja Haridus- ja Teadusministeeriumi lehel
            (<a href="https://www.hm.ee/mikrokvalifikatsioonid" target="_blank" rel="noreferrer" data-track-event="official_source_click" data-track-label="andmed_htm">hm.ee</a>).
          </p>
        </div>
      </section>

      <section class="navy">
        <div class="section-inner contact">
          <div>
            <span class="kicker">Oled koolitaja?</span>
            <h2>Lisa oma programm registrisse — täienda andmeid.</h2>
            <div class="inline-actions">
              <a class="btn btn-primary" href="/koolitajale/" data-track-event="cta_click" data-track-label="andmed_koolitajale">Koolitajale</a>
              <a class="btn btn-secondary" href="/kataloog/" data-track-event="cta_click" data-track-label="andmed_kataloog">Ava kataloog</a>
            </div>
          </div>
          <aside class="contact-card">
            <h3>Kontakt</h3>
            <p>Ettevõtluskeskus OÜ</p>
            <p><a href="mailto:info@mikrokvalifikatsioon.ee" data-track-event="email_click" data-track-label="andmed_email">info@mikrokvalifikatsioon.ee</a></p>
            <p><a href="tel:+37258180435" data-track-event="phone_click" data-track-label="andmed_phone">+372 5818 0435</a></p>
          </aside>
        </div>
      </section>
    </main>

    <Footer label="Turg andmetes" />

    <style>
      .wide-proof { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 16px; }
      .lede { max-width: 860px; color: #44546a; }
      .subhead { margin-top: 42px; }
      .bars { display: grid; gap: 10px; }
      .compact-bars { gap: 8px; }
      .bar-row { display: grid; grid-template-columns: minmax(120px, 200px) 1fr auto; gap: 12px; align-items: center; }
      .bar-label { font-size: 0.92rem; color: #44546a; }
      .bar-track { background: #e4ecf2; border-radius: 999px; height: 14px; overflow: hidden; }
      .bar-fill { display: block; height: 100%; background: #54c247; border-radius: 999px; }
      .bar-value { font-weight: 800; color: #212121; min-width: 28px; text-align: right; }
      .data-list { list-style: none; padding: 0; margin: 0; }
      .data-list li { display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid #eef3f7; }
      .data-list li:last-child { border-bottom: 0; }
      .data-list strong { color: #212121; }
      .span-2 { grid-column: span 2; }
      @media (max-width: 900px) { .span-2 { grid-column: span 1; } }
      @media (max-width: 560px) { .bar-row { grid-template-columns: 1fr auto; } .bar-track { grid-column: 1 / -1; order: 3; } }
    </style>
  </body>
</html>
